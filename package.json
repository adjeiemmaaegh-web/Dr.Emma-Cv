{
  "name": "ledger-cv-studio",
  "version": "0.31.0-e31-candidate",
  "private": true,
  "type": "module",
  "scripts": {
    "build:legacy": "node tools/build-legacy.mjs",
    "audit:baseline": "node tools/audit-baseline.mjs",
    "verify:e0": "npm run build:legacy && npm run audit:baseline && npm run audit:storage && npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "audit:storage": "node tools/audit-storage.mjs",
    "build": "node tools/build-e31-unified-ux.mjs",
    "build:e30-frozen": "node tools/build-e30-ui.mjs",
    "audit:e31": "node tools/audit-e31-e30-preservation.mjs && node tools/audit-e31-candidate.mjs",
    "test:platform": "node --test tests/platform/*.test.mjs",
    "verify:platform": "node tools/audit-platform.mjs && npm run test:platform",
    "test:documents": "node --test tests/documents/*.test.mjs",
    "test:intelligence": "node --test tests/intelligence/*.test.mjs",
    "test:career": "node --test tests/career/*.test.mjs",
    "test:ad-integration": "node --test tests/platform/*.test.mjs tests/documents/*.test.mjs tests/intelligence/*.test.mjs tests/career/*.test.mjs tests/integration/*.test.mjs"
  },
  "devDependencies": {
    "pdfjs-dist": "6.5.438",
    "tesseract-wasm": "0.11.0"
  }
}
