function cloneDocument(doc){ return JSON.parse(JSON.stringify(doc)); }
function previewDocumentForTemplate(id){ return TEMPLATE_SAMPLES[id] || MOCK_DOC; }
function shouldLoadTemplateSample(doc){
  const p=doc.personalInfo||{};
  return !p.firstName&&!p.lastName&&!p.title&&!doc.summary&&!doc.experience.length&&!doc.education.length&&!doc.skills.length;
}
function loadTemplateSample(id){
  if(!TEMPLATE_SAMPLES[id] || !shouldLoadTemplateSample(state.document)) return false;
  state.document=cloneDocument(TEMPLATE_SAMPLES[id]);
  state.appearance.enabledSections=Object.assign({},state.appearance.enabledSections,{certifications:true,accomplishments:true});
  state.ui.editorPanel='summary';
  return true;
}
const ACCENT_COLORS = ['#2B6F68','#C85A34','#3B5BA9','#8A5A3B','#4A4A4A','#B0793A'];
