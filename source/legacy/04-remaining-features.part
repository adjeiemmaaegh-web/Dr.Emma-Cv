
<style>
.ledger-s5-launcher{position:fixed;right:18px;bottom:18px;z-index:1090;box-shadow:0 4px 15px rgba(0,0,0,.18)}
.ledger-s5-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.64);z-index:15000;display:flex;align-items:center;justify-content:center;padding:16px}
.ledger-s5-panel{background:var(--surface,#fff);color:var(--ink,#222);width:min(900px,100%);max-height:94vh;overflow:auto;padding:22px;border-radius:14px;line-height:1.45}
.ledger-s5-header{display:flex;align-items:start;justify-content:space-between;gap:20px}.ledger-s5-header h2{margin:0}.ledger-s5-panel textarea{display:block;width:100%;box-sizing:border-box;padding:12px;margin:8px 0 12px;border:1px solid #888;border-radius:7px;font:inherit;resize:vertical}
.ledger-s5-panel button:focus-visible,.ledger-s5-panel textarea:focus-visible,.ledger-s5-launcher:focus-visible{outline:3px solid #126cf5;outline-offset:3px}
.ledger-s5-notice{border-left:4px solid #b68b20;padding:10px;background:rgba(180,145,36,.10)}.ledger-s5-actions{display:flex;flex-wrap:wrap;gap:10px}.ledger-s5-columns{display:grid;grid-template-columns:1fr 1fr;gap:20px}.ledger-s5-columns section{min-width:0;overflow-wrap:anywhere}.ledger-s5-columns ul{padding-left:20px}.ledger-s5-columns li{margin-bottom:8px}.ledger-s5-foot{font-size:13px;opacity:.85}.ledger-s5-panel h3{margin-top:18px}
@media(max-width:650px){.ledger-s5-columns{grid-template-columns:1fr}.ledger-s5-panel{padding:14px}.ledger-s5-launcher{right:8px;bottom:8px}}
@media print{.ledger-s5-launcher,.ledger-s5-backdrop{display:none!important}}
</style>
<style>
.ledger-s7-launcher{position:fixed;right:1rem;bottom:5.2rem;z-index:1200}
.ledger-s7-overlay{position:fixed;inset:0;background:rgba(0,0,0,.68);display:flex;align-items:center;justify-content:center;z-index:4000;padding:1rem}
.ledger-s7-panel{background:var(--surface,#fff);color:var(--text,#222);width:min(680px,100%);max-height:90vh;overflow:auto;padding:1.5rem;border-radius:14px;box-shadow:0 12px 48px #0006}
.ledger-s7-panel label{display:block;margin:.9rem 0}.ledger-s7-panel input[type=password],.ledger-s7-panel input[type=file]{display:block;width:100%;max-width:100%;margin-top:.4rem}.ledger-s7-panel button{margin:.35rem .5rem .35rem 0}.ledger-s7-panel :focus-visible{outline:3px solid #376bd7;outline-offset:3px}
@media(max-width:600px){.ledger-s7-launcher{right:.5rem;bottom:8rem}.ledger-s7-panel{padding:1rem}}
</style>
</head>
<body>
<a class="ledger-skip-link" href="#ledger-app-content">Skip to main content</a>
<div class="ledger-save-banner" id="ledgerSafetyBanner" hidden></div>
<div id="app"></div>
<div class="modal-overlay" id="modalOverlay"></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
/* =========================================================================
   LEDGER — CAREER WORKSPACE 3.1
   Single-file vanilla JS SPA. No build step, no backend, no real auth/AI.
   ========================================================================= */

const STORAGE_KEY = 'ledger_cv_state_v2'; // Keep the existing 2.3 key: no silent data migration.
const RECOVERY_KEY = 'ledger_cv_recovery_v24';
// Keep unreadable primary data separate from the last known-good snapshot.
const DAMAGED_STORAGE_KEY = 'ledger_cv_damaged_primary_v1';
const LEDGER_STORAGE_TEST_KEY = 'ledger_cv_storage_test_v28';
let ledgerStorageTestStartedThisSession = false;
const PDFJS_URL = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
let pdfjsLoadPromise = null;
function ensurePdfImportLibrary(){
  if(typeof pdfjsLib !== 'undefined') return Promise.resolve();
  if(pdfjsLoadPromise) return pdfjsLoadPromise;
  pdfjsLoadPromise = new Promise((resolve,reject)=>{
    const script=document.createElement('script'); script.src=PDFJS_URL; script.crossOrigin='anonymous';
    script.onload=()=>typeof pdfjsLib!=='undefined'?resolve():reject(new Error('PDF parser unavailable'));
    script.onerror=()=>reject(new Error('PDF parser could not download'));
    document.head.appendChild(script);
  }).catch(err=>{pdfjsLoadPromise=null;throw err;});
  return pdfjsLoadPromise;
}
// A save failure must never be mistaken for a successful local save.
let ledgerLastSavedRaw=null;
let ledgerWriteLocked=false;
let ledgerWriteIssue='';
let ledgerRecoveredFromSnapshot=false;
let ledgerSaveCount=0;
let ledgerLastSnapshotAt=0;
// The schema is validated before storage is trusted. A malformed local save is
// handled as a recovery event, not automatically overwritten or repaired by loss.
function ledgerPlainObject(value){return !!value && typeof value==='object' && !Array.isArray(value);}
function ledgerValidPhoto(value){
  return typeof value==='string' && value.length<=2400000 &&
    /^data:image\/(?:png|jpeg|webp);base64,[a-z0-9+/=]+$/i.test(value);
}
function ledgerSafeAppearance(raw){
  const base=defaultState().appearance, a=ledgerPlainObject(raw)?raw:{};
  const validTemplates=new Set(TEMPLATES.map(t=>t.id));
  if(validTemplates.has(a.template))base.template=a.template;
  if(FONT_OPTIONS.some(f=>f.id===a.font))base.font=a.font;
  for(const [k,allowed] of Object.entries({fontSize:['small','medium','large'],spacing:['compact','standard','spacious'],margins:['narrow','standard','wide']})){
    if(allowed.includes(a[k]))base[k]=a[k];
  }
  if(typeof a.color==='string' && /^#[0-9a-f]{6}$/i.test(a.color))base.color=a.color;
  if(Array.isArray(a.sectionOrder)){
    const order=[...new Set(a.sectionOrder.filter(k=>typeof k==='string' && SECTION_META[k]))];
    base.sectionOrder=[...order,...base.sectionOrder.filter(k=>!order.includes(k))];
  }
  if(ledgerPlainObject(a.enabledSections))for(const k of Object.keys(base.enabledSections)){
    base.enabledSections[k]=a.enabledSections[k]===true;
  }
  return base;
}
function ledgerValidDocumentShape(d){
  return ledgerPlainObject(d)&&ledgerPlainObject(d.personalInfo)&&
    ['experience','education','skills','languages','certifications','projects','accomplishments','customSections'].every(k=>Array.isArray(d[k])&&d[k].every(x=>ledgerPlainObject(x)))&&
    typeof d.summary==='string' && typeof d.hobbies==='string' && typeof d.references==='string';
}
function ledgerValidStoredPayload(value){
  return ledgerPlainObject(value)&&ledgerValidDocumentShape(value.document)&&
    ledgerPlainObject(value.appearance)&&
    (value.versions===undefined || (Array.isArray(value.versions)&&value.versions.length<=30&&
       value.versions.every(v=>ledgerPlainObject(v)&&ledgerValidDocumentShape(v.document)))) ;
}
function ledgerDecodeState(raw){
  const saved=JSON.parse(raw);
  if(!ledgerValidStoredPayload(saved))throw new Error('Invalid Ledger save structure');
  const base=defaultState();
  const safeDoc=Object.assign(base.document,saved.document,{
    personalInfo:Object.assign({},base.document.personalInfo,saved.document.personalInfo)
  });
  if(!ledgerValidPhoto(safeDoc.personalInfo.photo))safeDoc.personalInfo.photo='';
  const safeVersions=(saved.versions||[]).map(v=>{
    const document=Object.assign({},v.document,{personalInfo:{...v.document.personalInfo}});
    if(!ledgerValidPhoto(document.personalInfo.photo))document.personalInfo.photo='';
    return {
      id:typeof v.id==='string'&&/^[a-zA-Z0-9_-]{1,64}$/.test(v.id)?v.id:uid(),
      name:typeof v.name==='string'?v.name.slice(0,70):'Recovered CV',
      updatedAt:typeof v.updatedAt==='string'?v.updatedAt:'',
      isMaster:v.isMaster===true,
      document,appearance:ledgerSafeAppearance(v.appearance),
      targeting:ledgerPlainObject(v.targeting)?v.targeting:defaultState().targeting,
      coverLetter:ledgerPlainObject(v.coverLetter)?v.coverLetter:defaultState().coverLetter
    };
  });
  // Only known root properties are copied. Never Object.assign untrusted JSON
  // onto the state root (including a dangerous __proto__ property).
  return Object.assign(base,{
    screen:['home','editor','experience-level','template-select','personal-info','work-experience','education','skills','summary','additional-sections','upload','agent','guided-interview','guided-review'].includes(saved.screen)?saved.screen:'home',
    experienceLevel:typeof saved.experienceLevel==='string'?saved.experienceLevel:null,
    document:safeDoc, appearance:ledgerSafeAppearance(saved.appearance),
    ui:Object.assign(base.ui,ledgerPlainObject(saved.ui)?saved.ui:{}),
    targeting:Object.assign(base.targeting,ledgerPlainObject(saved.targeting)?saved.targeting:{}),
    coverLetter:Object.assign(base.coverLetter,ledgerPlainObject(saved.coverLetter)?saved.coverLetter:{}),
    interview:Object.assign(base.interview,ledgerPlainObject(saved.interview)?saved.interview:{}),
    agent:Object.assign(base.agent,ledgerPlainObject(saved.agent)?saved.agent:{},{facts:Object.assign({},ledgerPlainObject(saved.agent&&saved.agent.facts)?saved.agent.facts:{})}),
    versions:safeVersions,activeVersionId:typeof saved.activeVersionId==='string'?saved.activeVersionId:null
  });
}


/* ---------- reference / mock content ---------- */
const MOCK_DOC = {
  personalInfo:{firstName:'John',lastName:'Smith',title:'Store Manager',email:'john.smith@example.com',phone:'07700 900123',city:'Manchester',postcode:'M1 4WP',linkedin:'linkedin.com/in/johnsmith',website:''},
  summary:'Results-driven Store Manager with 7+ years leading high-volume retail teams. Skilled at building motivated staff, controlling shrinkage, and lifting like-for-like sales through better merchandising and service standards. Known for staying calm during a packed Saturday shift and for coaching new supervisors into confident decision-makers.',
  experience:[
    {id:'e1',title:'Store Manager',employer:'Tesco',location:'Manchester, UK',start:'2021-03',end:'',current:true,description:'<ul><li>Lead a team of 34 across a £9M-turnover superstore, cutting staff turnover by 18% in two years.</li><li>Redesigned weekend rota model, reducing overtime spend by £42,000 annually.</li><li>Delivered mystery-shopper score improvement from 74% to 91% over 12 months.</li></ul>'},
    {id:'e2',title:'Assistant Manager',employer:"Sainsbury's",location:'Leeds, UK',start:'2018-06',end:'2021-02',current:false,description:'<ul><li>Managed daily operations across grocery, fresh, and checkout departments.</li><li>Trained 12 new supervisors as part of a regional leadership pipeline.</li><li>Reduced stock loss by 9% through tighter goods-in auditing.</li></ul>'}
  ],
  education:[
    {id:'ed1',institution:'University of London',location:'London, UK',qualification:'BSc (Hons)',field:'Business Management',start:'2014-09',end:'2017-06',current:false}
  ],
  skills:[{name:'Team Leadership',level:5},{name:'Inventory Management',level:4},{name:'Customer Service',level:5},{name:'Staff Training',level:4},{name:'Sales Management',level:4}],
  languages:[{id:'l1',name:'English',level:'Native'},{id:'l2',name:'Spanish',level:'Conversational'}],
  certifications:[{id:'c1',name:'Level 3 Award in Leadership and Management',issuer:'ILM',year:'2020'}],
  projects:[],
  accomplishments:[{id:'a1',text:'Regional "Store of the Year" award, 2023'}],
  hobbies:'Five-a-side football, home coffee roasting, hiking in the Peak District.',
  references:'Available on request.',
  customSections:[]
};

const ROLE_PROFILES = {
  retail: {
