/* ---------- state ---------- */
function uid(){ return Math.random().toString(36).slice(2,9); }

function defaultState(){
  return {
    screen:'home',
    experienceLevel:null,
    document:{
      personalInfo:{firstName:'',lastName:'',title:'',email:'',phone:'',city:'',postcode:'',linkedin:'',website:'',photo:''},
      summary:'', experience:[], education:[], skills:[],
      languages:[], certifications:[], projects:[], accomplishments:[],
      hobbies:'', references:'', customSections:[]
    },
    appearance:{
      template:'modern', color:ACCENT_COLORS[0], font:'lora', fontSize:'medium', spacing:'standard', margins:'standard',
      sectionOrder:['summary','experience','education','skills','certifications','languages','projects','accomplishments','hobbies','references'],
      enabledSections:{certifications:false, languages:false, projects:false, accomplishments:false, hobbies:false, references:false}
    },
    upload:{status:'idle', filename:''},
    ui:{editorPanel:'summary', editorView:'edit', previewMode:'application', previewReading:false, editingExperienceId:null, editingEducationId:null, draftBaseline:null, activeDraftDescription:null, saveStatus:'Saved'},
    targeting:{title:'',employer:'',description:'',analysis:null},
    coverLetter:{employer:'',role:'',opening:'',body:'',closing:'Yours sincerely,',text:''},
    interview:{step:'target',targetJob:'',experienceLevel:'',jobTitle:'',employer:'',location:'',start:'',end:'',current:false,duties:[],education:'',skills:[],complete:false},
    agent:{messages:[],facts:{},started:false,complete:false},
    versions:[], activeVersionId:null
  };
}

let state = loadState();
if(ledgerWriteIssue)state.ui.saveStatus='Not saved — back up now';
const LEDGER_BUILD='Stage 6 · Career Tools and Global Expansion Development (Unverified)';
let ledgerAutoSaveCounter=0;
function cleanVersionName(value){ return String(value||'Untitled CV').trim().slice(0,70)||'Untitled CV'; }
function currentVersionName(){
  const p=state.document.personalInfo||{};
  return cleanVersionName((p.title||'My CV')+(p.firstName?' · '+p.firstName:''));
}
function versionSnapshot(){ return {
  document:JSON.parse(JSON.stringify(state.document)),
  appearance:JSON.parse(JSON.stringify(state.appearance)),
  targeting:JSON.parse(JSON.stringify(state.targeting)),
  coverLetter:JSON.parse(JSON.stringify(state.coverLetter))
}; }
function ensureVersions(){
  if(!Array.isArray(state.versions)) state.versions=[];
  if(!state.activeVersionId || !state.versions.some(v=>v.id===state.activeVersionId)){
    const id=uid(); state.versions.push(Object.assign({id,name:currentVersionName(),updatedAt:new Date().toISOString(),isMaster:state.versions.length===0},versionSnapshot()));
    state.activeVersionId=id;
  }
}
function syncActiveVersion(){
  ensureVersions();
  const v=state.versions.find(x=>x.id===state.activeVersionId);
  if(v){ Object.assign(v, versionSnapshot()); v.updatedAt=new Date().toISOString(); }
}
function createVersion(blank){
  if(state.versions.length>=12){showToast('12 CV versions reached. Back up and delete an unused version before adding more.');return;}
  syncActiveVersion();
  const original=versionSnapshot();
  const snapshot=blank?{document:defaultState().document,appearance:original.appearance,targeting:defaultState().targeting,coverLetter:defaultState().coverLetter}:original;
  const id=uid();
  const label=blank?'New CV':cleanVersionName((state.versions.find(v=>v.id===state.activeVersionId)||{}).name||currentVersionName())+' · Copy';
  state.versions.push(Object.assign({id,name:label,updatedAt:new Date().toISOString(),isMaster:false},snapshot));
  state.activeVersionId=id; Object.assign(state,JSON.parse(JSON.stringify(snapshot)));
  state.ui.editorPanel=blank?'summary':'versions';state.ui.editingExperienceId=null;state.ui.editingEducationId=null;
  saveState();goto('editor');showToast(blank?'Blank CV created — previous CV saved':'CV copied — tailor this version to a job');
}
function ledgerMakeMaster(){
  ensureVersions();
  syncActiveVersion();
  for(const v of state.versions)v.isMaster=(v.id===state.activeVersionId);
  saveState();render();showToast('Current CV is now your master. Duplicate it before tailoring.');
}
function ledgerDuplicateMaster(){
  ensureVersions();
  if(state.versions.length>=12){showToast('12 CV versions reached. Delete an unused copy first.');return;}
  syncActiveVersion();
  const master=state.versions.find(v=>v.isMaster===true);
  if(!master){showToast('First choose a master CV in the Versions panel.');return;}
  const snapshot={document:cloneDocument(master.document),appearance:cloneDocument(master.appearance),targeting:cloneDocument(defaultState().targeting),coverLetter:cloneDocument(defaultState().coverLetter)};
  const id=uid();state.versions.push({id,name:cleanVersionName(master.name+' · Tailored copy'),updatedAt:new Date().toISOString(),isMaster:false,...snapshot});
  state.activeVersionId=id;
  for(const key of ['document','appearance','targeting','coverLetter'])state[key]=cloneDocument(snapshot[key]);
  state.ui.editorPanel='versions';state.ui.editingExperienceId=null;state.ui.editingEducationId=null;
  saveState();goto('editor');showToast('Master copied. Original facts remain in the master CV.');
}
function ledgerPrepareNewCV(){
 if(!ledgerHasRealWork(state.document))return true;
 if(state.versions.length>=12){showToast('The workspace holds 12 CVs. Back up and remove an unused version before creating another.');return false;}
 syncActiveVersion();
 const id=uid();
 const fresh={document:cloneDocument(defaultState().document),appearance:cloneDocument(state.appearance),targeting:cloneDocument(defaultState().targeting),coverLetter:cloneDocument(defaultState().coverLetter)};
 state.versions.push(Object.assign({id,name:'New CV',updatedAt:new Date().toISOString(),isMaster:false},fresh));
 state.activeVersionId=id;
 for(const key of ['document','appearance','targeting','coverLetter'])state[key]=cloneDocument(fresh[key]);
 state.ui.editingExperienceId=null;state.ui.editingEducationId=null;
 state.ui.draftBaseline=null;state.ui.activeDraftDescription=null;
 saveState();
 return true;
}
function ledgerStartManualCV(){
 if(!ledgerPrepareNewCV())return;
 goto('experience-level');
}
function openDemoCv(){
  if(state.versions.length>=12){showToast('Please remove an unused CV version first');return;}
  syncActiveVersion();
  const id=uid(), doc=cloneDocument(MOCK_DOC);
  const newVersion=Object.assign({id,name:'Demo · Store Manager',updatedAt:new Date().toISOString(),isMaster:false},versionSnapshot(),{document:doc,targeting:defaultState().targeting,coverLetter:defaultState().coverLetter});
  state.versions.push(newVersion);state.activeVersionId=id;state.document=doc;
  state.targeting=defaultState().targeting;state.coverLetter=defaultState().coverLetter;
  state.ui.editorPanel='versions';saveState();goto('editor');
  showToast('DEMO CONTENT — replace all sample details before applying');
}
function switchVersion(id){
  if(id===state.activeVersionId)return;
  const v=state.versions.find(x=>x.id===id);if(!v)return;
  syncActiveVersion();
  for(const key of ['document','appearance','targeting','coverLetter'])state[key]=JSON.parse(JSON.stringify(v[key]||defaultState()[key]));
  state.activeVersionId=id;state.ui.editorPanel='versions';state.ui.editingExperienceId=null;state.ui.editingEducationId=null;
  saveState();goto('editor');showToast('Opened '+v.name);
}
function deleteVersion(id){
  if(state.versions.length<2){showToast('Keep at least one CV');return;}
  if(id===state.activeVersionId){showToast('Switch to another CV before deleting this one');return;}
  if(state.versions.some(v=>v.id===id&&v.isMaster)){showToast('Choose another master before deleting this CV');return;}
  const item=state.versions.find(v=>v.id===id);
  if(!item)return;
  openModal('<div class="modal-icon" aria-hidden="true">!</div><h2 class="modal-title">Delete this CV version?</h2><p class="modal-sub">'+escapeHtml(item.name)+' will be deleted from this browser. Download a JSON backup first if you may need it later.</p><div class="modal-options"><button type="button" class="btn btn-primary" data-action="export-project">Download backup first</button><button type="button" class="btn btn-danger" data-action="confirm-delete-version" data-id="'+escapeAttr(id)+'">Delete this version</button><button type="button" class="btn btn-ghost" data-action="modal-continue-editing">Keep this CV</button></div>');
}
function confirmDeleteVersion(id){
  if(id===state.activeVersionId||state.versions.length<2||state.versions.some(v=>v.id===id&&v.isMaster))return;
  state.versions=state.versions.filter(v=>v.id!==id);
  saveState();closeModal();render();showToast('CV version deleted from this browser');
}
ensureVersions();


function loadState(){
  let raw;
  try{raw=localStorage.getItem(STORAGE_KEY);}catch(e){
    ledgerWriteLocked=true;ledgerWriteIssue='unavailable';return defaultState();
  }
  if(!raw){ ledgerLastSavedRaw=null;return defaultState(); }
  try{const saved=ledgerDecodeState(raw);ledgerLastSavedRaw=raw;return saved;}
  catch(e){
    ledgerWriteLocked=true;ledgerWriteIssue='corrupt';
    // Do not overwrite the unreadable primary save on startup.
    try{
      const snapshot=localStorage.getItem(RECOVERY_KEY);
      if(snapshot){ const recovered=ledgerDecodeState(snapshot);ledgerRecoveredFromSnapshot=true;return recovered; }
    }catch(ignored){}
    return defaultState();
  }
}
function updateSafetyUI(){
  const indicator=document.getElementById('saveStatus');
  if(indicator){indicator.textContent=state.ui.saveStatus||'Not saved';indicator.setAttribute('aria-label','Storage status: '+(state.ui.saveStatus||'Not saved'));}
  const banner=document.getElementById('ledgerSafetyBanner');
  if(!banner)return;
  if(!ledgerWriteIssue){banner.hidden=true;banner.innerHTML='';banner.dataset.issue='';return;}
  if(!banner.hidden && banner.dataset.issue===ledgerWriteIssue)return;
  const messages={
    unavailable:'This browser is blocking local storage. Your edits exist only in this open tab. Download a JSON backup now.',
    quota:'Browser storage is full or saving failed. Your latest edits may be lost on reload. Download a JSON backup now.',
    conflict:'Another tab changed Ledger. This tab will not overwrite it. Back up this tab, then compare before loading the other saved version.',
    corrupt:ledgerRecoveredFromSnapshot?'The latest local save was unreadable. A recovery snapshot was loaded in memory, but has NOT replaced the damaged save.':'Saved browser data could not be read. Ledger has NOT overwritten it. Restore a JSON backup or save the unreadable data before starting again.'
  };
  banner.hidden=false;banner.dataset.issue=ledgerWriteIssue;
  const actions=ledgerWriteIssue==='conflict'?'<button class="btn btn-secondary btn-sm" data-action="reload-storage">Compare other tab’s save</button>':
    ledgerWriteIssue==='corrupt'?'<button class="btn btn-secondary btn-sm" data-action="recover-storage">Recovery options</button>':
    '<button class="btn btn-secondary btn-sm" data-action="retry-storage">Retry saving</button>';
  banner.innerHTML='<div role="alert"><strong>Work not safely saved.</strong> '+messages[ledgerWriteIssue]+'</div><div class="ledger-safety-actions"><button class="btn btn-primary btn-sm" data-action="export-project">Download JSON backup</button>'+actions+'</div>';
}
function markSaveIssue(kind){
  ledgerWriteIssue=kind;
  if(kind==='conflict'||kind==='corrupt'||kind==='unavailable')ledgerWriteLocked=true;
  state.ui.saveStatus=kind==='conflict'?'Other tab changed data':kind==='corrupt'?'Recovery needed':'Not saved — back up now';
  updateSafetyUI();
}
// Stage 2 editing history is memory-only, bounded, and never exported with a CV.
// Native textarea undo remains native; structural and cross-section edits use these controls.
const ledgerUndoStack=[];
const ledgerRedoStack=[];
let ledgerHistoryApplying=false;
let ledgerHistoryLast={key:'',at:0};
function ledgerHistoryMeaningful(snapshot){
  if(!snapshot || typeof snapshot!=='object')return '';
  // UI navigation, timestamps, and save badges must not create undo steps.
  return JSON.stringify({document:snapshot.document,appearance:snapshot.appearance,
    targeting:snapshot.targeting,coverLetter:snapshot.coverLetter,
    activeVersionId:snapshot.activeVersionId,experienceLevel:snapshot.experienceLevel,
    versions:(snapshot.versions||[]).map(v=>({id:v.id,name:v.name,isMaster:v.isMaster,
      document:v.document,appearance:v.appearance,targeting:v.targeting,coverLetter:v.coverLetter}))});
}
function ledgerHistoryCapture(previousRaw, next){
  if(ledgerHistoryApplying || !previousRaw)return null;
  let previous;
  try{previous=JSON.parse(previousRaw);}catch(_){return null;}
  if(ledgerHistoryMeaningful(previous)===ledgerHistoryMeaningful(next))return null;
  const active=document.activeElement;
  const typing=active && active.matches && active.matches('input:not([type=checkbox]):not([type=radio]):not([type=file]),textarea,[contenteditable=true]');
  const key=typing?(active.id||active.name||active.getAttribute('data-simple-field')||active.getAttribute('data-personal-field')||active.outerHTML.slice(0,130)):'';
  const coalesce=Boolean(typing && key && ledgerHistoryLast.key===key && Date.now()-ledgerHistoryLast.at<850 && ledgerUndoStack.length);
  return {previous,coalesce,key};
}
function ledgerHistoryFinish(record){
  if(!record)return;
  if(!record.coalesce){ledgerUndoStack.push(record.previous);if(ledgerUndoStack.length>40)ledgerUndoStack.shift();}
  ledgerRedoStack.length=0;
  ledgerHistoryLast={key:record.key,at:Date.now()};
  ledgerUpdateHistoryButtons();
}
function ledgerUpdateHistoryButtons(){
  document.querySelectorAll('[data-action="ledger-undo"]').forEach(b=>{b.disabled=!ledgerUndoStack.length||ledgerWriteLocked;});
  document.querySelectorAll('[data-action="ledger-redo"]').forEach(b=>{b.disabled=!ledgerRedoStack.length||ledgerWriteLocked;});
}
function ledgerTravelHistory(direction){
  if(ledgerWriteLocked||ledgerWriteIssue){showToast('Resolve the storage warning before editing history');return;}
  const source=direction==='undo'?ledgerUndoStack:ledgerRedoStack;
  const dest=direction==='undo'?ledgerRedoStack:ledgerUndoStack;
  if(!source.length)return;
  const previousState=state, current=JSON.parse(JSON.stringify(state));
  const candidate=source.pop();
  ledgerHistoryApplying=true;
  try{
    state=JSON.parse(JSON.stringify(candidate));
    // Avoid re-opening stale transient dialogs, and keep users in the editor.
    state.screen='editor';
    state.ui={...defaultState().ui,...(state.ui||{}),editorView:'edit',draftBaseline:null};
    if(!saveState()){
      state=previousState;source.push(candidate);
      showToast('History not applied: save was unsuccessful');return;
    }
    dest.push(current);if(dest.length>40)dest.shift();
    ledgerHistoryLast={key:'',at:0};
    render();ledgerUpdateHistoryButtons();
    showToast(direction==='undo'?'Last change undone':'Change redone');
  }finally{ledgerHistoryApplying=false;}
}
function saveState(){
  syncActiveVersion();
  const historyRecord=(!ledgerHistoryApplying && !ledgerWriteLocked && !ledgerWriteIssue)
    ?ledgerHistoryCapture(ledgerLastSavedRaw,state):null;
  if(ledgerWriteLocked){
    if(ledgerWriteIssue)markSaveIssue(ledgerWriteIssue);
    return false;
  }
  try{
    const existing=localStorage.getItem(STORAGE_KEY);
    if(existing!==ledgerLastSavedRaw){markSaveIssue('conflict');return false;}
    // Keep an occasional validated, previous state if space allows. A failed
    // recovery-snapshot write must not prevent the primary save.
    if(existing && !ledgerRecoveredFromSnapshot && existing.length<1_000_000 && (ledgerSaveCount===0 || (ledgerSaveCount%25===0 && Date.now()-ledgerLastSnapshotAt>60000))){
      try{localStorage.setItem(RECOVERY_KEY,existing);ledgerLastSnapshotAt=Date.now();}catch(ignored){}
    }
    const payload=JSON.stringify({...state,ui:{...state.ui,saveStatus:'Saved locally'}});
    localStorage.setItem(STORAGE_KEY,payload);
    // Verify the write rather than assuming a storage provider behaved.
    if(localStorage.getItem(STORAGE_KEY)!==payload)throw new Error('Storage verification failed');
    ledgerLastSavedRaw=payload;ledgerSaveCount++;ledgerHistoryFinish(historyRecord);
    ledgerWriteIssue='';ledgerRecoveredFromSnapshot=false;state.ui.saveStatus='Saved locally';updateSafetyUI();const badge=document.querySelector('.ledger-review-count');if(badge)badge.textContent=ledgerCVReview(state.document).filter(x=>x.level==='action').length;return true;
  }catch(e){markSaveIssue(e&&e.name==='SecurityError'?'unavailable':'quota');return false;}
}
// Browser storage events are sent to *other* tabs, not to the writing tab.
// Immediately freeze this tab when its last-known baseline changes externally.
// This supplements optimistic read-before-write validation; localStorage is
// NOT an atomic compare-and-swap primitive and cannot eliminate every race.
function ledgerHandleExternalStorageEvent(event){
  if(!event || (event.key!==STORAGE_KEY && event.key!==null))return;
  if(event.key===STORAGE_KEY && event.newValue===ledgerLastSavedRaw)return;
  if(event.key===null){
    // Some browsers dispatch a null key for clear(); compare the live value.
    try{if(localStorage.getItem(STORAGE_KEY)===ledgerLastSavedRaw)return;}
    catch(ignored){markSaveIssue('unavailable');return;}
  }
  markSaveIssue('conflict');
}
if(typeof window!=='undefined' && window.addEventListener){
  window.addEventListener('storage',ledgerHandleExternalStorageEvent);
}
function retryLedgerSave(){
  if(ledgerWriteIssue==='conflict'||ledgerWriteIssue==='corrupt'){showToast('Use Recovery options before overwriting other saved work');return;}
  ledgerWriteLocked=false;
  if(saveState())showToast('Browser saving restored');
  else showToast('Still not saved — download a backup');
}
// Cross-tab recovery must never silently replace in-memory work. The saved
// project is re-read at confirmation time to detect intervening third-tab edits.
let ledgerPendingConflictLoad=null;
function ledgerConflictSummary(item){
  const list=Array.isArray(item.versions)?item.versions:[];
  const active=list.find(v=>v.id===item.activeVersionId);
  const name=active?cleanVersionName(active.name):'Current CV';
  return {count:list.length||1,name};
}
function loadLatestFromStorage(){
  try{
    if(ledgerWriteIssue!=='conflict'){
      ledgerInspectionMessage('No cross-tab conflict','Ledger has not detected another tab changing its browser save.');return;
    }
    const raw=localStorage.getItem(STORAGE_KEY);
    if(!raw)throw new Error('No saved version available');
    const incoming=ledgerDecodeState(raw);
    const current=ledgerConflictSummary(state),saved=ledgerConflictSummary(incoming);
    const changed=ledgerStoredContentSnapshot(state)!==ledgerStoredContentSnapshot(incoming);
    ledgerPendingConflictLoad={raw};
    openModal('<h2 class="modal-title">Compare before switching tabs</h2><p class="modal-sub">The current tab has edits that might not be in the browser save. Loading the other tab’s work replaces this tab’s workspace; it does not merge changes.</p>'+
      '<div class="ledger-restore-compare" aria-label="Cross-tab save comparison"><p><strong>This tab:</strong> '+current.count+' CV(s) · Active: '+escapeHtml(current.name)+'</p>'+
      '<p><strong>Other saved tab:</strong> '+saved.count+' CV(s) · Active: '+escapeHtml(saved.name)+'</p>'+
      '<p><strong>Contents:</strong> '+(changed?'Different — unsaved work might be lost':'CV content appears identical; editor state may differ')+'</p></div>'+
      '<div class="modal-options"><button class="btn btn-primary" data-action="export-project">Download this tab’s JSON backup first</button>'+
      '<button class="btn btn-danger" data-action="confirm-conflict-load">Replace this tab with saved version</button>'+
      '<button class="btn btn-ghost" data-action="cancel-conflict-load">Keep this tab</button></div>'+
      '<p class="field-hint">If you are unsure, download the backup and choose Keep this tab. The other tab’s browser save is not changed by reviewing it.</p>');
  }catch(e){ledgerPendingConflictLoad=null;ledgerInspectionMessage('Could not read the other tab’s save','Keep this tab open and export your JSON backup. The current CV was not replaced.');}
}
function ledgerConfirmConflictLoad(){
  const pending=ledgerPendingConflictLoad;
  if(!pending)return;
  try{
    const fresh=localStorage.getItem(STORAGE_KEY);
    if(fresh!==pending.raw){
      ledgerPendingConflictLoad=null;
      ledgerInspectionMessage('Saved project changed again','Another tab changed the browser save after this comparison. Review the newest save before switching. Nothing was replaced.');return;
    }
    const loaded=ledgerDecodeState(fresh);
    // Do not write or delete the current browser save. Only replace this tab.
    state=loaded;ledgerLastSavedRaw=fresh;ledgerWriteLocked=false;ledgerWriteIssue='';ledgerRecoveredFromSnapshot=false;
    ledgerPendingConflictLoad=null;ensureVersions();closeModal();render();showToast('Loaded the other tab’s saved CV');
  }catch(e){ledgerPendingConflictLoad=null;ledgerInspectionMessage('Could not switch to saved project','No changes were applied. Download this tab’s JSON backup and review the storage warning.');}
}
function ledgerCancelConflictLoad(){ledgerPendingConflictLoad=null;closeModal();}
function downloadDamagedStorage(){
  try{
    const raw=localStorage.getItem(STORAGE_KEY);
    if(raw==null)throw new Error('No damaged save');
    if(downloadBlob(new Blob([raw],{type:'application/json'}),'ledger-unreadable-data.json'))showToast('Unreadable data downloaded for safekeeping');
  }catch(e){showToast('Unable to read damaged local data.');}
}
function recoverStorage(){
  const recoveryText=ledgerRecoveredFromSnapshot?'A recovery snapshot was loaded into this tab. You can download it as JSON, then explicitly replace the damaged save.':'No readable recovery snapshot was found. Download the damaged data before replacing it, or import a valid JSON project backup.';
  openModal('<div class="modal-icon" aria-hidden="true">↺</div><h2 class="modal-title" id="ledgerDialogTitle">Storage recovery</h2><p class="modal-sub">'+recoveryText+'</p><div class="modal-options"><button class="btn btn-primary" data-action="export-project">Download this tab’s backup</button><button class="btn btn-secondary" data-action="download-damaged">Download unreadable saved data</button>'+
    (ledgerRecoveredFromSnapshot?'<button class="btn btn-secondary" data-action="replace-damaged">Restore recovery snapshot to local storage</button>':'<button class="btn btn-secondary" data-action="replace-damaged">Start fresh in browser storage</button>')+
    '<button class="btn btn-ghost" data-action="go-upload">Import another JSON backup</button><button class="btn btn-ghost" data-action="modal-continue-editing">Close</button></div>');
}
function replaceDamagedStorage(){
  // Explicit in-app recovery action; never erase unreadable primary implicitly.
  if(ledgerWriteIssue!=='corrupt')return;
  try{
    const old=localStorage.getItem(STORAGE_KEY);
    if(old){
      // Preserve the *damaged primary* in its own slot. Never overwrite the
      // last valid RECOVERY_KEY snapshot with damaged JSON.
      localStorage.setItem(DAMAGED_STORAGE_KEY,old);
      if(localStorage.getItem(DAMAGED_STORAGE_KEY)!==old)
        throw new Error('No space to preserve damaged data');
    }
    ledgerLastSavedRaw=old;ledgerWriteLocked=false;ledgerSaveCount=1;
    if(saveState()){closeModal();showToast('Current CV saved to this browser');}
  }catch(e){markSaveIssue('corrupt');showToast('Could not restore. Download the current JSON backup.');}
}
function goto(screen){ state.screen = screen; saveState(); render(); window.scrollTo(0,0); }

function usingMockFallback(doc){
  // If document is entirely empty, use mock content just for preview purposes so the
  // app never looks broken/blank — but never silently overwrite what a user typed.
  const p = doc.personalInfo;
  const isEmptyPerson = !p.firstName && !p.lastName && !p.title;
  const isEmptyBody = doc.experience.length===0 && doc.education.length===0 && doc.skills.length===0 && !doc.summary;
  return (isEmptyPerson && isEmptyBody) ? MOCK_DOC : doc;
}

/* ---------- toast ---------- */
let toastTimer=null;
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),2600);
}

/* ---------- modal ---------- */
let ledgerPreviousFocus=null;
function openModal(html){
  const o=document.getElementById('modalOverlay');
  if(!o.classList.contains('active'))ledgerPreviousFocus=document.activeElement;
  o.innerHTML = '<div class="modal" role="dialog" aria-modal="true" aria-label="Ledger dialog" tabindex="-1">'+html+'</div>';
  o.classList.add('active');
  // Stop keyboard focus and screen-reader navigation leaking into the
  // underlying editor while a destructive confirmation is open.
  for(const node of [document.getElementById('app'),document.getElementById('ledgerSafetyBanner'),document.querySelector('.ledger-skip-link')]){
    if(node)node.inert=true;
  }
  const first=o.querySelector('button,input,textarea,select');
  if(first)first.focus();else o.querySelector('.modal').focus();
  o.querySelectorAll('[data-action]').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      e.preventDefault();
      e.stopPropagation();
      runLedgerAction(btn);
    });
  });
  o.onclick=(e)=>{ if(e.target===o) closeModal(); };
}
function closeModal(){
  ledgerPendingConflictLoad=null;
  const o=document.getElementById('modalOverlay');
  o.classList.remove('active');o.innerHTML='';
  for(const node of [document.getElementById('app'),document.getElementById('ledgerSafetyBanner'),document.querySelector('.ledger-skip-link')]){
    if(node)node.inert=false;
  }
  if(ledgerPreviousFocus&&ledgerPreviousFocus.isConnected&&ledgerPreviousFocus.focus)ledgerPreviousFocus.focus();
  ledgerPreviousFocus=null;
}
document.addEventListener('keydown',e=>{
  const o=document.getElementById('modalOverlay');if(!o||!o.classList.contains('active'))return;
  if(e.key==='Escape'){e.preventDefault();closeModal();return;}
  if(e.key!=='Tab')return;
  const items=Array.from(o.querySelectorAll('button:not([disabled]),input:not([disabled]),textarea:not([disabled]),select:not([disabled]),[tabindex="0"]'));
  if(!items.length){e.preventDefault();return;}
  if(e.shiftKey&&document.activeElement===items[0]){e.preventDefault();items[items.length-1].focus();}
  else if(!e.shiftKey&&document.activeElement===items[items.length-1]){e.preventDefault();items[0].focus();}
});

/* ==========================================================================
   RENDER: ROOT
   ========================================================================== */
function render(){
  const app = document.getElementById('app');
  app.innerHTML = renderScreen(state.screen);
  const screen=app.querySelector('.screen.active');
  if(screen){screen.id='ledger-app-content';screen.tabIndex=-1;screen.setAttribute('role','main');}
  updateSafetyUI();
  bindGlobalActions();
  const after = SCREEN_AFTER_RENDER[state.screen];
  if(after) after();
  ledgerUpdateHistoryButtons();
}

function renderScreen(s){
  switch(s){
    case 'home': return renderHome();
    case 'upload': return renderUpload();
    case 'guided-interview': return renderGuidedInterview();
    case 'offline-agent': return renderOfflineAgent();
    case 'guided-review': return renderGuidedReview();
    case 'experience-level': return renderWizardShell('experience-level', renderExperienceLevelBody());
    case 'template-select': return renderWizardShell('template-select', renderTemplateSelectBody());
    case 'personal-info': return renderWizardShell('personal-info', renderPersonalInfoBody());
    case 'work-experience': return renderWizardShell('work-experience', renderWorkExperienceBody());
    case 'education': return renderWizardShell('education', renderEducationBody());
    case 'skills': return renderWizardShell('skills', renderSkillsBody());
    case 'summary': return renderWizardShell('summary', renderSummaryBody());
    case 'additional-sections': return renderWizardShell('additional-sections', renderAdditionalSectionsBody());
    case 'editor': return renderEditor();
    default: return renderHome();
  }
}

/* generic click-delegated actions available on every screen */
function bindGlobalActions(){
  document.body.onclick = null; // per-screen listeners are attached in *_AFTER_RENDER
}

/* ==========================================================================
   SHARED CHROME
   ========================================================================== */
function renderTopnav(opts){
  opts = opts||{};
  const homeClass = opts.home ? ' topnav-home' : '';
  const mark = `<svg class="brand-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4.5" y="3.5" width="13" height="17" rx="1.2" stroke="currentColor" stroke-width="1.6"/><path d="M8 8.5h7M8 12h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M17.5 6.5 19.5 8.2v10.3a1.2 1.2 0 0 1-1.2 1.2" stroke="currentColor" stroke-width="1.4"/></svg>`;
  return `
  <header class="topnav${homeClass}" id="topnav">
    <button class="brand" data-action="go-home">${mark}<span class="brand-mark">Ledger</span><span class="brand-sub">Studio</span></button>
    ${opts.simple ? '' : `<nav class="topnav-links">
      <button data-action="scroll-to" data-target="features">Features</button>
      <button data-action="scroll-to" data-target="templates">Templates</button>
      <button data-action="scroll-to" data-target="faq">FAQ</button>
    </nav>`}
    <div class="topnav-actions">
      <button class="btn btn-ghost btn-sm ledger-safety-link" type="button" data-action="open-safety" aria-label="Data safety and backups" title="Data safety and backups">Data safety</button>
      ${opts.showExit ? '<button class="btn btn-ghost btn-sm" data-action="go-home">Exit</button>' : (opts.home ? '<button class="btn btn-primary btn-sm" data-action="start-guided-interview">Start a CV</button>' : '<button class="btn btn-secondary btn-sm" data-action="start-create">Start a CV</button>')}
    </div>
  </header>`;
}

function renderProgress(currentId){
  const idx = WIZARD_STEPS.findIndex(s=>s.id===currentId);
  return `<div class="progress-wrap"><ol class="progress-steps">
    ${WIZARD_STEPS.map((s,i)=>`<li class="${i<idx?'done':''} ${i===idx?'current':''}" ${i===idx?'aria-current="step"':''}><span class="progress-label">${s.label}</span></li>`).join('')}
  </ol></div>`;
}

function renderWizardShell(stepId, bodyHtml){
  const idx = WIZARD_STEPS.findIndex(s=>s.id===stepId);
  const prevScreen = idx>0 ? WIZARD_STEPS[idx-1].id : 'home';
  const nextScreen = idx<WIZARD_STEPS.length-1 ? WIZARD_STEPS[idx+1].id : 'editor';
  return `
  <div class="screen active" data-screen-root="${stepId}">
    ${renderTopnav({simple:true, showExit:true})}
    ${renderProgress(stepId)}
    <div class="wizard-body">${bodyHtml}</div>
    <div class="wizard-footer"><div class="wizard-footer-inner">
      <button class="btn btn-ghost" data-action="wizard-back" data-prev="${prevScreen}">← Back</button>
      <button class="btn btn-primary" data-action="wizard-next" data-next="${nextScreen}">${nextScreen==='editor' ? 'Open Editor →' : 'Continue →'}</button>
    </div></div>
  </div>`;
}

/* ==========================================================================
   HOME SCREEN
   ========================================================================== */
function renderHome(){
  const a = state.appearance || {};
  const tmpl = (TEMPLATES.find(t=>t.id===a.template)||{}).name || 'Modern';
  const previewDoc = usingMockFallback(state.document);
  const w = (word, delay) => `<span class="w" style="--d:${delay}">${word}</span>`;
  return `
  <div class="screen active home-field">
    <div class="home-grain" aria-hidden="true"></div>
    ${renderTopnav({ home:true })}
    <section class="home-hero">
      <div class="home-enter">
        <p class="home-kicker">Free · saved on this device</p>
        <h1 class="home-h1">
          ${w('Build','0.18s')} ${w('a','0.24s')} ${w('CV','0.3s')} ${w('that','0.36s')}<br>
          ${w('reads','0.44s')} ${w('like','0.5s')} ${w('you','0.56s')}
          <span class="home-ink">${w('mean it','0.68s')}</span>${w('.','0.76s')}
        </h1>
        <p class="home-lede">Tell us your experience in your own words, edit every detail, and export an application-ready PDF or Word CV. Free to use, with no account needed.</p>
        <div class="home-cta">
          <button class="btn btn-primary" data-action="start-guided-interview">Build with Assistant <span class="arr" aria-hidden="true">→</span></button>
          <button class="btn btn-secondary" data-action="start-create">Build manually</button>
          <button class="btn btn-ghost" data-action="try-demo">Explore demo ↗</button>
          ${state.document.personalInfo.firstName||state.document.experience.length||state.document.summary?'<button class="btn btn-secondary" data-action="continue-editor">Continue my CV →</button>':''}
          <button class="btn btn-ghost" data-action="go-upload">Upload existing</button>
        </div>
        ${ledgerHasRealWork(state.document)?`<p class="ledger-resume-hint">Your current CV is here · ${ledgerCoreProgress(state.document).done} of ${ledgerCoreProgress(state.document).total} essentials drafted · <button type="button" data-action="continue-editor">Open workspace</button></p>`:''}
        <ul class="home-meta">
          <li>Private by design</li>
          <li>${TEMPLATES.length} templates</li>
          <li>Text-first PDF & Word</li>
        </ul>
      </div>
      <div class="home-stage-enter">
        <div class="home-perspective">
          <div class="home-tilt" id="homeTilt">
            <div class="home-sheet-float">
              ${renderCVPreviewHTML(previewDoc, a, {mini:true, page:1})}
            </div>
          </div>
        </div>
        <p class="home-specimen">Specimen · ${escapeHtml(tmpl)}</p>
      </div>
    </section>

    <section class="section" id="features" style="position:relative;z-index:1">
      <div class="section-head" style="text-align:left;max-width:36rem;margin-left:0">
        <div class="home-kicker">Why Ledger</div>
        <h2 class="section-title" style="margin-top:12px">Everything a good CV needs. Nothing it doesn’t.</h2>
      </div>
      <div class="home-feature-grid" style="margin-top:36px">
        <div class="feature-card home-card"><div class="feature-num">01</div><div class="feature-title">Guided, not generic</div><p class="feature-desc">Example bullets for your job title, so you are never staring at a blank box.</p></div>
        <div class="feature-card home-card"><div class="feature-num">02</div><div class="feature-title">Live preview, always on</div><p class="feature-desc">Live design and application-ready previews show your content. Printed pages may reflow by browser or Word version.</p></div>
        <div class="feature-card home-card"><div class="feature-num">03</div><div class="feature-title">PDFs that employers can read</div><p class="feature-desc">Use Print / Save as PDF for selectable text and proper pagination, or download an editable Word file.</p></div>
      </div>
    </section>

    <section class="section" style="position:relative;z-index:1;padding-top:0">
      <div class="howitworks">
        <div class="hiw-step"><div class="hiw-num">1</div><div class="hiw-title">Tell us where you are</div><div class="hiw-desc">Experience level shapes the examples we show.</div></div>
        <div class="hiw-step"><div class="hiw-num">2</div><div class="hiw-title">Choose a look</div><div class="hiw-desc">${TEMPLATES.length} templates, including straightforward and trades layouts.</div></div>
        <div class="hiw-step"><div class="hiw-num">3</div><div class="hiw-title">Fill in the details</div><div class="hiw-desc">Short forms, suggestions, one section at a time.</div></div>
        <div class="hiw-step"><div class="hiw-num">4</div><div class="hiw-title">Fine-tune and download</div><div class="hiw-desc">Colour, type, spacing — then a real PDF and Word file.</div></div>
      </div>
    </section>

    <section class="section" id="templates" style="position:relative;z-index:1">
      <div class="section-head" style="text-align:left;display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;align-items:end">
        <div>
          <div class="home-kicker">Templates</div>
          <h2 class="section-title" style="margin-top:12px">Pick a starting point</h2>
        </div>
        <p class="section-sub" style="margin:0;max-width:20rem">Change it later without losing a word.</p>
      </div>
      <div class="template-strip" style="margin-top:28px">
        ${TEMPLATES.map(t=>`<div class="tmpl-card home-tmpl"><div class="tmpl-thumb">${t.premium?'<span class="tmpl-badge">Signature</span>':''}${renderCVPreviewHTML(MOCK_DOC, Object.assign({}, state.appearance, {template:t.id}), {mini:true, chrome:false})}</div><div class="tmpl-meta"><div class="tmpl-name">${t.name}</div><div class="tmpl-tag">${t.tag}</div></div></div>`).join('')}
      </div>
    </section>

    <section class="trust-band" style="position:relative;z-index:1">
      <div class="section-eyebrow" style="color:#9FD1C9">Built for the job search</div>
      <h2 class="section-title">Practical, not flashy</h2>
      <div class="trust-stats">
        <div><div class="trust-stat-num">${TEMPLATES.length}</div><div class="trust-stat-label">distinct templates</div></div>
        <div><div class="trust-stat-num">0</div><div class="trust-stat-label">sign-up required</div></div>
        <div><div class="trust-stat-num">A4</div><div class="trust-stat-label">text-first print export</div></div>
      </div>
    </section>

    <section class="section" id="faq" style="position:relative;z-index:1">
      <div class="section-head" style="text-align:left;max-width:36rem;margin-left:0">
        <div class="home-kicker">FAQ</div>
        <h2 class="section-title" style="margin-top:12px">Good to know</h2>
      </div>
      <div class="faq-list" style="margin-top:28px">
        ${renderFaqItem('Is this actually free?','Yes. Ledger runs in your browser — nothing is charged and your CV does not leave this device.')}
        ${renderFaqItem('How is my work saved?','Progress is saved to this browser where storage is available. Export a project backup in case browser data is cleared or blocked.')}
        ${renderFaqItem('Can I change templates after writing everything?','Yes. Switching templates preserves your content. You can also duplicate CV versions for different jobs.')}
        ${renderFaqItem('What do I actually download?','Choose browser Print / Save as PDF for a selectable-text PDF, editable Word, standalone HTML, or a JSON project backup. DOCX import is bundled for offline use; PDF import requires downloading an optional parsing library when selected.')}
      </div>
    </section>

    <footer class="footer" style="position:relative;z-index:1">Ledger CV Studio · Your work stays on this device</footer>
  </div>`;
}

function renderFaqItem(q,a){
  return `<div class="faq-item" data-faq><button class="faq-q" data-action="toggle-faq"><span>${q}</span><span class="faq-plus">+</span></button><p class="faq-a">${a}</p></div>`;
}


/* ==========================================================================
   LEDGER OFFLINE CV AGENT
   Domain-specific local agent: natural-language intake, fact extraction,
   adaptive questioning, validation, and CV assembly. No API/network required.
   ========================================================================== */
function agentClean(v){ return String(v||'').replace(/\s+/g,' ').trim(); }
function agentHasFact(k){ return !!agentClean(state.agent.facts[k]); }
function agentSay(text){ state.agent.messages.push({role:'assistant',text:agentClean(text)}); }
function agentUser(text){ state.agent.messages.push({role:'user',text:agentClean(text)}); }

function startOfflineAgent(){
  state.agent={messages:[],facts:{},started:true,complete:false};
  state.screen='offline-agent';
  agentSay("Hi — I’m Ledger’s offline CV Assistant. Tell me what you want to build in your own words. You don’t need to fill out a form. For example: “I need a CV for a warehouse job. I worked at my uncle’s shop for two years.”");
  saveState(); render();
}

function agentCurrentQuestionKey(){
  const f=state.agent.facts||{};
  if(!agentHasFact('targetJob')) return 'targetJob';
  if(!agentHasFact('name')) return 'name';
  if(!agentHasFact('experienceLevel')) return 'experienceLevel';
  if(f.experienceLevel!=='No experience yet'&&!agentHasFact('jobTitle')) return 'jobTitle';
  if(f.experienceLevel!=='No experience yet'&&!agentHasFact('employer')) return 'employer';
  if(f.experienceLevel!=='No experience yet'&&!agentHasFact('duration')) return 'duration';
  if(!agentHasFact('evidence')) return 'evidence';
  if(!agentHasFact('email')) return 'email';
  if(!agentHasFact('phone')) return 'phone';
  if(!agentHasFact('education')) return 'education';
  return null;
}
function agentParse(text){
  const t=agentClean(text), low=t.toLowerCase(), f=state.agent.facts;
  const asked=agentCurrentQuestionKey();
  const set=(k,v,force=false)=>{v=agentClean(v);if(v&&(force||!f[k]))f[k]=v;};
  let m;
  // Context-aware capture: if the assistant just asked for a specific field,
  // accept a natural answer even when it has no trigger phrase.
  if(asked==='targetJob' && t.length>1) set('targetJob',t.replace(/^(?:(?:i(?:'m| am)\s+)?(?:applying for|looking for|want a cv for|need a cv for|cv for|resume for))\s+(?:a|an|the)?\s*/i,''));
  if(asked==='name' && /^[A-Za-z][A-Za-z'’-]*(?:\s+[A-Za-z][A-Za-z'’-]*){1,3}$/.test(t)) set('name',t);
  if(asked==='email' && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(t)) set('email',t);
  if(asked==='phone' && /\d/.test(t)) set('phone',t);
  if(asked==='jobTitle' && t.length>1) set('jobTitle',t.replace(/^(?:i\s+)?(?:worked as|work as|was a|was an|my job was|my role was)\s+(?:a|an)?\s*/i,''));
  if(asked==='employer' && t.length>1) set('employer',t.replace(/^(?:(?:i\s+)?(?:worked|work|was employed|am employed)\s+(?:at|for|with)\s+)/i,''));
  if(asked==='duration' && /\d/.test(t)) set('duration',t);
  if(asked==='evidence' && t.length>2) set('evidence',t);
  if(asked==='education' && t.length>1) set('education',/^(none|no|nothing|no education|not applicable|n\/a)$/i.test(t)?'None':t);
  if(asked==='experienceLevel'){
    if(/\b(no|none|never|first job|not yet)\b.*\b(experience|work|job)/i.test(t)||/^(no|none|not yet)$/i.test(t)) set('experienceLevel','No experience yet');
    else if(t.length>2) set('experienceLevel','Relevant experience');
  }
  // Explicit corrections should replace an earlier value.
  m=t.match(/\b(?:actually|correction|change (?:my|the))\b.*?\b(?:name|job title|role|employer|company|duration|email|phone)\b.*?\b(?:to|is)\s+(.+)$/i);
  if(m){
    const q=low;
    if(/\bname\b/.test(q))set('name',m[1],true);
    else if(/\b(job title|role)\b/.test(q))set('jobTitle',m[1],true);
    else if(/\b(employer|company)\b/.test(q))set('employer',m[1],true);
    else if(/\bduration\b/.test(q))set('duration',m[1],true);
    else if(/\bemail\b/.test(q))set('email',m[1],true);
    else if(/\bphone\b/.test(q))set('phone',m[1],true);
  }
  let m2;
  m2=t.match(/\b(?:my name is|call me)\s+([A-Za-z][A-Za-z'’-]+(?:\s+[A-Za-z][A-Za-z'’-]+){0,3})/i);
  if(m2) set('name',m2[1]);
  m2=t.match(/\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/i);if(m2)set('email',m2[0]);
  m2=t.match(/(?:\+?\d[\d\s().-]{7,}\d)/);if(m2)set('phone',m2[0].trim());
  m2=t.match(/\b(?:applying for|apply for|cv for|resume for|looking for|want a cv for|need a cv for)\s+(?:a|an|the)?\s*([^,.!?]+)/i);if(m2)set('targetJob',m2[1]);
  m2=t.match(/\b(?:worked as|work as|was a|was an|my job was|my role was)\s+(?:a|an)?\s*([^,.!?]+?)(?=\s+(?:at|for|with)\s+|\s+for\s+\d|\s*[,.!?]|$)/i);if(m2)set('jobTitle',m2[1]);
  m2=t.match(/\b(?:worked|work|employed)\s+(?:at|for|with)\s+([^,.!?]+?)(?=\s+(?:for|from|since)\s+\d|\s*[,.!?]|$)/i);if(m2)set('employer',m2[1]);
  m2=t.match(/\bfor\s+(\d+(?:\.\d+)?)\s+(year|years|month|months)\b/i);if(m2)set('duration',m2[1]+' '+m2[2]);
  m2=t.match(/\b(?:studied|earned|completed|have)\s+([^,.!?]+(?:degree|diploma|certificate|certification|qualification)[^,.!?]*)/i);if(m2)set('education',m2[1]);
  if(/\b(no experience|never worked|first job|no work experience)\b/i.test(low))set('experienceLevel','No experience yet');
  else if(agentHasFact('jobTitle')||agentHasFact('employer')||agentHasFact('duration'))set('experienceLevel','Relevant experience');
  // Do not turn unrelated conversational messages into career evidence.
  // Evidence is captured when the assistant explicitly asks for real duties.
  return f;
}

function agentNextQuestion(){
  const f=state.agent.facts;
  if(!agentHasFact('targetJob'))return "What job are you applying for? You can describe it naturally — “warehouse worker”, “cleaner”, “electrician”, or whatever fits.";
  if(!agentHasFact('name'))return "Great. What’s your full name?";
  if(!agentHasFact('experienceLevel'))return "Have you done any work that could be relevant — paid, family business, casual work, volunteering, or an apprenticeship?";
  if(f.experienceLevel!=='No experience yet'&&!agentHasFact('jobTitle'))return "What was your job or role? A rough title is fine; I’ll help make it CV-ready without changing the truth.";
  if(f.experienceLevel!=='No experience yet'&&!agentHasFact('employer'))return "Where did you do that work? A company, shop, client, agency, family business, or “self-employed” is fine.";
  if(f.experienceLevel!=='No experience yet'&&!agentHasFact('duration'))return "How long did you do that work? Even “about two years” is enough.";
  if(!agentHasFact('evidence'))return "Tell me what you actually did there. Give me the messy version — for example, “I served customers, unpacked deliveries and counted stock.” I’ll turn it into professional CV language.";
  if(!agentHasFact('email'))return "What email address should appear on the CV?";
  if(!agentHasFact('phone'))return "And what phone number should appear on it?";
  if(!agentHasFact('education'))return "Do you have any education, training, licence, certificate, or qualification worth including? If not, say “none”.";
  return null;
}

function agentRoleKey(title){
  const n=normaliseJobTitle(title||'');
  for(const g of Object.keys(JOB_TITLE_GROUPS))if(JOB_TITLE_GROUPS[g].some(t=>normaliseJobTitle(t)===n))return g;
  const matches=cvEngine.searchJobTitles(title||'');
  if(matches[0])for(const g of Object.keys(JOB_TITLE_GROUPS))if(JOB_TITLE_GROUPS[g].includes(matches[0]))return g;
  const c=(title||'').toLowerCase();
  if(/warehouse|picker|stock|logistic|dispatch/.test(c))return 'warehouse';
  if(/clean/.test(c))return 'cleaning';
  if(/electric|plumb|mechanic|welder|engineer/.test(c))return 'trades';
  if(/driver|delivery|courier/.test(c))return 'driving';
  if(/construction|labour|brick|site/.test(c))return 'construction';
  return 'office';
}

function agentBuildSuggestions(){
  const f=state.agent.facts,key=agentRoleKey(f.targetJob||f.jobTitle),profile=ROLE_PROFILES[key]||ROLE_PROFILES.office;
  const evidence=(f.evidence||'').toLowerCase();
  const suggestions=profile.bullets.filter(b=>b.toLowerCase().split(/\W+/).filter(x=>x.length>4).some(x=>evidence.includes(x))).slice(0,3);
  return suggestions.length?suggestions:profile.bullets.slice(0,2);
}

function agentSubmit(raw){
  const input=document.getElementById('agentInput');
  const text=agentClean(raw||(input?input.value:''));
  if(!text)return;
  if(input)input.value='';
  agentUser(text);
  const f=agentParse(text);
  if(/\b(?:none|no|nothing)\b/i.test(text)&&/education|qualification|training|certificate/i.test(text))f.education='None';
  const next=agentNextQuestion();
  if(next)agentSay(next);
  else{
    const suggestions=agentBuildSuggestions();
    f.suggestions=suggestions.join('||');
    agentSay("I have enough information to build a first CV. I’ll use only the facts you gave me. Ledger’s job-library wording is used only as suggested CV language, not as proof that you did something.");
    agentSay("If anything I captured is wrong, tell me now in one sentence. Otherwise choose “Build my CV”.");
  }
  saveState();render();setTimeout(()=>{const i=document.getElementById('agentInput');if(i)i.focus();},0);
}

function agentBuildCv(){
  if(!ledgerPrepareNewCV())return;
  const f=state.agent.facts,targetRole=String(f.targetJob||'').replace(/\s+(job|role|position)$/i,'').trim(),role=f.jobTitle||targetRole||'Professional',name=(f.name||'').split(/\s+/),d=state.document;
  d.personalInfo.firstName=name[0]||'';d.personalInfo.lastName=name.slice(1).join(' ');d.personalInfo.title=targetRole||role;d.personalInfo.email=f.email||'';d.personalInfo.phone=f.phone||'';
  // Only confirmed facts can appear as claims in an exported CV.
  // Role-library suggestions remain available inside the editor for review.
  const evidence=(f.evidence||'').trim();
  d.summary='Seeking an opportunity as '+(targetRole||role)+'.';
  d.experience=[];
  if(f.experienceLevel!=='No experience yet'&&(f.jobTitle||f.employer||evidence))d.experience.push({id:uid(),title:f.jobTitle||role,employer:f.employer||'',location:'',start:'',end:'',current:false,description:textToBulletsHtml(evidence)});
  d.skills=[];
  if(f.education&&f.education!=='None')d.education=[{id:uid(),institution:'',location:'',qualification:f.education,field:'',start:'',end:'',current:false}];
  state.ui.editorPanel='summary';state.agent.complete=true;saveState();goto('editor');
}

function renderOfflineAgent(){
  const a=state.agent,f=a.facts||{},messages=a.messages||[];
  const facts=[f.targetJob&&`Target: ${f.targetJob}`,f.name&&`Name: ${f.name}`,f.jobTitle&&`Role: ${f.jobTitle}`,f.employer&&`Employer: ${f.employer}`,f.duration&&`Experience: ${f.duration}`,f.email&&`Email: ${f.email}`,f.phone&&`Phone: ${f.phone}`].filter(Boolean);
  const ready=!agentNextQuestion();
  return `<div class="screen active">${renderTopnav({simple:true,showExit:true})}<main class="agent-shell"><div class="agent-head"><div class="agent-status">Offline Guided Assistant · Rules-based</div><h1 class="agent-title">Let’s build your CV together.</h1><p class="agent-sub">Talk normally. I’ll ask only for information I still need, remember what you already told me, separate your facts from suggestions, and build the CV when the essentials are complete.</p></div>${facts.length?`<div class="agent-facts"><div class="agent-facts-title">Captured so far</div>${facts.map(x=>`<div class="agent-fact">✓ ${escapeHtml(x)}</div>`).join('')}</div>`:''}<div class="agent-chat">${messages.map(m=>`<div class="agent-msg ${m.role==='user'?'user':'assistant'}">${escapeHtml(m.text)}</div>`).join('')}${ready?`<div class="agent-msg system">Ready to build. The next step will create the CV from confirmed information and clearly marked offline suggestions.</div>`:''}</div>${ready?`<div class="agent-action-row"><button class="btn btn-primary" data-action="agent-build-cv">Build my CV →</button><button class="btn btn-ghost" data-action="agent-start-over">Start over</button></div>`:''}</main><div class="agent-composer"><div class="agent-composer-inner"><input id="agentInput" type="text" placeholder="Tell Ledger what you know…" autocomplete="off"><button class="btn btn-primary" data-action="agent-send">Send</button></div><div class="agent-quick"><button data-action="agent-quick" data-value="I have no previous work experience.">No experience</button><button data-action="agent-quick" data-value="I don’t have any relevant education or training.">No education to add</button></div></div></div>`;
}

/* ==========================================================================
   OFFLINE GUIDED INTERVIEW — controlled state machine, no API or chatbot
   ========================================================================== */
const INTERVIEW_STEPS=['target','level','job','employer','dates','duties','education','skills'];
function interviewStepIndex(){ return INTERVIEW_STEPS.indexOf(state.interview.step); }
function interviewGroup(){
  const title=state.interview.jobTitle||state.interview.targetJob||'';
  const key=normaliseJobTitle(title);
  return Object.keys(JOB_TITLE_GROUPS).find(g=>JOB_TITLE_GROUPS[g].some(t=>normaliseJobTitle(t)===key)) ||
    (cvEngine.searchJobTitles(title)[0] ? Object.keys(JOB_TITLE_GROUPS).find(g=>JOB_TITLE_GROUPS[g].includes(cvEngine.searchJobTitles(title)[0])) : 'office') || 'office';
}
function interviewDuties(){
  const title=state.interview.jobTitle||state.interview.targetJob;
  return getSuggestedBullets(title).slice(0,6);
}
function interviewSkills(){
  const title=state.interview.jobTitle||state.interview.targetJob;
  return cvEngine.getSuggestedSkills(title).slice(0,8);
}
function interviewInput(label,field,placeholder,type='text'){
  const value=state.interview[field]||'';
  return `<div class="field"><label for="interview-${field}">${label}</label><input id="interview-${field}" class="interview-answer" type="${type}" value="${escapeAttr(value)}" data-interview-field="${field}" placeholder="${placeholder||''}" autocomplete="off"></div>`;
}
function interviewChoices(items,selected,field){
  return `<div class="interview-choice-grid">${items.map((x,i)=>`<button type="button" class="interview-choice ${selected.includes(x)?'selected':''}" data-action="interview-toggle" data-field="${field}" data-value="${escapeAttr(x)}">${escapeHtml(x)}</button>`).join('')}</div>`;
}
function renderGuidedInterview(){
  const i=state.interview, step=i.step, idx=interviewStepIndex(), pct=Math.round((idx/INTERVIEW_STEPS.length)*100);
  let title='',helper='',body='',primary='Continue →';
  if(step==='target'){title='What job are you applying for?';helper='Type a short job title. Ledger will match it to its existing suggestions — no long explanation needed.';body=interviewInput('Target job','targetJob','e.g. Cleaner, Electrician, Site Labourer');}
  if(step==='level'){title='Do you have relevant work experience?';helper='Choose the shortest answer that fits. This controls the next question.';body=interviewChoices(['No experience yet','One previous job','Several previous jobs'],[i.experienceLevel],'experienceLevel');}
  if(step==='job'){title='What was your most recent job?';helper='Use the job title you were actually doing. You can adjust it later.';body=interviewInput('Job title','jobTitle',i.targetJob||'e.g. Cleaner');}
  if(step==='employer'){title='Where did you work?';helper='A company, client, agency, or “self-employed” is enough.';body=interviewInput('Employer','employer','e.g. ABC Hotel');}
  if(step==='dates'){title='How long did you work there?';helper='Use dates if you know them, or a short phrase such as “3 years”.';body=`<div class="form-grid cols-2">${interviewInput('Start month','start','YYYY-MM','month')}${interviewInput('End month','end','YYYY-MM','month')}</div><label class="check-row" style="margin-top:12px;"><input type="checkbox" data-interview-field="current" ${i.current?'checked':''}> I currently work here</label>`;}
  if(step==='duties'){title='What did you do there?';helper='Select only what is true. These are suggestions from Ledger’s job database, not invented experience.';body=interviewChoices(interviewDuties(),i.duties,'duties');primary='Save duties →';}
  if(step==='education'){title='What qualification or training should we include?';helper='Optional. Leave blank if there is nothing relevant.';body=interviewInput('Qualification','education','e.g. Level 2 Diploma, GCSEs, or leave blank');primary='Continue →';}
  if(step==='skills'){title='Which skills fit you?';helper='Select the skills you can genuinely support. You can add more in the editor.';body=interviewChoices(interviewSkills(),i.skills,'skills');primary='Review my information →';}
  return `<div class="screen active">${renderTopnav({simple:true,showExit:true})}<main class="wizard-body interview-shell"><div class="interview-progress"><span style="width:${Math.max(8,pct)}%"></span></div><div class="wizard-eyebrow">Offline CV Assistant · ${idx+1} of ${INTERVIEW_STEPS.length}</div><h1 class="interview-question">${title}</h1><p class="interview-helper">${helper}</p>${body}<div class="interview-note">Short answers and selections are enough. Ledger only organises what you provide.</div><div style="display:flex;justify-content:space-between;gap:10px;margin-top:24px;"><button class="btn btn-ghost" data-action="interview-back">← Back</button><button class="btn btn-primary" data-action="interview-next">${primary}</button></div></main></div>`;
}
function renderGuidedReview(){
  const i=state.interview, duties=i.duties.length?i.duties:[], skills=i.skills.length?i.skills:[];
  const role=i.jobTitle||i.targetJob||'Not provided', exp=i.experienceLevel==='No experience yet'?'No previous work experience':`${role} — ${i.employer||'Employer not provided'}`;
  return `<div class="screen active">${renderTopnav({simple:true,showExit:true})}<main class="wizard-body interview-shell"><div class="wizard-eyebrow">Offline CV Assistant · Review</div><h1 class="wizard-title">Here’s what I understood</h1><p class="wizard-sub">Check the facts before Ledger sends them to the normal CV editor. Nothing has been invented.</p><div class="interview-summary"><div class="interview-summary-card"><div class="interview-summary-label">Target job</div><div class="interview-summary-value">${escapeHtml(i.targetJob||'Not provided')}</div></div><div class="interview-summary-card"><div class="interview-summary-label">Experience</div><div class="interview-summary-value">${escapeHtml(exp)}${i.start?`<br>${escapeHtml(fmtMonth(i.start))} – ${i.current?'Present':escapeHtml(fmtMonth(i.end))}`:''}</div></div><div class="interview-summary-card"><div class="interview-summary-label">Responsibilities</div><div class="interview-summary-value">${duties.length?duties.map(d=>`✓ ${escapeHtml(d)}`).join('<br>'):'None selected'}</div></div><div class="interview-summary-card"><div class="interview-summary-label">Skills</div><div class="interview-summary-value">${skills.length?skills.map(s=>`✓ ${escapeHtml(s)}`).join(' · '):'None selected'}</div></div>${i.education?`<div class="interview-summary-card"><div class="interview-summary-label">Education / training</div><div class="interview-summary-value">${escapeHtml(i.education)}</div></div>`:''}</div><div style="display:flex;gap:10px;flex-wrap:wrap;"><button class="btn btn-ghost" data-action="interview-edit">← Edit answers</button><button class="btn btn-primary" data-action="interview-finish">Looks good — open my CV →</button></div></main></div>`;
}
function interviewFieldValues(){
  document.querySelectorAll('[data-interview-field]').forEach(el=>{ if(el.type==='checkbox') state.interview[el.dataset.interviewField]=el.checked; else state.interview[el.dataset.interviewField]=el.value.trim(); });
}
function interviewAdvance(){
  interviewFieldValues(); const i=state.interview;
  if(i.step==='target'&&!i.targetJob){showToast('Enter a target job to continue');return;}
  if(i.step==='level'&&!i.experienceLevel){showToast('Choose one option to continue');return;}
  if(i.step==='job'&&!i.jobTitle){showToast('Enter the job title to continue');return;}
  if(i.step==='duties'&&i.experienceLevel!=='No experience yet'&&!i.duties.length){showToast('Select at least one duty, or go back and choose no experience');return;}
  const n=INTERVIEW_STEPS.indexOf(i.step)+1;
  if(i.step==='level'&&i.experienceLevel==='No experience yet') i.step='education'; else if(n>=INTERVIEW_STEPS.length) {i.step='review'; state.screen='guided-review'; saveState(); render(); return;} else i.step=INTERVIEW_STEPS[n];
  saveState(); render();
}
function interviewFinish(){
  if(!ledgerPrepareNewCV())return;
  const i=state.interview, d=state.document, role=i.jobTitle||i.targetJob;
  d.personalInfo.title=role;
  // Do not silently insert an example summary that asserts unverified expertise.
  d.summary=d.summary||'';
  if(i.experienceLevel!=='No experience yet' && (i.jobTitle||i.employer||i.duties.length)) d.experience=[{id:uid(),title:i.jobTitle||role,employer:i.employer,location:i.location,start:i.start,end:i.end,current:i.current,description:textToBulletsHtml(i.duties.join('\n'))}];
  if(i.education) d.education=[{id:uid(),institution:'',location:'',qualification:i.education,field:'',start:'',end:'',current:false}];
  i.skills.forEach(addSkillSilent); state.appearance.enabledSections.accomplishments=true; state.ui.editorPanel='summary'; i.complete=true; saveState(); goto('personal-info');
}
function addSkillSilent(name){if(name&&!state.document.skills.some(s=>s.name.toLowerCase()===name.toLowerCase()))state.document.skills.push({name,level:3});}

/* ==========================================================================
   UPLOAD FLOW
   ========================================================================== */
function renderUpload(){
  const st = state.upload.status;
  return `
  <div class="screen active">
    ${renderTopnav({simple:true, showExit:true})}
    <div class="wizard-body" style="max-width:560px;">
      <div class="wizard-head">
        <div class="wizard-eyebrow">Import</div>
        <h1 class="wizard-title">Upload your existing CV</h1>
        <p class="wizard-sub">We'll read the file and pre-fill your details so you can pick up from an existing document instead of starting blank.</p>
      </div>
      ${st==='idle' ? `
        <div class="upload-drop">
          <div class="upload-drop-icon">📄</div>
          <p style="font-weight:600;">Choose a file to import</p>
          <p class="field-hint">Import TXT, HTML, DOCX, PDF, or a Ledger JSON backup. DOCX works offline; PDF needs an optional online reader. Legacy .doc files are not supported.</p>
          <input type="file" id="importFile" accept=".txt,.html,.htm,.docx,.pdf,.json" hidden>
          <div style="margin-top:18px;"><button class="btn btn-primary" data-action="upload-simulate">Choose File</button></div>
          <div class="upload-formats"><span class="format-pill">DOCX</span><span class="format-pill">HTML / PDF*</span><span class="format-pill">TXT</span><span class="format-pill">JSON backup</span></div>
        </div>` : ''}
      ${st==='analysing' ? `
        <div class="upload-drop upload-progress">
          <div class="spinner"></div>
          <p class="upload-status-text">Analysing ${escapeHtml(state.upload.filename)}…</p>
          <p class="field-hint">Reading your work history, education and skills.</p>
        </div>` : ''}
      ${st==='done' ? `
        <div class="upload-drop">
          <div class="upload-success-icon">✓</div>
          <p style="font-weight:600;">CV imported successfully</p>
          <p class="field-hint">We pre-filled your details from ${escapeHtml(state.upload.filename)}. Review and adjust anything before continuing.</p>
          <div style="margin-top:18px;"><button class="btn btn-primary" data-action="upload-continue">Review My Details →</button></div>
        </div>` : ''}
    </div>
  </div>`;
}

/* ==========================================================================
   WIZARD STEP 1 — EXPERIENCE LEVEL
   ========================================================================== */
function renderExperienceLevelBody(){
  return `
  <div class="wizard-head">
    <div class="wizard-eyebrow">Step 1 of 8</div>
    <h1 class="wizard-title">Where are you in your career?</h1>
    <p class="wizard-sub">This just tailors the examples and suggestions we show you later — nothing here is permanent.</p>
  </div>
  <div class="pick-grid" data-pick-group="experience-level">
    ${EXPERIENCE_LEVELS.map(l=>`
      <button class="pick-card ${state.experienceLevel===l.id?'selected':''}" data-action="pick-experience-level" data-value="${l.id}">
        <span class="pick-icon">${l.icon}</span>
        <span><span class="pick-title">${l.title}</span><span class="pick-desc">${l.desc}</span></span>
      </button>`).join('')}
  </div>`;
}

/* ==========================================================================
   WIZARD STEP 2 — TEMPLATE SELECTION
   ========================================================================== */
function renderTemplateSelectBody(){
  const a = state.appearance;
  return `
  <div class="wizard-head">
    <div class="wizard-eyebrow">Step 2 of 8</div>
    <h1 class="wizard-title">Choose a template</h1>
    <p class="wizard-sub">Pick a starting design — you can preview, change the accent colour, or switch entirely later in the editor.</p>
  </div>
  <div class="tmpl-grid">
    ${TEMPLATES.map(t=>`
      <button class="tmpl-card ${a.template===t.id?'selected':''}" data-action="pick-template" data-value="${t.id}">
        <div class="tmpl-thumb">${t.premium?'<span class="tmpl-badge">Signature</span>':''}${renderCVPreviewHTML(previewDocumentForTemplate(t.id), Object.assign({}, a, {template:t.id}), {mini:true, chrome:false})}</div>
        <div class="tmpl-meta"><div class="tmpl-name">${t.name}</div><div class="tmpl-tag">${t.tag}</div></div>
      </button>`).join('')}
  </div>
  <div class="control-row" style="margin-top:8px;">
    <label>Accent colour</label>
    <div class="color-row">
      ${ACCENT_COLORS.map(c=>`<button class="color-dot ${a.color===c?'selected':''}" style="background:${c};" data-action="pick-color" data-value="${c}" aria-label="Choose accent colour"></button>`).join('')}
    </div>
  </div>`;
}

/* ==========================================================================
   WIZARD STEP 3 — PERSONAL INFO
   ========================================================================== */
function renderPersonalInfoBody(){
  const p = state.document.personalInfo;
  const fld = (id,label,type,opt,ph)=>`
    <div class="field" data-field="${id}">
      <label for="pi-${id}">${label} ${opt?'<span class="opt">(optional)</span>':''}</label>
      <input id="pi-${id}" type="${type}" value="${escapeAttr(p[id]||'')}" placeholder="${ph||''}" data-bind="personalInfo.${id}">
      <p class="field-error-msg">This field is required.</p>
    </div>`;
  return `
  <div class="wizard-head">
    <div class="wizard-eyebrow">Step 3 of 8</div>
    <h1 class="wizard-title">Your details</h1>
    <p class="wizard-sub">This appears at the top of your CV, so double-check spelling before moving on.</p>
  </div>
  <div class="form-grid cols-2">
    ${fld('firstName','First name','text',false,'Jordan')}
    ${fld('lastName','Last name','text',false,'Lee')}
  </div>
  <div class="form-grid" style="margin-top:16px;">${fld('title','Professional title','text',false,'Store Manager')}</div>
  <div class="form-grid cols-2" style="margin-top:16px;">
    ${fld('email','Email','email',false,'you@example.com')}
    ${fld('phone','Phone','tel',false,'07700 900123')}
  </div>
  <div class="field" style="margin-top:16px;">
    <label>Profile photo <span class="opt">(optional — used on selected templates)</span></label>
    <div class="photo-upload-row">
      ${ledgerValidPhoto(p.photo)?`<img src="${escapeAttr(p.photo)}" alt="Photo preview" />`:'<div style="width:56px;height:56px;border-radius:50%;background:#eee;border:1px dashed var(--line);"></div>'}
      <div>
        <input type="file" id="photoFile" accept="image/jpeg,image/png,image/webp" style="font-size:13px;" />
        <p class="field-hint">Square headshot works best. Stored only on this device.</p>
        ${p.photo?`<button type="button" class="btn btn-ghost btn-sm" data-action="remove-photo">Remove photo</button>`:''}
      </div>
    </div>
  </div>
  <div class="form-grid cols-2" style="margin-top:16px;">
    ${fld('city','City','text',false,'Manchester')}
    ${fld('postcode','Postcode','text',true,'M1 4WP')}
  </div>
  <div class="form-grid cols-2" style="margin-top:16px;">
    ${fld('linkedin','LinkedIn','url',true,'linkedin.com/in/you')}
    ${fld('website','Website','url',true,'yoursite.com')}
  </div>
  <div style="margin-top:28px;max-width:220px;">
    <p class="field-hint" style="margin-bottom:8px;">Live preview</p>
    ${renderCVPreviewHTML(state.document, state.appearance, {mini:true})}
  </div>`;
}

/* ==========================================================================
   WIZARD STEP 4 — WORK EXPERIENCE
   ========================================================================== */
function fmtMonth(m){
  if(!m) return '';
  const [y,mo]=m.split('-');
  const names=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return names[parseInt(mo,10)-1]+' '+y;
}
function renderWorkExperienceBody(){
  const list = state.document.experience;
  const editingId = state.ui.editingExperienceId;
  return `
  <div class="wizard-head">
    <div class="wizard-eyebrow">Step 4 of 8</div>
    <h1 class="wizard-title">Work experience</h1>
    <p class="wizard-sub">Add your most recent role first. You can reorder, edit or remove entries at any time.</p>
  </div>
  <div id="experienceList">
    ${list.length===0 ? `<div class="empty-state"><div class="empty-state-title">No experience added yet</div>No experience yet? That's fine — add one below, or skip this step entirely.</div>` :
      list.map((ex,i)=>renderExperienceEntry(ex,i,list.length,editingId)).join('')}
  </div>
  <button class="add-entry-btn" style="margin-top:12px;" data-action="add-experience">+ Add a job</button>`;
}
function renderExperienceEntry(ex,i,total,editingId){
  if(editingId===ex.id){
    return `
    <div class="entry-card" data-exp-edit="${ex.id}">
      <div class="form-grid cols-2">
        <div class="field autocomplete-wrap"><label>Job title</label><input type="text" data-exf="title" aria-label="Job title" value="${escapeAttr(ex.title)}" placeholder="Start typing — e.g. Store Manager" autocomplete="off"><div class="autocomplete-menu" hidden></div></div>
        <div class="field"><label>Employer</label><input type="text" data-exf="employer" aria-label="Employer" value="${escapeAttr(ex.employer)}" placeholder="Tesco"></div>
      </div>
      <div class="form-grid" style="margin-top:14px;"><div class="field"><label>Location <span class="opt">(optional)</span></label><input type="text" data-exf="location" aria-label="Work location" value="${escapeAttr(ex.location)}" placeholder="Manchester, UK"></div></div>
      <div class="form-grid cols-2" style="margin-top:14px;">
        <div class="field"><label>Start date</label><input type="month" data-exf="start" aria-label="Employment start date" value="${escapeAttr(ex.start)}"></div>
        <div class="field"><label>End date</label><input type="month" data-exf="end" aria-label="Employment end date" value="${escapeAttr(ex.end)}" ${ex.current?'disabled':''}></div>
      </div>
      <label class="check-row" style="margin-top:12px;"><input type="checkbox" data-exf="current" aria-label="Currently employed here" ${ex.current?'checked':''}> I currently work here</label>
      <div class="field" style="margin-top:14px;">
        <label>Description</label>
        <textarea data-exf="description" aria-label="Experience description" rows="5" placeholder="What did you do day to day? What did you improve?">${escapeHtml(state.ui.editingExperienceId===ex.id && state.ui.activeDraftDescription!=null?state.ui.activeDraftDescription:stripHtmlForEdit(ex.description))}</textarea>
        <p class="field-hint">One point per line — we'll format it as bullets.</p>
      </div>
      <div class="suggest-box">${renderSuggestBoxHtml(ex.title, ex.id)}</div>
      <div style="display:flex;gap:8px;margin-top:16px;">
        <button class="btn btn-primary btn-sm" data-action="save-experience" data-id="${ex.id}">Save</button>
        <button class="btn btn-ghost btn-sm" data-action="cancel-experience-edit">Cancel</button>
      </div>
    </div>`;
  }
  const dateStr = ex.current ? (fmtMonth(ex.start)+' — Present') : [fmtMonth(ex.start),fmtMonth(ex.end)].filter(Boolean).join(' — ');
  return `
  <div class="entry-card">
    <div class="entry-card-head">
      <div>
        <div class="entry-card-title">${escapeHtml(ex.title)||'Untitled role'} ${ex.employer? '· '+escapeHtml(ex.employer):''}</div>
        <div class="entry-card-sub">${dateStr}${ex.location? ' · '+escapeHtml(ex.location):''}</div>
      </div>
      <div class="entry-card-actions">
        ${i>0?`<button class="icon-btn" data-action="move-experience" data-id="${ex.id}" data-dir="up" title="Move up">↑</button>`:''}
        ${i<total-1?`<button class="icon-btn" data-action="move-experience" data-id="${ex.id}" data-dir="down" title="Move down">↓</button>`:''}
        <button class="icon-btn" data-action="edit-experience" data-id="${ex.id}" title="Edit">✎</button>
        <button class="icon-btn" data-action="delete-experience" data-id="${ex.id}" title="Delete">✕</button>
      </div>
    </div>
  </div>`;
}
function getSuggestedBullets(title){
  const base = cvEngine.getResponsibilities(title);
  return base.map(b=>b.replace(/\{n\}/g, '[your real figure]'));
}
function renderSuggestBoxHtml(title, expId){
  const achievements=cvEngine.getAchievementPrompts(title), metrics=cvEngine.getMetricPrompts(title);
  return `<div class="suggest-box-label">Suggested bullet points for "${escapeHtml(title||'this role')}"</div><div class="guidance-note">${escapeHtml(cvEngine.getContentGuidance(title))}</div>
    ${getSuggestedBullets(title).map(b=>`<button class="suggest-chip" data-action="insert-bullet" data-exp="${expId}" data-text="${escapeAttr(b)}">+ ${escapeHtml(b)}</button>`).join('')}
    <div class="suggest-box-label" style="margin-top:14px;">Achievement starters — add your real number</div>
    ${achievements.map(b=>`<button class="suggest-chip" data-action="insert-bullet" data-exp="${expId}" data-text="${escapeAttr(b)}">+ ${escapeHtml(b)}</button>`).join('')}
    <div class="suggest-box-label" style="margin-top:14px;">Useful metrics to look for</div>
    ${metrics.map(m=>`<button class="suggest-chip" data-action="insert-bullet" data-exp="${expId}" data-text="${escapeAttr(m)}">+ ${escapeHtml(m)}</button>`).join('')}`;
}
function descriptionLines(html){
  if(!html)return [];
  const parsed=new DOMParser().parseFromString(String(html),'text/html');
  const items=[...parsed.querySelectorAll('li')].map(li=>li.textContent.trim()).filter(Boolean);
  if(items.length)return items;
  parsed.querySelectorAll('br').forEach(el=>el.replaceWith('\n'));
  parsed.querySelectorAll('p,div').forEach(el=>el.append('\n'));
  return (parsed.body.textContent||'').split(/\r?\n/).map(line=>line.trim().replace(/^[-•]\s*/, '')).filter(Boolean);
}
function stripHtmlForEdit(html){return descriptionLines(html).join('\n');}
function safeExperienceDescription(html){
  return textToBulletsHtml(stripHtmlForEdit(html||''));
}
function textToBulletsHtml(text){
  const lines=(text||'').split('\n').map(l=>l.trim()).filter(Boolean);
  if(lines.length===0) return '';
  return '<ul>'+lines.map(l=>'<li>'+escapeHtml(l)+'</li>').join('')+'</ul>';
}

/* ==========================================================================
   WIZARD STEP 5 — EDUCATION
   ========================================================================== */
function renderEducationBody(){
  const list = state.document.education;
  const editingId = state.ui.editingEducationId;
  return `
  <div class="wizard-head">
    <div class="wizard-eyebrow">Step 5 of 8</div>
    <h1 class="wizard-title">Education</h1>
    <p class="wizard-sub">Most recent qualification first. Include ongoing study by ticking "currently studying".</p>
  </div>
  <div id="educationList">
    ${list.length===0 ? `<div class="empty-state"><div class="empty-state-title">No education added yet</div>Add your most relevant qualification below.</div>` :
      list.map((ed,i)=>renderEducationEntry(ed,i,list.length,editingId)).join('')}
  </div>
  <button class="add-entry-btn" style="margin-top:12px;" data-action="add-education">+ Add education</button>`;
}
function renderEducationEntry(ed,i,total,editingId){
  if(editingId===ed.id){
    return `
    <div class="entry-card" data-edu-edit="${ed.id}">
      <div class="form-grid cols-2">
        <div class="field"><label>Institution</label><input type="text" data-eduf="institution" aria-label="Institution" value="${escapeAttr(ed.institution)}" placeholder="University of London"></div>
        <div class="field"><label>Location <span class="opt">(optional)</span></label><input type="text" data-eduf="location" aria-label="Education location" value="${escapeAttr(ed.location)}" placeholder="London, UK"></div>
      </div>
      <div class="form-grid cols-2" style="margin-top:14px;">
        <div class="field"><label>Qualification</label><input type="text" data-eduf="qualification" aria-label="Qualification" value="${escapeAttr(ed.qualification)}" placeholder="BSc (Hons)"></div>
        <div class="field"><label>Field of study</label><input type="text" data-eduf="field" aria-label="Field of study" value="${escapeAttr(ed.field)}" placeholder="Business Management"></div>
      </div>
      <div class="form-grid cols-2" style="margin-top:14px;">
        <div class="field"><label>Start date</label><input type="month" data-eduf="start" aria-label="Education start date" value="${escapeAttr(ed.start)}"></div>
        <div class="field"><label>Graduation date</label><input type="month" data-eduf="end" aria-label="Education graduation date" value="${escapeAttr(ed.end)}" ${ed.current?'disabled':''}></div>
      </div>
      <label class="check-row" style="margin-top:12px;"><input type="checkbox" data-eduf="current" aria-label="Currently studying" ${ed.current?'checked':''}> Currently studying</label>
      <div style="display:flex;gap:8px;margin-top:16px;">
        <button class="btn btn-primary btn-sm" data-action="save-education" data-id="${ed.id}">Save</button>
        <button class="btn btn-ghost btn-sm" data-action="cancel-education-edit">Cancel</button>
      </div>
    </div>`;
  }
  const dateStr = ed.current ? (fmtMonth(ed.start)+' — Present') : [fmtMonth(ed.start),fmtMonth(ed.end)].filter(Boolean).join(' — ');
  return `
  <div class="entry-card">
    <div class="entry-card-head">
      <div>
        <div class="entry-card-title">${escapeHtml(ed.qualification)||'Qualification'}${ed.field? ', '+escapeHtml(ed.field):''}</div>
        <div class="entry-card-sub">${escapeHtml(ed.institution)||''}${ed.location? ' · '+escapeHtml(ed.location):''} ${dateStr? '· '+dateStr:''}</div>
      </div>
      <div class="entry-card-actions">
        ${i>0?`<button class="icon-btn" data-action="move-education" data-id="${ed.id}" data-dir="up">↑</button>`:''}
        ${i<total-1?`<button class="icon-btn" data-action="move-education" data-id="${ed.id}" data-dir="down">↓</button>`:''}
        <button class="icon-btn" data-action="edit-education" data-id="${ed.id}">✎</button>
        <button class="icon-btn" data-action="delete-education" data-id="${ed.id}">✕</button>
      </div>
    </div>
  </div>`;
}

/* ==========================================================================
   WIZARD STEP 6 — SKILLS
   ========================================================================== */
function renderSkillsBody(){
  const skills = state.document.skills;
  const suggested = cvEngine.getSuggestedSkills(state.document.personalInfo.title).filter(s=>!skills.find(sk=>sk.name.toLowerCase()===s.toLowerCase()));
  return `
  <div class="wizard-head">
    <div class="wizard-eyebrow">Step 6 of 8</div>
    <h1 class="wizard-title">Skills</h1>
    <p class="wizard-sub">Add relevant, genuine skills. Drag or use the Move buttons to reorder them.</p>
  </div>
  <div class="skill-input-row">
    <input type="text" id="skillInput" aria-label="Add a skill" placeholder="Type a skill and press Enter" style="flex:1;padding:11px 12px;border:1px solid var(--line);border-radius:4px;font-size:14px;">
    <button class="btn btn-secondary btn-sm" data-action="add-skill-from-input">Add</button>
  </div>
  <div class="skill-chips" id="skillChips">
    ${skills.length===0? '<p class="field-hint">No skills added yet.</p>' : skills.map((s,i)=>renderSkillChip(s,i)).join('')}
  </div>
  ${suggested.length? `
  <div class="suggested-skills">
    <div class="suggested-skills-label">Suggested for "${escapeHtml(state.document.personalInfo.title||'your role')}"</div>
    <div class="skill-chips">${suggested.map(s=>`<button class="suggest-chip" style="width:auto;display:inline-block;" data-action="add-suggested-skill" data-value="${escapeAttr(s)}">+ ${escapeHtml(s)}</button>`).join('')}</div>
  </div>` : ''}`;
}
function renderSkillChip(s,i){
  return `<span class="skill-chip" draggable="true" data-skill-index="${i}">
    <span>${escapeHtml(s.name)}</span>
    <span class="skill-level" role="group" aria-label="${escapeAttr(s.name)} proficiency">${[1,2,3,4,5].map(n=>`<button type="button" class="${n<=s.level?'on':''}" aria-pressed="${Number(s.level)===n}" aria-label="${escapeAttr(s.name)}: level ${n} of 5" data-action="set-skill-level" data-index="${i}" data-level="${n}"></button>`).join('')}</span>
    <button type="button" class="skill-move" data-action="move-skill" data-index="${i}" data-dir="up" aria-label="Move ${escapeAttr(s.name)} up" ${i===0?'disabled':''}>↑</button>
    <button type="button" class="skill-move" data-action="move-skill" data-index="${i}" data-dir="down" aria-label="Move ${escapeAttr(s.name)} down" ${i===state.document.skills.length-1?'disabled':''}>↓</button>
    <button type="button" data-action="remove-skill" data-index="${i}" aria-label="Remove ${escapeAttr(s.name)}">✕</button>
  </span>`;
}

/* ==========================================================================
   WIZARD STEP 7 — SUMMARY
   ========================================================================== */
function renderSummaryBody(){
  const s = state.document.summary;
  const title = state.document.personalInfo.title || '';
  const suggestions = (cvEngine.getSummarySuggestions(title) || SUMMARY_SNIPPETS || []).slice(0, 8).map(t=>t.replace(/\{title\}/g, title||'professional'));
  return `
  <div class="wizard-head">
    <div class="wizard-eyebrow">Step 7 of 8</div>
    <h1 class="wizard-title">Professional summary</h1>
    <p class="wizard-sub">Write a full introduction — two to four sentences covering your experience, strengths, and what you bring. Choose from the full examples below or generate one.</p>
  </div>
  <div class="field">
    <label for="summaryText">Summary</label>
    <textarea id="summaryText" rows="8" placeholder="A full introduction that makes a recruiter want to keep reading...">${escapeHtml(s)}</textarea>
    <div class="char-meter"><span id="summaryCharCount">${s.length} characters</span><span>Aim for 300–600</span></div>
  </div>
  <div style="margin-top:14px;"><button class="btn btn-secondary btn-sm" data-action="generate-summary">✦ Generate Example</button></div>
  <div class="summary-suggestions">
    <div class="suggested-skills-label">Full summary examples — click any to use (${suggestions.length} options)</div>
    ${suggestions.map(sn=>`<button type="button" class="suggest-chip suggest-chip-full" data-action="use-summary-snippet" data-text="${escapeAttr(sn)}">${escapeHtml(sn)}</button>`).join('')}
  </div>`;
}

/* ==========================================================================
   WIZARD STEP 8 — ADDITIONAL SECTIONS
   ========================================================================== */
const ADD_SECTION_DEFS = [
  {id:'languages', label:'Languages'},
  {id:'certifications', label:'Certifications'},
  {id:'projects', label:'Projects'},
  {id:'accomplishments', label:'Achievements'},
  {id:'hobbies', label:'Hobbies & Interests'},
  {id:'references', label:'References'}
];
function renderAdditionalSectionsBody(){
  const en = state.appearance.enabledSections;
  return `
  <div class="wizard-head">
    <div class="wizard-eyebrow">Step 8 of 8</div>
    <h1 class="wizard-title">Additional sections</h1>
    <p class="wizard-sub">Optional extras. Turn on what's relevant — you can add content for each in the editor next.</p>
  </div>
  <div class="addsec-grid">
    ${ADD_SECTION_DEFS.map(sd=>`
      <div class="addsec-card ${en[sd.id]?'on':''}">
        <span class="addsec-name">${sd.label}</span>
        <button type="button" class="toggle ${en[sd.id]?'on':''}" data-action="toggle-section" data-id="${sd.id}" aria-label="Include ${sd.label}" aria-pressed="${en[sd.id]===true}"></button>
      </div>`).join('')}
  </div>
  <div style="margin-top:22px;">
    <button class="add-entry-btn" data-action="add-custom-section">+ Add a custom section</button>
  </div>
  ${state.document.customSections.length? `
  <div style="margin-top:14px;display:flex;flex-direction:column;gap:8px;">
    ${state.document.customSections.map(cs=>`
      <div class="entry-card" style="margin-bottom:0;">
        <div class="entry-card-head">
          <div class="field" style="flex:1;"><input type="text" value="${escapeAttr(cs.title)}" data-action="rename-custom-section" data-id="${cs.id}" style="font-weight:600;border:none;padding:0;font-size:14px;"></div>
          <button class="icon-btn" data-action="delete-custom-section" data-id="${cs.id}">✕</button>
        </div>
        <textarea rows="3" placeholder="Details for this section..." data-action="edit-custom-section" data-id="${cs.id}">${escapeHtml(cs.content)}</textarea>
      </div>`).join('')}
  </div>` : ''}
  <p class="field-hint" style="margin-top:18px;">Next: your CV editor, where you'll see everything come together with a live preview.</p>`;
}

/* ==========================================================================
   CV DOCUMENT RENDERER (used in mini previews and the full editor preview)
   ========================================================================== */
function renderCVPreviewHTML(doc, appearance, opts){
  opts = opts || {};
  const a = appearance;
  const fontClass = 'doc-'+a.font;
  const sizeClass = 'fs-'+a.fontSize;
  const spClass = 'sp-'+a.spacing;
  const mgClass = 'mg-'+a.margins;
  const tmplClass = 'tmpl-'+a.template;
  const sizeMiniClass = opts.mini ? 'size-mini' : '';
  const style = `--cv-accent:${a.color};`;

  const p = doc.personalInfo || {};
  const fullName = ((p.firstName||'')+' '+(p.lastName||'')).trim() || 'Your Name';
  // Build contact line: address/city, phone, email, links (Angela style)
  const address = [p.city, p.postcode].filter(Boolean).join(' ');
  const contactBits = [address, p.phone, p.email, p.linkedin, p.website].filter(Boolean);

  const initials = ((p.firstName||'')[0]||'')+((p.lastName||'')[0]||'');
  const titleHtml = p.title
    ? `<div class="cv-title">${escapeHtml(p.title)}</div>`
    : '';
  const safePhoto=(typeof p.photo==='string' && /^data:image\/(?:png|jpeg|webp);base64,[a-z0-9+/=]+$/i.test(p.photo) && p.photo.length<2400000) ? p.photo : '';
  const photoHtml = safePhoto
    ? `<img class="cv-photo" src="${escapeAttr(safePhoto)}" alt="" />`
    : '';
  const textBlock = `
    <div class="cv-name" data-initials="${escapeAttr(initials.toUpperCase())}">${escapeHtml(fullName)}</div>
    ${titleHtml}
    <div class="cv-contact">${contactBits.map(c=>`<span>${escapeHtml(c)}</span>`).join('')}</div>`;
  const headerInner = photoHtml
    ? `<div class="cv-header-with-photo">${photoHtml}<div class="cv-header-text">${textBlock}</div></div>`
    : textBlock;

  const sectionsHtml = buildSectionsHtml(doc, a);

  let bodyHtml;
  const sidebarTemplates=['creative','creative-forest','two-column'];
  const bandTemplates=['professional','professional-slate','prestige','prestige-gold'];
  if(sidebarTemplates.includes(a.template)){
    bodyHtml = `
      <div class="cv-sidebar">${headerInner}${sectionsHtml.sidebarExtras}</div>
      <div class="cv-main">${sectionsHtml.main}</div>`;
  } else if(bandTemplates.includes(a.template)){
    bodyHtml = `<div class="cv-header-band">${headerInner}</div>${sectionsHtml.all}`;
  } else {
    bodyHtml = `${headerInner}${sectionsHtml.all}`;
  }

  const pageNum = opts.page ? `<div class="cv-page-num">Page ${opts.page}</div>` : '';
  const exportClass = opts.exportClass || '';
  return `<div class="cv-page ${tmplClass} ${fontClass} ${sizeClass} ${spClass} ${mgClass} ${sizeMiniClass} ${exportClass}" style="${style}">${bodyHtml}${pageNum}</div>`;
}

function buildSectionsHtml(doc, a){
  const order = a.sectionOrder.filter(id => SECTION_META[id] && (SECTION_META[id].core || a.enabledSections[id]));
  const sidebarIds = new Set(['skills','languages','certifications','hobbies']);
  let allHtml='', mainHtml='', sidebarHtml='';
  order.forEach(id=>{
    const block = renderCVSection(id, doc, a.template);
    allHtml += block;
    if((a.template==='creative'||a.template==='creative-forest'||a.template==='two-column') && sidebarIds.has(id)){
      sidebarHtml += block;
    } else {
      mainHtml += block;
    }
  });
  (doc.customSections||[]).forEach(cs=>{
    const block = `<div class="cv-section"><div class="cv-section-title">${escapeHtml(cs.title)}</div><p class="cv-summary-text">${escapeHtml(cs.content)}</p></div>`;
    allHtml += block;
    mainHtml += block;
  });
  if(a.template!=='creative'&&a.template!=='creative-forest'&&a.template!=='two-column'){
    return {all: allHtml, main: allHtml, sidebarExtras:''};
  }
  return {all: allHtml, main: mainHtml, sidebarExtras: sidebarHtml};
}

function sectionTitleFor(id, template){
  const classic = (template==='modern' || template==='professional' || template==='ats-classic' || template==='minimal' || template==='executive');
  const map = {
    summary: classic ? 'Professional Summary' : 'Summary',
    experience: classic ? 'Work History' : 'Experience',
    education: 'Education',
    skills: 'Skills',
    languages: 'Languages',
    certifications: 'Certifications',
    projects: 'Projects',
    accomplishments: 'Achievements',
    hobbies: 'Hobbies & Interests',
    references: 'References'
  };
  return map[id] || id;
}
function renderCVSection(id, doc, template){
  const tmpl = template || (state && state.appearance && state.appearance.template) || 'modern';
  const title = sectionTitleFor(id, tmpl);
  switch(id){
    case 'summary':
      if(!doc.summary) return '';
      return `<div class="cv-section"><div class="cv-section-title">${title}</div><p class="cv-summary-text">${escapeHtml(doc.summary)}</p></div>`;
    case 'experience':
      if(!doc.experience.length) return '';
      return `<div class="cv-section"><div class="cv-section-title">${title}</div>${doc.experience.map(ex=>{
        const dates = ex.current ? (fmtMonth(ex.start)+' – Present') : [fmtMonth(ex.start),fmtMonth(ex.end)].filter(Boolean).join(' – ');
        const role = escapeHtml(ex.title)||'Role';
        const company = escapeHtml(ex.employer||'');
        const loc = escapeHtml(ex.location||'');
        const sub = [company, loc].filter(Boolean).join(', ');
        return `<div class="cv-entry">
          <div class="cv-entry-head"><span class="cv-role">${role}</span><span class="cv-dates">${dates}</span></div>
          ${sub?`<div class="cv-entry-sub">${sub}</div>`:''}
          ${safeExperienceDescription(ex.description)}
        </div>`;
      }).join('')}</div>`;
    case 'education':
      if(!doc.education.length) return '';
      return `<div class="cv-section"><div class="cv-section-title">${title}</div>${doc.education.map(ed=>{
        const dates = ed.current ? (fmtMonth(ed.start)+' – Present') : [fmtMonth(ed.start),fmtMonth(ed.end)].filter(Boolean).join(' – ');
        // Prefer year-only display when only year matters (Angela style: "2015")
        const yearOnly = dates && !ed.current && (ed.start||'').length>=4 ? (ed.end||ed.start||'').slice(0,4) : dates;
        const qual = escapeHtml(ed.qualification||'') + (ed.field ? ', '+escapeHtml(ed.field) : '');
        const inst = escapeHtml(ed.institution||'') + (ed.location ? ', '+escapeHtml(ed.location) : '');
        return `<div class="cv-entry">
          <div class="cv-entry-head"><span class="cv-role">${qual}</span><span class="cv-dates">${escapeHtml(yearOnly||dates||'')}</span></div>
          ${inst?`<div class="cv-entry-sub">${inst}</div>`:''}
        </div>`;
      }).join('')}</div>`;
    case 'skills':
      if(!doc.skills.length) return '';
      // Two-column bullet list (Angela style) for classic templates; compact line for ATS/simple
      if(tmpl==='ats-classic' || tmpl==='ats-compact' || tmpl==='simple'){
        return `<div class="cv-section"><div class="cv-section-title">${title}</div><div class="cv-skills-line">${doc.skills.map(s=>escapeHtml(s.name)).join(' · ')}</div></div>`;
      }
      const items = doc.skills.map(s=>`<li>${escapeHtml(s.name)}</li>`).join('');
      return `<div class="cv-section"><div class="cv-section-title">${title}</div><ul class="cv-skills-grid">${items}</ul></div>`;
    case 'languages':
      if(!doc.languages.length) return '';
      return `<div class="cv-section"><div class="cv-section-title">${title}</div><div class="cv-skills-line">${doc.languages.map(l=>escapeHtml(l.name)+' ('+escapeHtml(l.level)+')').join(' · ')}</div></div>`;
    case 'certifications':
      if(!doc.certifications.length) return '';
      return `<div class="cv-section cv-certifications-section"><div class="cv-section-title">${title}</div>${doc.certifications.map(c=>`<div class="cv-entry"><div class="cv-entry-head"><span class="cv-role">${escapeHtml(c.name)}</span><span class="cv-dates">${escapeHtml(c.year||'')}</span></div><div class="cv-entry-sub">${escapeHtml(c.issuer||'')}</div></div>`).join('')}</div>`;
    case 'projects':
      if(!doc.projects.length) return '';
      return `<div class="cv-section"><div class="cv-section-title">${title}</div>${doc.projects.map(pr=>`<div class="cv-entry"><div class="cv-entry-head"><span class="cv-role">${escapeHtml(pr.name)}</span><span class="cv-dates"></span></div><p class="cv-summary-text">${escapeHtml(pr.description||'')}</p></div>`).join('')}</div>`;
    case 'accomplishments':
      if(!doc.accomplishments.length) return '';
      return `<div class="cv-section"><div class="cv-section-title">${title}</div><ul class="cv-achievements">${doc.accomplishments.map(ac=>`<li>${escapeHtml((ac.category?ac.category+': ':'')+ac.text)}${ac.impact?` <span class="cv-achievement-impact">(${escapeHtml(ac.impact)})</span>`:''}</li>`).join('')}</ul></div>`;
    case 'hobbies':
      if(!doc.hobbies) return '';
      return `<div class="cv-section"><div class="cv-section-title">${title}</div><p class="cv-summary-text">${escapeHtml(doc.hobbies)}</p></div>`;
    case 'references':
      if(!doc.references) return '';
      return `<div class="cv-section"><div class="cv-section-title">${title}</div><p class="cv-summary-text">${escapeHtml(doc.references)}</p></div>`;
    default: return '';
  }
}

/* rough pagination heuristic: split experience across a synthetic 2nd page if long */
function estimatePageCount(doc){
  let weight = doc.experience.length*2 + doc.education.length + Math.ceil(doc.skills.length/6);
  weight += doc.customSections.length;
  if(state.appearance.enabledSections.certifications) weight += doc.certifications.length*0.6;
  if(state.appearance.enabledSections.projects) weight += doc.projects.length*0.8;
  return weight > 9 ? 2 : 1;
}

/* ==========================================================================
   EDITOR SCREEN
   ========================================================================== */
const EDITOR_PANELS = [
  {id:'review', label:'CV review & readiness'},
  {id:'personal', label:'Personal details'},
  {id:'versions', label:'My CV versions'},
  {id:'summary', label:'Professional Summary'},
  {id:'target', label:'Job Match'},
  {id:'cover-letter', label:'Cover Letter'},
  {id:'experience', label:'Experience'},
  {id:'education', label:'Education'},
  {id:'skills', label:'Skills'},
  {id:'additional', label:'Additional Sections'},
  {id:'design', label:'Template & Design'}
];

function ledgerCVWordCount(doc){
  // Count only the CV's own factual content, never sample text or UI hints.
  if(!doc || typeof doc!=='object')return 0;
  const parts=[];
  const collect=(value,depth)=>{
    if(depth>8 || value==null)return;
    if(typeof value==='string'){parts.push(value.replace(/<[^>]*>/g,' '));return;}
    if(Array.isArray(value)){for(const entry of value)collect(entry,depth+1);return;}
    if(typeof value==='object')for(const [k,v] of Object.entries(value)){
      if(!['id','level','current','enabled','templateId','photo','image','data'].includes(k))collect(v,depth+1);
    }
  };
  collect(doc,0);
  const words=parts.join(' ').replace(/&[a-z]+;/gi,' ').trim().match(/[^\s]+/g);
  return words?words.length:0;
}

function renderEditor(){
  const view = state.ui.editorView;
  return `
  <div class="screen active editor-shell">
    ${renderTopnav({simple:true})}
    <div class="editor-toolbar">
      <div class="editor-toolbar-title"><span class="ledger-eyebrow">${LEDGER_BUILD}</span><span>${escapeHtml((state.versions.find(v=>v.id===state.activeVersionId)||{}).name||'My CV')}</span></div>
      <div class="editor-tabs">
        <button aria-pressed="${view==='edit'}" class="${view==='edit'?'active':''}" data-action="editor-view" data-value="edit">Edit</button>
        <button aria-pressed="${view==='preview'}" class="${view==='preview'?'active':''}" data-action="editor-view" data-value="preview">Preview</button>
      </div>
      <div class="ledger-editor-history" role="group" aria-label="CV editing history"><button type="button" class="btn btn-secondary btn-sm" data-action="ledger-undo" title="Undo last CV change" aria-label="Undo last CV change" ${ledgerUndoStack.length&&!ledgerWriteLocked?'':'disabled'}>↶ Undo</button><button type="button" class="btn btn-secondary btn-sm" data-action="ledger-redo" title="Redo last CV change" aria-label="Redo last CV change" ${ledgerRedoStack.length&&!ledgerWriteLocked?'':'disabled'}>↷ Redo</button></div>
      <div class="ledger-editor-quicknav"><label for="ledgerEditorQuickNav">Jump to</label><select id="ledgerEditorQuickNav" aria-label="Jump to CV editor section">${EDITOR_PANELS.map(p=>`<option value="${escapeAttr(p.id)}" ${state.ui.editorPanel===p.id?'selected':''}>${escapeHtml(p.label)}</option>`).join('')}</select></div>
      <span class="ledger-editor-wordcount" aria-label="Approximate CV word count">${ledgerCVWordCount(state.document)} words</span>
      <span class="save-status" id="saveStatus" role="status" aria-live="polite">${escapeHtml(state.ui.saveStatus||'Saved locally')}</span><button type="button" class="btn btn-secondary btn-sm ledger-review-entry" data-action="editor-panel" data-value="review">Review CV <span class="ledger-review-count">${ledgerCVReview(state.document).filter(x=>x.level==='action').length}</span></button><button type="button" class="btn btn-secondary btn-sm" data-action="editor-panel" data-value="versions">My CVs (${state.versions.length})</button><button type="button" class="btn btn-secondary btn-sm" id="ledgerStage4Open" onclick="ledgerStage4Open()">Release preparation</button><button type="button" class="btn btn-secondary btn-sm" id="ledgerStage3Open" onclick="ledgerStage3Open()">Documents &amp; ATS</button><button type="button" class="btn btn-primary btn-sm" data-action="open-download">Export CV ↗</button>
    </div>
    <div class="editor-body view-${view}">
      <div class="editor-panel">
        <div class="editor-panel-group">
          <div class="editor-panel-label">Edit</div>
          <div class="editor-nav-list">
            ${EDITOR_PANELS.map(p=>`<button class="editor-nav-item ${state.ui.editorPanel===p.id?'active':''}" ${state.ui.editorPanel===p.id?'aria-current="page"':''} data-action="editor-panel" data-value="${p.id}"><span>${p.label}</span><span>›</span></button>`).join('')}
          </div>
        </div>
        ${renderEditorPanelContent()}
      </div>
      <div class="editor-preview-wrap" id="editorPreviewWrap">
        ${renderFullPreview()}
      </div>
    </div>
  </div>`;
}

function getSafePrintStyle(template){
  const id=String(template||'modern').toLowerCase();
  if(['trades','construction','electrical'].includes(id)) return {id:'trade',name:'Trade / technical'};
  if(['executive','prestige','prestige-gold','monogram','monogram-navy','classic-serif','academic','horizon','horizon-teal'].includes(id))return {id:'executive',name:'Executive'};
  if(['minimal','minimal-ink','simple','ats-classic','ats-compact','ats-plus','compact-pro'].includes(id))return {id:'classic',name:'Classic / ATS'};
  if(['creative','creative-forest','two-column'].includes(id))return {id:'classic',name:'Classic / ATS',simplified:true};
  return {id:'modern',name:'Modern'};
}
function safePrintAccent(value){return /^#[0-9a-f]{6}$/i.test(String(value||''))?value:'#2B6F68';}
function printStyleDescription(){
 const a=state.appearance, profile=getSafePrintStyle(a.template);
 return profile.name+(profile.simplified?' (sidebar simplified for reliable pagination)':'');
}
function buildReadingPreviewHtml(){
 const css=`
@media screen{html,body{width:auto!important;min-height:0!important;max-width:none!important;overflow:visible!important}body{padding:23px 20px 40px!important;font-size:13px!important;line-height:1.55!important}header{padding-bottom:14px!important;margin-bottom:18px!important}h1{font-size:26px!important;overflow-wrap:anywhere}header .contact{font-size:12px!important}header .title{font-size:14px!important}h2{font-size:13px!important}h3{font-size:13px!important}.meta{font-size:12px!important}section{margin-bottom:17px!important}.entry{margin-bottom:12px!important}p,li{font-size:13px!important}li{break-inside:auto!important}section,main,.entry,ul{max-width:100%}*{overflow-wrap:anywhere}}`;
 return buildTextCvHtml().replace('</style>',''+css+'</style>');
}
function renderFullPreview(){
  const mode=(state.ui.previewMode==='design')?'design':'application';
  const p=state.document.personalInfo||{};
  const name=[p.firstName,p.lastName].filter(Boolean).join(' ')||'Untitled CV';
  const counts=[(state.document.experience||[]).length+' roles',(state.document.education||[]).length+' education items',(state.document.skills||[]).length+' skills'].join(' · ');
  const actions=`<div class="ledger-document-switch" role="group" aria-label="Document preview type">
    <button type="button" data-action="preview-format" data-value="application" class="${mode==='application'?'on':''}" aria-pressed="${mode==='application'}">Application-ready</button>
    <button type="button" data-action="preview-format" data-value="design" class="${mode==='design'?'on':''}" aria-pressed="${mode==='design'}">Template design</button>
  </div>`;
  if(mode==='design'){
    const html=renderCVPreviewHTML(state.document,state.appearance,{});
    return `<div class="ledger-doclab-head"><div><strong>Template design</strong><small>${escapeHtml(state.appearance.template)} · ${escapeHtml(counts)}</small></div>${actions}</div>
      <div class="ledger-preview-page">${html}</div>
      <p class="ledger-preview-hint"><strong>Visual design reference only.</strong> This sample is not paginated. Switch to <strong>Application-ready</strong> to inspect your actual print-safe profile for PDF and HTML. Sidebar layouts become a simple, readable column when exported.</p>`;
  }
  const reading=!!state.ui.previewReading;
  const html=reading?buildReadingPreviewHtml():buildTextCvHtml();
  return `<div class="ledger-doclab-head"><div><strong>Application-ready document</strong><small>${escapeHtml(name)} · ${escapeHtml(counts)} · ${escapeHtml(printStyleDescription())}</small></div>${actions}</div>
    <div class="ledger-application-preview-label"><span class="ledger-ready-indicator">● Selectable text · ${escapeHtml(printStyleDescription())}</span><div class="ledger-read-switch" role="group" aria-label="Document preview size"><button type="button" data-action="preview-reading" data-value="fit" class="${reading?'':'on'}" aria-pressed="${!reading}">Fit page</button><button type="button" data-action="preview-reading" data-value="read" class="${reading?'on':''}" aria-pressed="${reading}">Read text</button></div></div>
    <div class="ledger-ready-frame-shell ${reading?'ledger-reading-mode':''}" id="ledgerReadyFrameShell"><iframe id="ledgerReadyFrame" title="${reading?'Readable CV text preview':'A4 CV layout preview'}" sandbox="allow-same-origin" loading="eager" srcdoc="${escapeAttr(html)}"></iframe></div>
    <p class="ledger-preview-hint">${reading?'<strong>Reading mode:</strong> Enlarged, reflowed text for comfortable review. Switch to Fit page to inspect the actual A4 typography. Reading mode does not change the PDF.':'<strong>A4 layout preview:</strong> Text and styling match Print / Save PDF and HTML, but page breaks are calculated by the browser at print time.'} Word remains an editable, separately paginated document. Verify the exported file before submitting.</p>`;
}

function syncLedgerReadyPreview(){
  const shell=document.getElementById('ledgerReadyFrameShell');
  const frame=document.getElementById('ledgerReadyFrame');
  if(!shell||!frame)return;
  const reading=!!state.ui.previewReading;
  const width=reading?Math.max(240,shell.clientWidth):794;
  const scale=reading?1:Math.min(1,Math.max(.20,shell.clientWidth/794));
  frame.style.width=width+'px';
  frame.style.transform=reading?'none':'scale('+scale+')';
  const doc=frame.contentDocument;
  if(!doc||!doc.body){ shell.style.height=Math.ceil((reading?350:1123)*scale)+'px';return; }
  const height=reading?Math.max(230,Math.ceil(doc.body.scrollHeight),Math.ceil(doc.documentElement.scrollHeight)):Math.max(1123,Math.ceil(doc.body.scrollHeight),Math.ceil(doc.documentElement.scrollHeight));
  frame.style.height=height+'px';
  shell.style.height=Math.ceil(height*scale+2)+'px';
}
function wireLedgerReadyPreview(){
  const frame=document.getElementById('ledgerReadyFrame');
  if(!frame)return;
  frame.addEventListener('load',()=>{syncLedgerReadyPreview();requestAnimationFrame(syncLedgerReadyPreview);});
  requestAnimationFrame(syncLedgerReadyPreview);
}
window.addEventListener('resize',syncLedgerReadyPreview);
function ledgerFocusEditorPanel(){
  const panel=document.querySelector('.editor-panel');
  if(!panel)return;
  const target=panel.querySelector('.ledger-personal-panel h2, .ledger-review-panel h2') || panel.querySelector('.editor-content-panel.active h2') || panel.querySelector('.editor-panel-group .editor-panel-label');
  if(target){target.setAttribute('tabindex','-1');target.focus({preventScroll:true});}
}
function renderEditorPanelContent(){
  const panel = state.ui.editorPanel;
  const doc = state.document;
  const a = state.appearance;
  if(panel==='review') return renderLedgerReviewPanel();
  if(panel==='personal') return renderLedgerPersonalPanel();
  if(panel==='versions') return renderVersionsPanel();
  if(panel==='summary'){
    const title = doc.personalInfo.title || '';
    const suggestions = (cvEngine.getSummarySuggestions(title) || []).slice(0, 8).map(s=>s.replace(/\{title\}/g, title||'professional'));
    return `<div class="editor-panel-group">
      <div class="field"><label>Professional Summary</label><textarea id="edSummary" rows="8" placeholder="Two to four full sentences that introduce your experience and strengths...">${escapeHtml(doc.summary)}</textarea></div>
      <div class="char-meter" style="margin-top:6px;"><span>${(doc.summary||'').length} characters</span><span>Aim for 300–600</span></div>
      <button class="btn btn-secondary btn-sm" style="margin-top:10px;" data-action="generate-summary">✦ Use an example (verify claims)</button>
      <div class="summary-suggestions" style="margin-top:16px;">
        <div class="suggested-skills-label">Full summary examples — click to use (6–8 options)</div>
        ${suggestions.map(sn=>`<button type="button" class="suggest-chip suggest-chip-full" data-action="use-summary-snippet" data-text="${escapeAttr(sn)}">${escapeHtml(sn)}</button>`).join('') || '<p class="field-hint">Add a job title in Personal Info to see tailored examples.</p>'}
      </div>
    </div>`;
  }
  if(panel==='target'){
    return renderTargetPanel();
  }
  if(panel==='cover-letter'){
    return renderCoverLetterPanel();
  }
  if(panel==='experience'){
    return `<div class="editor-panel-group">
      <div id="edExperienceList">${doc.experience.length===0?'<p class="field-hint">No experience yet.</p>':doc.experience.map((ex,i)=>renderExperienceEntry(ex,i,doc.experience.length,state.ui.editingExperienceId)).join('')}</div>
      <button class="add-entry-btn" style="margin-top:10px;" data-action="add-experience">+ Add a job</button>
    </div>`;
  }
  if(panel==='education'){
    return `<div class="editor-panel-group">
      <div id="edEducationList">${doc.education.length===0?'<p class="field-hint">No education yet.</p>':doc.education.map((ed,i)=>renderEducationEntry(ed,i,doc.education.length,state.ui.editingEducationId)).join('')}</div>
      <button class="add-entry-btn" style="margin-top:10px;" data-action="add-education">+ Add education</button>
    </div>`;
  }
  if(panel==='skills'){
    return `<div class="editor-panel-group">
      <div class="skill-input-row"><input type="text" id="skillInput" aria-label="Add a skill" placeholder="Add a skill" style="flex:1;padding:9px 10px;border:1px solid var(--line);border-radius:4px;font-size:13.5px;"><button class="btn btn-secondary btn-sm" data-action="add-skill-from-input">Add</button></div>
      <div class="skill-chips" style="margin-top:12px;">${doc.skills.map((s,i)=>renderSkillChip(s,i)).join('')}</div>
    </div>`;
  }
  if(panel==='additional'){
    return `<div class="editor-panel-group">
      ${ADD_SECTION_DEFS.map(sd=>`<div class="addsec-card ${a.enabledSections[sd.id]?'on':''}" style="margin-bottom:8px;"><span class="addsec-name">${sd.label}</span><button type="button" class="toggle ${a.enabledSections[sd.id]?'on':''}" aria-label="${sd.label}" aria-pressed="${!!a.enabledSections[sd.id]}" data-action="toggle-section" data-id="${sd.id}"></button></div>`).join('')}
      ${renderAdditionalSectionEditors()}
    </div>`;
  }
  if(panel==='design'){
    return renderDesignPanel();
  }
  return '';
}

/* -------------------------------------------------------------------------
   Stage 1 CV Review: transparent, deterministic editorial checks.
   These are NOT ATS predictions or hiring probabilities. Nothing is uploaded.
   ------------------------------------------------------------------------- */
function ledgerHasRealWork(d){
 // A CV containing only projects, certifications, volunteer achievements,
 // notes or a photograph is still work. New/restore must never erase it.
 if(!d || typeof d!=='object')return false;
 const p=d.personalInfo||{};
 const personal=Object.values(p).some(value=>typeof value==='string'&&value.trim());
 const text=['summary','hobbies','references'].some(key=>typeof d[key]==='string'&&d[key].trim());
 const arrays=['experience','education','skills','languages','certifications','projects','accomplishments','customSections']
   .some(key=>Array.isArray(d[key])&&d[key].length>0);
 return Boolean(personal||text||arrays);
}
// A blank *active* CV does not mean the workspace is empty. Other versions,
// job-targeting drafts, and cover-letter writing all deserve restore protection.
function ledgerVersionHasRealWork(v){
 if(!v || typeof v!=='object')return false;
 if(ledgerHasRealWork(v.document))return true;
 const t=v.targeting||{},c=v.coverLetter||{};
 return ['title','employer','description'].some(k=>typeof t[k]==='string'&&t[k].trim()) ||
   ['employer','role','opening','body','text'].some(k=>typeof c[k]==='string'&&c[k].trim()) ||
   (typeof c.closing==='string'&&c.closing.trim()&&c.closing.trim()!=='Yours sincerely,');
}
function ledgerWorkspaceHasRealWork(){
 return ledgerVersionHasRealWork(state) ||
   (Array.isArray(state.versions)&&(
     state.versions.length>1 || state.versions.some(v=>ledgerVersionHasRealWork(v))));
}
function ledgerEmailValid(email){return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(email||'').trim());}
function ledgerCoreProgress(doc){
 const p=doc.personalInfo||{};
 const marks=[!!String(p.firstName||'').trim()&&!!String(p.lastName||'').trim(),
  !!String(p.email||p.phone||'').trim(),!!String(p.title||'').trim(),
  !!String(doc.summary||'').trim(),
  (doc.experience||[]).some(x=>String(x.title||'').trim()&&String(x.employer||'').trim()&&descriptionLines(x.description).length>0)||
    (doc.projects||[]).some(x=>x.name&&x.description),
  (doc.education||[]).some(x=>x.institution&&x.qualification)||(doc.certifications||[]).some(x=>x.name),
  (doc.skills||[]).filter(x=>String(x.name||'').trim()).length>=3];
 return {done:marks.filter(Boolean).length,total:marks.length};
}
function ledgerCVReview(doc){
 const p=doc.personalInfo||{}, checks=[];
 const push=(id,title,detail,panel,level='action')=>checks.push({id,title,detail,panel,level});
 const trim=x=>String(x||'').trim();
 const exp=doc.experience||[], edu=doc.education||[], skills=doc.skills||[];
 if(!trim(p.firstName)||!trim(p.lastName))push('name','Add your first and last name','Employers need to identify whose CV they are reading.','personal');
 if(!trim(p.email)&&!trim(p.phone))push('contact','Add a way to reach you','Include at least an email address or phone number.','personal');
 else if(trim(p.email)&&!ledgerEmailValid(p.email))push('email','Check the email address','The format looks incorrect. Make sure employers can reply.','personal');
 if(!trim(p.title))push('headline','Add the role you want','A clear professional title helps readers understand your target.','personal');
 if(!trim(doc.summary))push('summary','Write a short professional summary','Describe your genuine experience and strengths in two to four sentences.','summary');
 else if(trim(doc.summary).length<60)push('summary-detail','Give your summary more context','It is quite brief; consider adding a specific strength, context or objective.','summary','tip');
 if(!exp.some(x=>trim(x.title)&&trim(x.employer)&&descriptionLines(x.description).length) && !(doc.projects||[]).some(x=>trim(x.description))){
   push('evidence','Show what you have done','Add work, volunteering or a relevant project. First-time applicants can use projects instead of paid work.','experience');
 }
 exp.forEach((x,i)=>{
   const role=trim(x.title)||'Role '+(i+1);
   if(!trim(x.title)||!trim(x.employer))push('job-'+i,'Complete the '+role+' entry','Give each role a job title and organisation.','experience');
   if(trim(x.title)&&descriptionLines(x.description).length===0)push('bullet-'+i,'Add evidence to '+role,'Explain what you did, how you worked, or the result. Never invent metrics.','experience','tip');
   if(x.start&&x.end&&!x.current&&/^\d{4}-\d\d$/.test(x.start)&&/^\d{4}-\d\d$/.test(x.end)&&x.start>x.end)push('job-date-'+i,'Fix the dates for '+role,'The end date appears before the start date.','experience');
 });
 edu.forEach((x,i)=>{
   if(!trim(x.institution)&&!trim(x.qualification)&&!trim(x.field))return;
   if(!trim(x.institution)||!trim(x.qualification))push('edu-'+i,'Complete education entry '+(i+1),'Include the institution and the qualification.','education','tip');
   if(x.start&&x.end&&!x.current&&/^\d{4}-\d\d$/.test(x.start)&&/^\d{4}-\d\d$/.test(x.end)&&x.start>x.end)push('edu-date-'+i,'Check education dates','The education end date precedes its start.','education');
 });
 const seenJobs=new Set(), seenEducation=new Set();
 exp.forEach((x,i)=>{
   const key=[x.title,x.employer,x.start].map(v=>trim(v).toLocaleLowerCase()).join('|');
   if(trim(x.title)&&trim(x.employer)&&seenJobs.has(key))push('duplicate-job-'+i,'Check repeated work entry','A role with the same employer, title and start date appears more than once.','experience','tip');
   seenJobs.add(key);
   if(x.start&&!/^\d{4}-(0[1-9]|1[0-2])$/.test(x.start))push('start-format-'+i,'Check work start month','Use a valid year and month.','experience');
   if(x.end&&!x.current&&!/^\d{4}-(0[1-9]|1[0-2])$/.test(x.end))push('end-format-'+i,'Check work end month','Use a valid year and month.','experience');
 });
 edu.forEach((x,i)=>{
   const key=[x.institution,x.qualification,x.start].map(v=>trim(v).toLocaleLowerCase()).join('|');
   if(trim(x.institution)&&trim(x.qualification)&&seenEducation.has(key))push('duplicate-education-'+i,'Check repeated education entry','A qualification appears more than once at the same institution and start date.','education','tip');
   seenEducation.add(key);
 });
 if(skills.filter(x=>trim(x.name)).length<3)push('skills','Add at least three relevant skills','Include skills you can demonstrate from work, study or projects.','skills','tip');
 const found=new Set();
 if(skills.some(x=>{const n=trim(x.name).toLocaleLowerCase();if(!n)return false;if(found.has(n))return true;found.add(n);return false;}))push('duplicate-skills','Remove repeated skills','Each skill should appear only once.','skills','tip');
 if(/\b(?:example\.com|yourname|your name|insert here|lorem ipsum)\b/i.test([p.email,p.linkedin,p.website,doc.summary].join(' ')))
   push('placeholder','Replace example or placeholder details','Example addresses and filler text should never go into a real application.','personal');
 // A deliberately specific reminder, not a proof of who owns the content.
 if((p.email||'').toLowerCase().endsWith('@example.com'))push('demo','Replace demo CV contact details','This appears to be sample content, not a real applicant email.','personal');
 if(!trim(p.city))push('location','Consider adding your city','City or region is usually enough; your full address is not necessary.','personal','tip');
 return checks;
}
function ledgerReviewSummary(){
 const all=ledgerCVReview(state.document), essentials=ledgerCoreProgress(state.document), actions=all.filter(x=>x.level==='action');
 return {all,essentials,actions};
}
function renderLedgerReviewPanel(){
 const {all,essentials,actions}=ledgerReviewSummary();
 return `<section class="ledger-review-panel" aria-labelledby="ledgerReviewTitle">
 <p class="ledger-panel-eyebrow">QUALITY CHECK · PRIVATE & LOCAL</p>
 <h2 id="ledgerReviewTitle">Review before you apply</h2>
 <p class="field-hint">Ledger checks clarity and completeness, not your chances of getting hired. These suggestions stay on your device.</p>
 <div class="ledger-review-overview"><div><strong>${essentials.done} / ${essentials.total}</strong><span>Essentials drafted</span></div><div><strong>${actions.length}</strong><span>Important things to check</span></div></div>
 <div class="ledger-review-progress" role="progressbar" aria-valuenow="${essentials.done}" aria-valuemax="${essentials.total}" aria-valuemin="0" aria-label="CV essentials drafted"><span style="width:${Math.round(100*essentials.done/essentials.total)}%"></span></div>
 ${all.length?`<div class="ledger-review-list">${all.map(x=>`<div class="ledger-review-item"><span class="ledger-review-symbol ${x.level==='tip'?'is-tip':''}" aria-hidden="true">${x.level==='tip'?'i':'!'}</span><div><strong>${escapeHtml(x.title)}</strong><p>${escapeHtml(x.detail)}</p><button type="button" data-action="fix-review" data-panel="${escapeAttr(x.panel)}">Open ${escapeHtml(({personal:'Personal details',summary:'Summary',experience:'Experience',education:'Education',skills:'Skills'})[x.panel]||'editor')} →</button></div></div>`).join('')}</div>`:'<div class="ledger-review-empty">✓ No issues detected by this checklist. Read the exported document carefully before applying.</div>'}
 <div class="ledger-review-honesty"><strong>Before sending</strong><p>Check every date, qualification, employer, number and achievement. Suggested writing is not verified evidence. Preview the final PDF or Word document and keep a project backup.</p></div>
 <div class="ledger-review-actions"><button type="button" class="btn btn-primary btn-sm" data-action="open-download">Export your CV ↗</button><button type="button" class="btn btn-secondary btn-sm" data-action="export-project">Back up project</button></div></section>`;
}
function renderLedgerPersonalPanel(){
 const p=state.document.personalInfo||{};
 const fields=[
  ['firstName','First name','text','Your given name'],['lastName','Last name','text','Family name'],
  ['title','Professional headline','text','e.g. Sales Associate'],['email','Email','email','you@domain.com'],
  ['phone','Phone','tel','Include country code if useful'],['city','City / region','text','City, country'],
  ['postcode','Postal code (optional)','text',''],['linkedin','LinkedIn (optional)','text','linkedin.com/in/you'],
  ['website','Portfolio / website (optional)','text','yourportfolio.com']];
 return `<section class="ledger-personal-panel" aria-labelledby="ledgerPersonalTitle"><p class="ledger-panel-eyebrow">STEP 1 · THE BASICS</p><h2 id="ledgerPersonalTitle">Personal details</h2><p class="field-hint">Edit your contact information here at any time. Changes save as you type and update the preview. You do not need to provide a street address or photograph.</p>
 <div class="ledger-personal-fields">${fields.map(([key,label,type,placeholder])=>`<div class="field"><label for="ledgerPersonal-${key}">${label}</label><input id="ledgerPersonal-${key}" maxlength="${key==='email'||key==='website'||key==='linkedin'?180:100}" type="${type}" data-ledger-personal="${key}" autocomplete="${({firstName:'given-name',lastName:'family-name',email:'email',phone:'tel',city:'address-level2'})[key]||'off'}" value="${escapeAttr(p[key]||'')}" placeholder="${escapeAttr(placeholder)}"></div>`).join('')}</div>
 <p class="field-hint">A complete name and a working contact method matter more than optional fields. Avoid example addresses in applications.</p>
 <button type="button" class="btn btn-secondary btn-sm" data-action="editor-panel" data-value="review">Check my CV →</button></section>`;
}

function renderVersionsPanel(){
  ensureVersions();
  const items=state.versions.slice().sort((a,b)=>(b.updatedAt||'').localeCompare(a.updatedAt||''));
  return `<div class="editor-panel-group">
    <div class="editor-panel-label">Career workspace</div>
    <p class="field-hint">Mark a master CV and create tailored copies without overwriting your original facts. Each version has its own content, design and job match. Saved in this browser when storage is available. Download a JSON backup for safekeeping.</p>
    <div class="ledger-version-tools"><button class="btn btn-primary btn-sm" data-action="new-version">+ New blank CV</button><button class="btn btn-secondary btn-sm" data-action="duplicate-version">Duplicate current</button><button class="btn btn-secondary btn-sm" data-action="duplicate-master">Copy master CV</button></div>
    <div class="ledger-version-list">${items.map(v=>`<div class="ledger-version-card ${v.id===state.activeVersionId?'active':''}">
      <div class="ledger-version-row"><strong>${escapeHtml(v.name)}</strong>${v.isMaster?'<span class="ledger-current-tag">Master</span>':''}${v.id===state.activeVersionId?'<span class="ledger-current-tag">Current</span>':''}</div>
      <small>${escapeHtml(new Date(v.updatedAt||Date.now()).toLocaleDateString())}</small>
      <div class="ledger-version-actions">${v.id===state.activeVersionId?`<input id="ledgerVersionRename" aria-label="Rename current CV" maxlength="70" value="${escapeAttr(v.name)}"><button class="btn btn-ghost btn-sm" data-action="rename-version">Rename</button>${!v.isMaster?'<button class="btn btn-secondary btn-sm" data-action="make-master">Set as master</button>':''}`:`<button class="btn btn-secondary btn-sm" data-action="switch-version" data-id="${v.id}">Open</button><button class="btn btn-ghost btn-sm" data-action="delete-version" data-id="${v.id}">Delete</button>`}</div>
    </div>`).join('')}</div>
    <p class="field-hint">Tip: duplicate a master CV, then use Job Match to tailor the copy. Download a JSON backup before clearing browser data.</p>
  </div>`;
}

function renderTargetPanel(){
  const t=state.targeting||{title:'',employer:'',description:'',analysis:null};
  const a=t.analysis;
  return `<div class="editor-panel-group">
    <div class="editor-panel-label">Target this CV</div>
    <p class="field-hint">Paste a job advert to identify keywords your CV already covers and the gaps worth addressing. Ledger does not invent qualifications.</p>
    <div class="field" style="margin-top:12px;"><label>Target job title</label><input type="text" id="targetTitle" value="${escapeAttr(t.title||state.document.personalInfo.title||'')}" placeholder="e.g. Warehouse Operative"></div>
    <div class="field" style="margin-top:12px;"><label>Employer <span class="opt">(optional)</span></label><input type="text" id="targetEmployer" value="${escapeAttr(t.employer||'')}" placeholder="Company name"></div>
    <div class="field" style="margin-top:12px;"><label>Job description</label><textarea id="targetDescription" rows="8" placeholder="Paste the vacancy text here…">${escapeHtml(t.description||'')}</textarea></div>
    <button class="btn btn-primary btn-sm" data-action="analyze-target" style="margin-top:10px;">Analyse job match</button>
    ${a?renderTargetAnalysis(a):''}
  </div>`;
}
function renderTargetAnalysis(a){
  const ats=a.ats||computeAtsScore(state.document,state.appearance,a);
  const band=ats.band||'mid';
  return `<div class="target-card">
    <strong>Job keyword match: ${a.score}%</strong>
    <div class="target-score"><div class="target-score-bar"><span style="width:${a.score}%;"></span></div>
    <span>${a.score>=75?'Strong match':a.score>=50?'Good starting point':'Needs tailoring'}</span></div>
    <div class="keyword-pills">${(a.found||[]).map(k=>`<span class="keyword-pill found">${escapeHtml(k)}</span>`).join('')}${(a.missing||[]).map(k=>`<span class="keyword-pill missing">${escapeHtml(k)}</span>`).join('')}</div>
    <p class="field-hint" style="margin-top:8px;">Green = already in your CV. Red = consider adding only if true for you.</p>
    ${a.skillIdeas&&a.skillIdeas.length?`<div class="suggest-from-job"><strong>Suggested skills to add</strong><div class="keyword-pills" style="margin-top:6px;">${a.skillIdeas.map(s=>`<button type="button" class="keyword-pill" data-action="add-skill-from-suggest" data-name="${escapeAttr(s)}">+ ${escapeHtml(s)}</button>`).join('')}</div></div>`:''}
    ${a.bulletIdeas&&a.bulletIdeas.length?`<div class="suggest-from-job"><strong>Bullet ideas for this role</strong><ul class="ats-tips">${a.bulletIdeas.map(b=>`<li>${escapeHtml(b)}</li>`).join('')}</ul>
    <p class="field-hint">Copy ideas into Experience only if they match real work you did.</p></div>`:''}
    ${a.summaryIdeas&&a.summaryIdeas.length?`<div class="suggest-from-job"><strong>Summary options</strong>${a.summaryIdeas.map(s=>`<button type="button" class="suggest-chip suggest-chip-full" data-action="use-summary-snippet" data-text="${escapeAttr(s)}">${escapeHtml(s)}</button>`).join('')}</div>`:''}
    <p class="guidance-note" style="margin-top:12px;">${escapeHtml(a.guidance||'')}</p>
  </div>
  <div class="ats-score-card">
    <div class="ats-score-head">
      <div>
        <div class="editor-panel-label" style="margin:0;">CV preparation checklist score</div>
        <p class="field-hint" style="margin:4px 0 0;">A local heuristic of completeness and keyword overlap — not a test against an employer ATS.</p>
      </div>
      <div class="ats-score-ring ${band}">${ats.score}</div>
    </div>
    <ul class="ats-tips">${(ats.tips||[]).map(t=>`<li class="${t.ok?'ok':''}">${escapeHtml(t.text)}</li>`).join('')}</ul>
  </div>`;
}

function renderCoverLetterPanel(){
  const c=state.coverLetter||{}, t=state.targeting||{};
  const tmpl=c.template||'classic';
  const templates=[
    {id:'classic',name:'Classic',desc:'Formal UK letter, matches Professional/Modern'},
    {id:'modern',name:'Modern',desc:'Clean short paragraphs, matches Modern templates'},
    {id:'compact',name:'Compact',desc:'Tight one-pager for trades & operational roles'},
    {id:'executive',name:'Executive',desc:'Formal tone for senior applications'}
  ];
  return `<div class="editor-panel-group">
    <div class="editor-panel-label">Cover letter</div>
    <p class="field-hint">Matched to your CV content and target role. Choose a letter style, generate, then edit before sending.</p>
    <div class="cover-tmpl-row">${templates.map(x=>`<button type="button" class="cover-tmpl-chip ${tmpl===x.id?'on':''}" data-action="set-cover-template" data-value="${x.id}"><strong>${escapeHtml(x.name)}</strong><br><span class="field-hint">${escapeHtml(x.desc)}</span></button>`).join('')}</div>
    <div class="field"><label>Employer</label><input type="text" data-cover-field="employer" value="${escapeAttr(c.employer||t.employer||'')}" placeholder="Company name"></div>
    <div class="field" style="margin-top:12px;"><label>Role</label><input type="text" data-cover-field="role" value="${escapeAttr(c.role||t.title||state.document.personalInfo.title||'')}" placeholder="Job title"></div>
    <div class="field" style="margin-top:12px;"><label>Opening detail <span class="opt">(optional)</span></label><input type="text" data-cover-field="opening" value="${escapeAttr(c.opening||'')}" placeholder="e.g. where you saw the role"></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;">
      <button class="btn btn-primary btn-sm" data-action="generate-cover-letter">Generate letter</button>
      <button class="btn btn-secondary btn-sm" data-action="download-cover-letter">Download .txt</button>
    </div>
    ${c.text?`<div class="cover-preview" style="margin-top:16px;">${escapeHtml(c.text)}</div>
    <div class="field" style="margin-top:12px;"><label>Edit letter</label><textarea data-cover-field="text" rows="14">${escapeHtml(c.text)}</textarea></div>`:'<p class="field-hint" style="margin-top:12px;">Generate a letter to preview it here. It pulls skills, experience, and job-match keywords when available.</p>'}
  </div>`;
}


function renderAdditionalSectionEditors(){
  const doc = state.document; const en = state.appearance.enabledSections;
  let html='';
  if(en.hobbies) html += `<div class="field" style="margin-top:12px;"><label>Hobbies & Interests</label><textarea rows="2" data-simple-field="hobbies">${escapeHtml(doc.hobbies)}</textarea></div>`;
  if(en.references) html += `<div class="field" style="margin-top:12px;"><label>References</label><textarea rows="2" data-simple-field="references">${escapeHtml(doc.references)}</textarea></div>`;
  if(en.languages){
    html += `<div class="control-row" style="margin-top:12px;"><label>Languages</label>${doc.languages.map(l=>`<div style="display:flex;gap:6px;margin-bottom:6px;"><input type="text" value="${escapeAttr(l.name)}" data-listf="languages" data-id="${l.id}" data-sub="name" style="flex:1;padding:7px 8px;border:1px solid var(--line);border-radius:4px;font-size:13px;" placeholder="Language"><input type="text" value="${escapeAttr(l.level)}" data-listf="languages" data-id="${l.id}" data-sub="level" style="flex:1;padding:7px 8px;border:1px solid var(--line);border-radius:4px;font-size:13px;" placeholder="Level"><button class="icon-btn" data-action="remove-list-item" data-list="languages" data-id="${l.id}">✕</button></div>`).join('')}<button class="btn btn-ghost btn-sm" data-action="add-list-item" data-list="languages">+ Add language</button></div>`;
  }
  if(en.certifications){
    html += `<div class="control-row" style="margin-top:12px;"><label>Certifications</label>${doc.certifications.map(c=>`<div style="display:flex;gap:6px;margin-bottom:6px;"><input type="text" value="${escapeAttr(c.name)}" data-listf="certifications" data-id="${c.id}" data-sub="name" style="flex:1;padding:7px 8px;border:1px solid var(--line);border-radius:4px;font-size:13px;" placeholder="Certification"><input type="text" value="${escapeAttr(c.issuer)}" data-listf="certifications" data-id="${c.id}" data-sub="issuer" style="flex:1;padding:7px 8px;border:1px solid var(--line);border-radius:4px;font-size:13px;" placeholder="Issuer"><button class="icon-btn" data-action="remove-list-item" data-list="certifications" data-id="${c.id}">✕</button></div>`).join('')}<button class="btn btn-ghost btn-sm" data-action="add-list-item" data-list="certifications">+ Add certification</button></div>`;
  }
  if(en.projects){
    html += `<div class="control-row" style="margin-top:12px;"><label>Projects</label>${doc.projects.map(pr=>`<div style="margin-bottom:8px;"><input type="text" value="${escapeAttr(pr.name)}" data-listf="projects" data-id="${pr.id}" data-sub="name" style="width:100%;margin-bottom:4px;padding:7px 8px;border:1px solid var(--line);border-radius:4px;font-size:13px;" placeholder="Project name"><textarea rows="2" data-listf="projects" data-id="${pr.id}" data-sub="description" style="width:100%;padding:7px 8px;border:1px solid var(--line);border-radius:4px;font-size:13px;" placeholder="What did you build?">${escapeHtml(pr.description||'')}</textarea><button class="icon-btn" data-action="remove-list-item" data-list="projects" data-id="${pr.id}" style="margin-top:4px;">✕ Remove</button></div>`).join('')}<button class="btn btn-ghost btn-sm" data-action="add-list-item" data-list="projects">+ Add project</button></div>`;
  }
  if(en.accomplishments){
    html += `<div class="achievement-guidance"><strong>For hands-on and trades roles</strong><span>Show the proof: what you did, what improved, and the result. Numbers, safety outcomes, time saved, quality, attendance, and customer feedback all count.</span></div><div class="control-row" style="margin-top:12px;"><label>Achievements</label>${doc.accomplishments.map(ac=>`<div class="achievement-editor"><div style="display:flex;gap:6px;margin-bottom:6px;"><input type="text" value="${escapeAttr(ac.category||'')}" data-listf="accomplishments" data-id="${ac.id}" data-sub="category" style="width:34%;padding:7px 8px;border:1px solid var(--line);border-radius:4px;font-size:13px;" placeholder="Area (e.g. Safety)"><input type="text" value="${escapeAttr(ac.impact||'')}" data-listf="accomplishments" data-id="${ac.id}" data-sub="impact" style="flex:1;padding:7px 8px;border:1px solid var(--line);border-radius:4px;font-size:13px;" placeholder="Result (e.g. zero incidents)"><button class="icon-btn" data-action="remove-list-item" data-list="accomplishments" data-id="${ac.id}">✕</button></div><input type="text" value="${escapeAttr(ac.text)}" data-listf="accomplishments" data-id="${ac.id}" data-sub="text" style="width:100%;padding:7px 8px;border:1px solid var(--line);border-radius:4px;font-size:13px;" placeholder="What did you do? e.g. Reorganised loading bay checks for a 12-person shift"></div>`).join('')}<button class="btn btn-ghost btn-sm" data-action="add-list-item" data-list="accomplishments">+ Add achievement</button></div>`;
  }
  return html;
}

function renderDesignPanel(){
  const a = state.appearance;
  return `
  <div class="editor-panel-group">
    <div class="editor-panel-label">Choose template</div>
    <p class="field-hint" style="margin-bottom:10px;">Switch any time — your content stays the same. Preview updates instantly.</p>
    <div class="tmpl-grid editor-tmpl-grid">${TEMPLATES.map(t=>`
      <button type="button" class="tmpl-card ${a.template===t.id?'selected':''}" data-action="pick-template" data-value="${t.id}">
        <div class="tmpl-thumb">${t.premium?'<span class="tmpl-badge">Signature</span>':''}${renderCVPreviewHTML(previewDocumentForTemplate(t.id), Object.assign({}, a, {template:t.id}), {mini:true, chrome:false})}</div>
        <div class="tmpl-meta"><div class="tmpl-name">${escapeHtml(t.name)}</div><div class="tmpl-tag">${escapeHtml(t.tag||'')}</div></div>
      </button>`).join('')}</div>
  </div>
  <div class="editor-panel-group">
    <div class="control-row"><label>Profile photo <span class="opt">(optional)</span></label>
      <div class="photo-upload-row">
        ${ledgerValidPhoto(state.document.personalInfo.photo)?`<img src="${escapeAttr(state.document.personalInfo.photo)}" alt="" />`:'<div style="width:56px;height:56px;border-radius:50%;background:#eee;"></div>'}
        <div>
          <input type="file" id="photoFileEditor" accept="image/jpeg,image/png,image/webp" style="font-size:12px;" />
          ${state.document.personalInfo.photo?`<button type="button" class="btn btn-ghost btn-sm" data-action="remove-photo">Remove</button>`:''}
        </div>
      </div>
    </div>
    <div class="control-row"><label>Accent colour</label>
      <div class="swatch-row">${ACCENT_COLORS.map(c=>`<button type="button" class="swatch ${a.color===c?'on':''}" style="background:${c};" aria-label="Use accent color ${c}" aria-pressed="${a.color===c}" data-action="pick-color" data-value="${c}"></button>`).join('')}</div>
    </div>
    <div class="control-row"><label>Font</label>
      <select class="font-select" id="designFont">${FONT_OPTIONS.map(f=>`<option value="${f.id}" ${a.font===f.id?'selected':''}>${f.label}</option>`).join('')}</select>
    </div>
    <div class="control-row"><label>Font size</label>
      <div class="seg-row">${['small','medium','large'].map(s=>`<button class="${a.fontSize===s?'on':''}" data-action="set-appearance" data-key="fontSize" data-value="${s}">${cap(s)}</button>`).join('')}</div>
    </div>
    <div class="control-row"><label>Spacing</label>
      <div class="seg-row">${['compact','standard','spacious'].map(s=>`<button class="${a.spacing===s?'on':''}" data-action="set-appearance" data-key="spacing" data-value="${s}">${cap(s)}</button>`).join('')}</div>
    </div>
    <div class="control-row"><label>Margins</label>
      <div class="seg-row">${['narrow','standard','wide'].map(s=>`<button class="${a.margins===s?'on':''}" data-action="set-appearance" data-key="margins" data-value="${s}">${cap(s)}</button>`).join('')}</div>
    </div>
  </div>
  <div class="editor-panel-group">
    <div class="editor-panel-label">Section order</div>
    <ul class="section-order-list" id="sectionOrderList">
      ${a.sectionOrder.filter(id=>SECTION_META[id].core || a.enabledSections[id]).map(id=>`<li class="section-order-item" draggable="true" data-order-id="${id}"><span class="drag-handle" aria-hidden="true">⠿</span><span class="ledger-order-label">${SECTION_META[id].label}</span><button type="button" class="ledger-order-btn" data-action="move-section" data-id="${id}" data-dir="up" aria-label="Move ${SECTION_META[id].label} up" ${a.sectionOrder.filter(k=>SECTION_META[k].core||a.enabledSections[k]).indexOf(id)===0?'disabled':''}>↑</button><button type="button" class="ledger-order-btn" data-action="move-section" data-id="${id}" data-dir="down" aria-label="Move ${SECTION_META[id].label} down" ${a.sectionOrder.filter(k=>SECTION_META[k].core||a.enabledSections[k]).slice(-1)[0]===id?'disabled':''}>↓</button></li>`).join('')}
    </ul>
  </div>`;
}
function cap(s){ return s.charAt(0).toUpperCase()+s.slice(1); }

/* ==========================================================================
   HTML ESCAPES
   ========================================================================== */
function escapeHtml(str){
  return String(str==null?'':str).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function escapeAttr(str){ return escapeHtml(str); }

/* ==========================================================================
   EVENT HANDLERS (delegated, attached after each render)
   ========================================================================== */
function attachDelegatedClicks(){
  // The editor lives in #app, but openModal() renders export controls in
  // #modalOverlay. Delegate from document so both surfaces share one action map.
  document.addEventListener('click', onAppClick);
}
function moveByIndex(list,index,direction){
  if(!Array.isArray(list)||!Number.isInteger(index))return;
  const to=index+(direction==='up'?-1:1);
  if(index<0||index>=list.length||to<0||to>=list.length)return;
  [list[index],list[to]]=[list[to],list[index]];
}
function moveVisibleSection(id,direction){
  const order=state.appearance.sectionOrder;
  const visible=order.filter(k=>SECTION_META[k]&&(SECTION_META[k].core||state.appearance.enabledSections[k]));
  const from=visible.indexOf(id),to=from+(direction==='up'?-1:1);
  if(from<0||to<0||to>=visible.length)return;
  const ai=order.indexOf(visible[from]),bi=order.indexOf(visible[to]);
  [order[ai],order[bi]]=[order[bi],order[ai]];
}
function confirmLedgerEntryDelete(kind,id){
 const list=kind==='education'?'education':'experience';
 const item=state.document[list].find(x=>x.id===id);if(!item)return;
 const label=list==='experience'?item.title||'this job':item.institution||'this qualification';
 openModal('<div class="modal-icon" aria-hidden="true">!</div><h2 class="modal-title">Remove this '+(list==='experience'?'job':'education')+'?</h2><p class="modal-sub">'+escapeHtml(label)+' will be removed from the current CV. You can also download a project backup before deleting.</p><div class="modal-options"><button type="button" class="btn btn-danger" data-action="confirm-delete-'+list+'" data-id="'+escapeAttr(id)+'">Yes, remove entry</button><button type="button" class="btn btn-secondary" data-action="export-project">Download backup first</button><button type="button" class="btn btn-ghost" data-action="modal-continue-editing">Keep entry</button></div>');
}
function performLedgerEntryDelete(list,id){
 if(list!=='experience'&&list!=='education')return;
 state.document[list]=state.document[list].filter(x=>x.id!==id);
 if(list==='experience'&&state.ui.editingExperienceId===id){state.ui.editingExperienceId=null;state.ui.draftBaseline=null;}
 if(list==='education'&&state.ui.editingEducationId===id){state.ui.editingEducationId=null;state.ui.draftBaseline=null;}
 saveState();closeModal();render();showToast('Entry removed from this CV');
}
function ledgerStorageTestMessage(title,body){
  openModal('<h2 class="modal-title">'+escapeHtml(title)+'</h2><p class="modal-sub">'+escapeHtml(body)+'</p><div class="modal-options"><button type="button" class="btn btn-primary" data-action="open-safety">Back to Data Safety</button><button type="button" class="btn btn-ghost" data-action="modal-continue-editing">Close</button></div>');
}
// The marker contains a CRC32 content fingerprint, never a user's CV text.
// This checks continuity of a specific locally saved project, not just storage
// of a trivial marker. CRC32 is not a signature, encryption, or security proof.
function ledgerSavedFingerprint(project){
  return ledgerBackupChecksum({content:ledgerStoredContentSnapshot(project)});
}
function ledgerStartStorageTest(){
  try{
    if(ledgerWriteIssue)throw new Error('Known save issue');
    const raw=localStorage.getItem(STORAGE_KEY);
    if(!raw||raw!==ledgerLastSavedRaw)throw new Error('Last save differs');
    const stored=ledgerDecodeState(raw);
    if(ledgerStoredContentSnapshot(stored)!==ledgerStoredContentSnapshot(state))throw new Error('CV has unsaved edits');
    const token=JSON.stringify({createdAt:Date.now(),random:uid(),version:2,fingerprint:ledgerSavedFingerprint(stored)});
    localStorage.setItem(LEDGER_STORAGE_TEST_KEY,token);
    if(localStorage.getItem(LEDGER_STORAGE_TEST_KEY)!==token)throw new Error('Marker write failed');
    ledgerStorageTestStartedThisSession=true;
    ledgerStorageTestMessage('CV persistence: first step passed','Your current CV and its saved browser copy matched, and a small content fingerprint was stored. Close this page, reopen the same Ledger HTML file in the same browser, then choose Data safety → Verify after reopening. Keep a separate JSON backup. This does not prove crash safety.');
  }catch(e){ledgerStorageTestMessage('CV persistence test blocked','This tab cannot confirm that its CV matches a readable browser save. If you have unsaved edits or a conflict, resolve them or download a JSON backup first.');}
}
function ledgerVerifyStorageTest(){
  try{
    const raw=localStorage.getItem(LEDGER_STORAGE_TEST_KEY);
    if(!raw){ledgerStorageTestMessage('No storage marker found','Start the CV persistence check, then close and reopen Ledger in the same browser. No retained marker was found.');return;}
    if(ledgerStorageTestStartedThisSession){ledgerStorageTestMessage('Reopen Ledger first','The first step ran in this page session. Close and reopen the application before verifying persistence.');return;}
    const marker=JSON.parse(raw);
    if(!marker||marker.version!==2||typeof marker.createdAt!=='number'||typeof marker.fingerprint!=='string'||!/^[0-9a-f]{8}$/.test(marker.fingerprint)){
      ledgerStorageTestMessage('Old or invalid marker','This marker is not compatible with the CV-content check. Start a fresh persistence check.');return;
    }
    if(ledgerWriteIssue)throw new Error('Save issue after reopen');
    const savedRaw=localStorage.getItem(STORAGE_KEY);
    if(!savedRaw)throw new Error('CV save missing');
    const stored=ledgerDecodeState(savedRaw);
    if(ledgerSavedFingerprint(stored)!==marker.fingerprint){
      ledgerStorageTestMessage('CV content changed after reopening','The saved CV no longer matches the fingerprint from step one. This may reflect another edit or a storage problem. The marker was kept for investigation; back up the current workspace.');return;
    }
    if(ledgerStoredContentSnapshot(stored)!==ledgerStoredContentSnapshot(state)){
      ledgerStorageTestMessage('Reopened CV differs from saved copy','The stored CV matches step one, but this tab has different content. Back up the current tab before editing further.');return;
    }
    localStorage.removeItem(LEDGER_STORAGE_TEST_KEY);
    ledgerStorageTestMessage('Reopen test passed','This browser returned the same saved CV content and matching diagnostic fingerprint in a newly opened page session. The marker was deleted. This is a local read-back/reopen check, not proof of crash safety, cross-tab atomicity or ATS accuracy. Keep external JSON backups.');
  }catch(e){ledgerStorageTestMessage('Could not verify saved CV','The CV data or marker could not be checked after reopening. Download a JSON backup; do not assume your work will persist.');}
}
// Read-only diagnostics: never replace, repair, or write a person's CV.
function ledgerStoredContentSnapshot(item){
  const core=x=>({id:x.id,name:x.name,document:x.document,appearance:x.appearance,targeting:x.targeting,coverLetter:x.coverLetter});
  return JSON.stringify({
    document:item.document,appearance:item.appearance,targeting:item.targeting,
    coverLetter:item.coverLetter,activeVersionId:item.activeVersionId,
    versions:(item.versions||[]).map(core)
  });
}
function ledgerInspectCurrentSave(){
  if(ledgerWriteIssue){
    ledgerInspectionMessage('Save verification needs attention','Ledger has reported a save or conflict problem. This check cannot establish that your edits are stored. Export a JSON backup before closing this tab.');
    return;
  }
  try{
    const raw=localStorage.getItem(STORAGE_KEY);
    if(!raw){ledgerInspectionMessage('No saved project found','This browser has no saved Ledger project. Start a CV and download a JSON backup.');return;}
    const stored=ledgerDecodeState(raw);
    const match=raw===ledgerLastSavedRaw && ledgerStoredContentSnapshot(stored)===ledgerStoredContentSnapshot(state);
    const label=match?'Current saved content matches':'Current edits do not match the last browser save';
    const size=new TextEncoder().encode(raw).byteLength;
    ledgerInspectionMessage(label,match
      ?('The browser returned a readable project containing '+(stored.versions||[]).length+' CV version(s), and its CV content matches this tab. Stored size: '+(size/1024).toFixed(1)+' KiB. This is only a read-back check, not proof of persistence after closing the browser, crash recovery, or multi-tab safety.')
      :'The browser returned a different project or content than this tab. Do not close this tab before downloading a JSON backup and investigating the save warning.');
  }catch(e){
    ledgerInspectionMessage('Unable to verify saved content','The stored project could not be read and checked. Your current tab has not been modified. Download a JSON backup now.');
  }
}
function ledgerInspectionMessage(title,body){
  openModal('<h2 class="modal-title">'+escapeHtml(title)+'</h2><p class="modal-sub">'+escapeHtml(body)+'</p><div class="modal-options"><button type="button" class="btn btn-primary" data-action="open-safety">Return to Data Safety</button><button type="button" class="btn btn-ghost" data-action="modal-continue-editing">Close</button></div>');
}
function ledgerBackupInspection(data){
  const integrity=ledgerVerifyBackupIntegrity(data);
  // Run the same strict structural validation as actual imports, without changing state.
  const verified=validateLedgerBackup(data);
  if(!verified)throw new Error('The file is not a valid Ledger project backup');
  const all=verified.versions.length?verified.versions:[{name:'Single CV project'}];
  return {integrity,count:all.length,names:all.map(x=>cleanVersionName(x.name)),schema:data.schema||'Legacy / not specified'};
}
function ledgerInspectBackupFile(file){
  if(!file)return;
  if(!/\.json$/i.test(file.name||'')){
    ledgerInspectionMessage('Choose a JSON project backup','This inspector only accepts Ledger JSON backups. It does not import the file or alter your workspace.');return;
  }
  if(file.size>36*1024*1024){ledgerInspectionMessage('Backup is too large','The 36 MiB JSON project limit was exceeded. Your current CVs have not changed.');return;}
  const reader=new FileReader();
  reader.onerror=()=>ledgerInspectionMessage('Could not read backup','The selected file could not be read; your active workspace was not changed.');
  reader.onload=()=>{
    try{
      const details=ledgerBackupInspection(JSON.parse(reader.result));
      const verified=details.integrity==='verified';
      const cvList=details.names.map((name,i)=>'<li>'+escapeHtml(name)+'</li>').join('');
      openModal('<h2 class="modal-title">Backup inspection complete</h2><p class="modal-sub">Read-only inspection. No CV was imported or replaced.</p><div class="ledger-backup-inspection" role="status"><p><strong>CV versions:</strong> '+details.count+'</p><p><strong>Format schema:</strong> '+escapeHtml(String(details.schema))+'</p><p><strong>Integrity:</strong> '+(verified?'CRC32 check passed — detects accidental changes, not tampering':'Legacy backup without checksum — structure checked only')+'</p><div class="ledger-inspection-names"><strong>CV names in backup</strong><ul>'+cvList+'</ul></div></div><p class="field-hint">This does not guarantee the CV content is accurate, secure, or compatible with an ATS. Importing later still requires the normal restore confirmation.</p><div class="modal-options"><button type="button" class="btn btn-primary" data-action="go-upload">Go to import screen</button><button type="button" class="btn btn-secondary" data-action="open-safety">Back to Data Safety</button><button type="button" class="btn btn-ghost" data-action="modal-continue-editing">Close</button></div>');
    }catch(e){
      const reason=e&&e.message&&/integrity|exceeds|Too many|Invalid|invalid|length|format|section|field|entries/i.test(e.message)?e.message:'This JSON file was not a valid Ledger project backup.';
      ledgerInspectionMessage('Backup inspection failed',reason+' No CVs were changed.');
    }
  };
  reader.readAsText(file);
}
function ledgerChooseBackupToInspect(){
  const input=document.createElement('input');
  input.type='file';input.accept='.json,application/json';input.hidden=true;
  document.body.appendChild(input);
  input.addEventListener('change',()=>{const file=input.files&&input.files[0];input.remove();if(file)ledgerInspectBackupFile(file);},{once:true});
  input.click();
}
function openSafetyPanel(){
  const healthy=!ledgerWriteIssue;
  let marker=false;
  try{marker=!!localStorage.getItem(LEDGER_STORAGE_TEST_KEY);}catch(ignore){}
  openModal('<div class="modal-icon" aria-hidden="true">♢</div><h2 class="modal-title">Data Safety &amp; Backups</h2><p class="modal-sub">'+(healthy?'Ledger can check its saved browser copy, but local data can be cleared by the browser or device. Keep a downloaded JSON backup.':'Local save needs your attention. Back up this tab now before closing it.')+'</p><div class="modal-options"><button class="btn btn-primary" data-action="export-project">Download full JSON project backup</button><button class="btn btn-secondary" data-action="go-upload">Import CV or JSON project</button><button class="btn btn-secondary" data-action="inspect-current-save">Verify current browser save (read only)</button><button class="btn btn-secondary" data-action="inspect-backup">Inspect a JSON backup (read only)</button><button class="btn btn-secondary" data-action="storage-test-start">Check CV persistence across reopening</button>'+(marker?'<button class="btn btn-secondary" data-action="storage-test-verify">Verify after reopening</button>':'')+(ledgerWriteIssue==='corrupt'?'<button class="btn btn-secondary" data-action="recover-storage">Recovery options</button>':'')+(ledgerWriteIssue==='conflict'?'<button class="btn btn-secondary" data-action="reload-storage">Compare other tab’s save</button>':'')+'<button class="btn btn-ghost" data-action="modal-continue-editing">Close</button></div><p class="field-hint" style="margin-top:14px">Offline Word, HTML and JSON exports work without an account. PDF file import requires an optional online parser. The storage test is local and does not certify crash recovery.</p>');
}
function runLedgerAction(el){
  if(!el) return;
  const action = el.dataset.action;
  const handlers = {
    'ledger-undo': ()=>ledgerTravelHistory('undo'),
    'ledger-redo': ()=>ledgerTravelHistory('redo'),
    'go-home': ()=>goto('home'),
    'go-upload': ()=>{ closeModal();state.upload={status:'idle', filename:''}; goto('upload'); },
    'start-create': ()=>ledgerStartManualCV(),
    'continue-editor': ()=>goto('editor'),
    'try-demo': ()=>openDemoCv(),
    'start-guided-interview': ()=>startOfflineAgent(),
    'scroll-to': ()=>{ const t=document.getElementById(el.dataset.target); if(t) t.scrollIntoView({behavior:'smooth'}); },
    'toggle-faq': ()=>{ el.closest('.faq-item').classList.toggle('open'); },
    'upload-simulate': ()=>{ const input=document.getElementById('importFile'); if(input) input.click(); },
    'upload-continue': ()=>{ if(state.upload.importedDocument) state.document=state.upload.importedDocument; saveState(); goto('personal-info'); },
    'analyze-target': ()=>analyzeTargetFromUI(),
    'generate-cover-letter': ()=>generateCoverLetterFromUI(),
    'download-cover-letter': ()=>downloadCoverLetter(),
    'add-target-skill': ()=>{ addSkill(el.dataset.value); },
    'export-project': ()=>downloadProjectBackup(),
    'open-safety': ()=>openSafetyPanel(),
    'inspect-current-save': ()=>ledgerInspectCurrentSave(),
    'inspect-backup': ()=>ledgerChooseBackupToInspect(),
    'storage-test-start': ()=>ledgerStartStorageTest(),
    'storage-test-verify': ()=>ledgerVerifyStorageTest(),
    'retry-storage': ()=>retryLedgerSave(),
    'reload-storage': ()=>loadLatestFromStorage(),
    'confirm-conflict-load': ()=>ledgerConfirmConflictLoad(),
    'cancel-conflict-load': ()=>ledgerCancelConflictLoad(),
    'recover-storage': ()=>recoverStorage(),
    'download-damaged': ()=>downloadDamagedStorage(),
    'replace-damaged': ()=>replaceDamagedStorage(),
    'confirm-project-restore': ()=>ledgerConfirmProjectRestore(),
    'cancel-project-restore': ()=>ledgerCancelProjectRestore(),
    'import-project': ()=>{ const input=document.getElementById('projectFileInput'); if(input) input.click(); },
    'wizard-back': ()=>goto(el.dataset.prev),
    'wizard-next': ()=>handleWizardNext(el.dataset.next),
    'pick-experience-level': ()=>{ state.experienceLevel=el.dataset.value; saveState(); render(); },
    'pick-template': ()=>{
      const id=el.dataset.value;
      state.appearance.template=id;
      const spec=TEMPLATES.find(t=>t.id===id);
      if(spec&&spec.color) state.appearance.color=spec.color;
      saveState(); render();
      showToast('Template switched to '+(spec?spec.name:id)+' — your content was preserved');
    },
    'pick-template-final': ()=>{
      const id=el.dataset.value;
      state.appearance.template=id;
      const spec=TEMPLATES.find(t=>t.id===id);
      if(spec&&spec.color) state.appearance.color=spec.color;
      saveState(); showToast('Template set to '+(spec?spec.name:id)); openDownloadModal();
    },
    'pick-color': ()=>{ state.appearance.color=el.dataset.value; saveState(); render(); },
    'interview-next': ()=>interviewAdvance(),
    'interview-back': ()=>{ interviewFieldValues(); const i=state.interview, idx=INTERVIEW_STEPS.indexOf(i.step); if(idx<=0){goto('home');return;} if(i.step==='skills') i.step='education'; else if(i.step==='education'&&i.experienceLevel==='No experience yet') i.step='level'; else i.step=INTERVIEW_STEPS[idx-1]; saveState(); render(); },
    'interview-toggle': ()=>{ const field=el.dataset.field, value=el.dataset.value, arr=state.interview[field]; if(Array.isArray(arr)){state.interview[field]=arr.includes(value)?arr.filter(x=>x!==value):arr.concat(value);} else state.interview[field]=value; saveState(); render(); },
    'interview-edit': ()=>{ state.interview.step='skills'; saveState(); render(); },
    'interview-finish': ()=>interviewFinish(),
    'agent-send': ()=>agentSubmit(),
    'agent-quick': ()=>agentSubmit(el.dataset.value||''),
    'agent-build-cv': ()=>agentBuildCv(),
    'agent-start-over': ()=>startOfflineAgent(),
    'add-experience': ()=>{
      const nw={id:uid(),title:'',employer:'',location:'',start:'',end:'',current:false,description:''};
      state.document.experience.push(nw); state.ui.editingExperienceId=nw.id;state.ui.draftBaseline={kind:'experience',id:nw.id,original:null};state.ui.activeDraftDescription='';saveState(); render();
    },
    'edit-experience': ()=>{ const ex=state.document.experience.find(x=>x.id===el.dataset.id);if(!ex)return;state.ui.editingExperienceId=el.dataset.id;state.ui.draftBaseline={kind:'experience',id:ex.id,original:cloneDocument(ex)};state.ui.activeDraftDescription=stripHtmlForEdit(ex.description);saveState();render(); },
    'cancel-experience-edit': ()=>{
      const b=state.ui.draftBaseline;
      if(b&&b.kind==='experience'&&b.id===state.ui.editingExperienceId){
        if(b.original){const i=state.document.experience.findIndex(x=>x.id===b.id);if(i>=0)state.document.experience[i]=b.original;}
        else state.document.experience=state.document.experience.filter(x=>x.id!==b.id);
      }
      state.ui.editingExperienceId=null;state.ui.draftBaseline=null;state.ui.activeDraftDescription=null;saveState();render();
    },
    'save-experience': ()=>{
      const card = document.querySelector('[data-exp-edit="'+el.dataset.id+'"]');
      const ex = state.document.experience.find(x=>x.id===el.dataset.id);
      if(card && ex){
        ex.title = card.querySelector('[data-exf=title]').value.trim();
        ex.employer = card.querySelector('[data-exf=employer]').value.trim();
        ex.location = card.querySelector('[data-exf=location]').value.trim();
        ex.start = card.querySelector('[data-exf=start]').value;
        ex.current = card.querySelector('[data-exf=current]').checked;
        ex.end = ex.current ? '' : card.querySelector('[data-exf=end]').value;
        ex.description = textToBulletsHtml(card.querySelector('[data-exf=description]').value);
      }
      state.ui.editingExperienceId=null;state.ui.draftBaseline=null;state.ui.activeDraftDescription=null;saveState();render();
    },
    'delete-experience': ()=>confirmLedgerEntryDelete('experience',el.dataset.id),
    'confirm-delete-experience': ()=>performLedgerEntryDelete('experience',el.dataset.id),
    'move-skill': ()=>{const idx=Number(el.dataset.index),dir=el.dataset.dir;moveByIndex(state.document.skills,idx,dir);saveState();render();const target=Array.from(document.querySelectorAll('[data-action="move-skill"]')).find(x=>Number(x.dataset.index)===idx+(dir==='up'?-1:1)&&x.dataset.dir===dir);if(target)target.focus();},
    'move-section': ()=>{const id=el.dataset.id,dir=el.dataset.dir;moveVisibleSection(id,dir);saveState();render();const target=Array.from(document.querySelectorAll('[data-action="move-section"]')).find(x=>x.dataset.id===id&&x.dataset.dir===dir);if(target)target.focus();},
    'move-experience': ()=>{ moveInArray(state.document.experience, el.dataset.id, el.dataset.dir); saveState(); render(); },
    'insert-bullet': ()=>{
      const card = document.querySelector('[data-exp-edit="'+el.dataset.exp+'"]');
      if(card){ const ta=card.querySelector('[data-exf=description]'); ta.value = (ta.value? ta.value+'\n':'') + el.dataset.text; ta.dispatchEvent(new Event('input',{bubbles:true})); ta.focus(); showToast('Example inserted as a draft — verify every claim before applying'); }
    },
    'add-education': ()=>{
      const nw={id:uid(),institution:'',location:'',qualification:'',field:'',start:'',end:'',current:false};
      state.document.education.push(nw); state.ui.editingEducationId=nw.id;state.ui.draftBaseline={kind:'education',id:nw.id,original:null};saveState();render();
    },
    'edit-education': ()=>{const ed=state.document.education.find(x=>x.id===el.dataset.id);if(!ed)return;state.ui.editingEducationId=el.dataset.id;state.ui.draftBaseline={kind:'education',id:ed.id,original:cloneDocument(ed)};saveState();render();},
    'cancel-education-edit': ()=>{
      const b=state.ui.draftBaseline;
      if(b&&b.kind==='education'&&b.id===state.ui.editingEducationId){
        if(b.original){const i=state.document.education.findIndex(x=>x.id===b.id);if(i>=0)state.document.education[i]=b.original;}
        else state.document.education=state.document.education.filter(x=>x.id!==b.id);
      }
      state.ui.editingEducationId=null;state.ui.draftBaseline=null;saveState();render();
    },
    'save-education': ()=>{
      const card = document.querySelector('[data-edu-edit="'+el.dataset.id+'"]');
      const ed = state.document.education.find(x=>x.id===el.dataset.id);
      if(card && ed){
        ed.institution = card.querySelector('[data-eduf=institution]').value.trim();
        ed.location = card.querySelector('[data-eduf=location]').value.trim();
        ed.qualification = card.querySelector('[data-eduf=qualification]').value.trim();
        ed.field = card.querySelector('[data-eduf=field]').value.trim();
        ed.start = card.querySelector('[data-eduf=start]').value;
        ed.current = card.querySelector('[data-eduf=current]').checked;
        ed.end = ed.current ? '' : card.querySelector('[data-eduf=end]').value;
      }
      state.ui.editingEducationId=null;state.ui.draftBaseline=null;saveState();render();
    },
    'delete-education': ()=>confirmLedgerEntryDelete('education',el.dataset.id),
    'confirm-delete-education': ()=>performLedgerEntryDelete('education',el.dataset.id),
    'move-education': ()=>{ moveInArray(state.document.education, el.dataset.id, el.dataset.dir); saveState(); render(); },
    'add-skill-from-input': ()=>addSkillFromInput(),
    'add-suggested-skill': ()=>{ addSkill(el.dataset.value); },
    'remove-skill': ()=>{ state.document.skills.splice(parseInt(el.dataset.index,10),1); saveState(); render(); },
    'set-skill-level': ()=>{ state.document.skills[parseInt(el.dataset.index,10)].level = parseInt(el.dataset.level,10); saveState(); render(); },
    'generate-summary': ()=>{
      const title = state.document.personalInfo.title || 'professional';
      const suggestions = cvEngine.getSummarySuggestions(title);
      const snippet = suggestions[Math.floor(Math.random()*suggestions.length)].replace('{title}', title);
      showToast('Draft an authentic summary from your own facts; suggestions are examples only.');
    },
    'use-summary-snippet': ()=>{ state.document.summary = el.dataset.text; saveState(); render(); },
    'toggle-section': ()=>{ const id=el.dataset.id; state.appearance.enabledSections[id]=!state.appearance.enabledSections[id]; saveState(); render(); },
    'add-custom-section': ()=>{ state.document.customSections.push({id:uid(),title:'New Section',content:''}); saveState(); render(); },
    'delete-custom-section': ()=>{ state.document.customSections = state.document.customSections.filter(c=>c.id!==el.dataset.id); saveState(); render(); },
    'open-download': ()=>{ try{ openDownloadModal(); }catch(err){ console.error('Ledger export error',err); showToast('Could not open export options. Please try again.'); } },
    'editor-view': ()=>{ state.ui.editorView = el.dataset.value; saveState(); render(); },
    'editor-panel': ()=>{ state.ui.editorPanel = el.dataset.value; saveState(); render(); ledgerFocusEditorPanel(); },
    'fix-review': ()=>{state.ui.editorPanel=el.dataset.panel; state.ui.editorView='edit';saveState();render();ledgerFocusEditorPanel();},
    'review-from-export': ()=>{closeModal();state.ui.editorPanel='review';state.ui.editorView='edit';saveState();render();ledgerFocusEditorPanel();},
    'preview-format': ()=>{ state.ui.previewMode=el.dataset.value==='design'?'design':'application'; saveState(); refreshEditorPreviewOnly(); },
    'preview-reading': ()=>{state.ui.previewReading=el.dataset.value==='read';saveState();refreshEditorPreviewOnly();},
    'set-appearance': ()=>{ state.appearance[el.dataset.key]=el.dataset.value; saveState(); render(); },
    'add-list-item': ()=>{ addListItem(el.dataset.list); },
    'remove-list-item': ()=>{ removeListItem(el.dataset.list, el.dataset.id); },
    'print-text-pdf': ()=>printTextPdf(),
    'download-html': ()=>downloadHtmlCv(),
    'new-version': ()=>createVersion(true),
    'duplicate-version': ()=>createVersion(false),
    'duplicate-master': ()=>ledgerDuplicateMaster(),
    'make-master': ()=>ledgerMakeMaster(),
    'switch-version': ()=>switchVersion(el.dataset.id),
    'delete-version': ()=>deleteVersion(el.dataset.id),
    'confirm-delete-version': ()=>confirmDeleteVersion(el.dataset.id),
    'rename-version': ()=>{const v=state.versions.find(x=>x.id===state.activeVersionId), input=document.getElementById('ledgerVersionRename'); if(v&&input){v.name=cleanVersionName(input.value);saveState();render();showToast('CV renamed');}},
    'download-word': ()=>downloadDocx(),
    'modal-continue-editing': ()=>closeModal(),
  };
  if(handlers[action]) handlers[action]();
}
function onAppClick(e){
  const target=e.target;
  const el=target && target.closest ? target.closest('[data-action]') : null;
  if(el) runLedgerAction(el);
}

function handleWizardNext(next){
  // very light validation on personal info
  if(state.screen==='personal-info'){
    const p = state.document.personalInfo;
    if(!String(p.firstName||'').trim() || !String(p.lastName||'').trim() || (!String(p.email||'').trim()&&!String(p.phone||'').trim()) || (String(p.email||'').trim()&&!ledgerEmailValid(p.email))){
      const missing = [];
      if(!String(p.firstName||'').trim()) missing.push('firstName');
      if(!String(p.lastName||'').trim()) missing.push('lastName');
      if(!String(p.email||'').trim()&&!String(p.phone||'').trim()) missing.push('phone');
      if(String(p.email||'').trim()&&!ledgerEmailValid(p.email))missing.push('email');
      missing.forEach(f=>{ const fe=document.querySelector('[data-field="'+f+'"]'); if(fe) fe.classList.add('error'); });
      showToast('Add your name and a reachable email or phone number. Check the email format if provided.');
      return;
    }
  }
  goto(next);
}

function moveInArray(arr, id, dir){
  const i = arr.findIndex(x=>x.id===id);
  if(i<0) return;
  const j = dir==='up'? i-1 : i+1;
  if(j<0 || j>=arr.length) return;
  [arr[i],arr[j]] = [arr[j],arr[i]];
}

function addSkillFromInput(){
  const inp = document.getElementById('skillInput');
  if(!inp) return;
  addSkill(inp.value);
  inp.value='';
}
function addSkill(name){
  name = (name||'').trim();
  if(!name) return;
  if(state.document.skills.find(s=>s.name.toLowerCase()===name.toLowerCase())) return;
  state.document.skills.push({name, level:3});
  saveState(); render();
  const inp=document.getElementById('skillInput'); if(inp) inp.focus();
}

function addListItem(list){
  const doc = state.document;
  if(list==='languages') doc.languages.push({id:uid(), name:'', level:''});
  if(list==='certifications') doc.certifications.push({id:uid(), name:'', issuer:'', year:''});
  if(list==='projects') doc.projects.push({id:uid(), name:'', description:''});
  if(list==='accomplishments') doc.accomplishments.push({id:uid(), text:'', category:'', impact:''});
  saveState(); render();
}
function removeListItem(list, id){
  state.document[list] = state.document[list].filter(x=>x.id!==id);
  saveState(); render();
}

function wirePhotoUpload(){
  ['photoFile','photoFileEditor'].forEach(function(id){
    const input=document.getElementById(id);
    if(!input || input.dataset.wired) return;
    input.dataset.wired='1';
    input.addEventListener('change', function(){
      const file=input.files&&input.files[0];
      if(!file) return;
      if(file.size>2.5*1024*1024){ showToast('Photo must be under 2.5MB'); return; }
      const reader=new FileReader();
      reader.onload=function(){
        // Resize via canvas for smaller storage
        const img=new Image();
        img.onload=function(){
          const max=400; let w=img.width, h=img.height;
          if(w>max||h>max){ const r=Math.min(max/w,max/h); w=Math.round(w*r); h=Math.round(h*r); }
          const canvas=document.createElement('canvas');
          canvas.width=w; canvas.height=h;
          canvas.getContext('2d').drawImage(img,0,0,w,h);
          state.document.personalInfo.photo=canvas.toDataURL('image/jpeg',0.85);
          saveState(); render(); showToast('Photo added');
        };
        img.src=reader.result;
      };
      reader.readAsDataURL(file);
    });
  });
}

function validateLedgerDocument(raw){
  if(!raw||typeof raw!=='object'||Array.isArray(raw))return null;
  const base=defaultState().document,out=JSON.parse(JSON.stringify(base));
  // Reject malformed or oversized fields rather than silently deleting portions
  // of an imported person's career history. Absent legacy fields remain optional.
  const trunc=(v,max=8000)=>{
    if(v===null || v===undefined)return '';
    if(typeof v!=='string')throw new Error('A CV field has an invalid text type; import not applied');
    if(v.length>max)throw new Error('A CV field exceeds the supported length; import not applied');
    return v;
  };
  if(raw.personalInfo!==undefined && !ledgerPlainObject(raw.personalInfo))throw new Error('Invalid personal details in backup');
  for(const key of ['experience','education','skills','languages','certifications','projects','accomplishments','customSections']){
    if(raw[key]!==undefined && !Array.isArray(raw[key]))throw new Error('Invalid '+key+' section in backup');
    if(Array.isArray(raw[key]) && (raw[key].length>100 || raw[key].some(x=>!ledgerPlainObject(x))))throw new Error('Too many or invalid '+key+' entries; import not applied');
  }
  const personal=raw.personalInfo;
  if(personal&&typeof personal==='object'&&!Array.isArray(personal)){
    for(const k of Object.keys(base.personalInfo))out.personalInfo[k]=trunc(personal[k],k==='photo'?2400000:250);
    if(!ledgerValidPhoto(out.personalInfo.photo))out.personalInfo.photo='';
  }
  out.summary=trunc(raw.summary,8000);
  for(const [key,fields] of Object.entries({
    experience:['id','title','employer','location','start','end','description'],
    education:['id','institution','location','qualification','field','start','end'],
    skills:['name'],languages:['id','name','level'],
    certifications:['id','name','issuer','year'],projects:['id','name','description'],
    accomplishments:['id','category','text','impact'],customSections:['id','title','content']
  })){
    if(!Array.isArray(raw[key]))continue;
    out[key]=raw[key].map(item=>{
      const obj={};fields.forEach(field=>obj[field]=trunc(item[field],field==='description'||field==='content'?12000:300));
      if(['experience','education'].includes(key))obj.current=item.current===true;
      if(key==='skills')obj.level=Number.isFinite(item.level)?Math.max(1,Math.min(5,item.level)):3;
      if('id' in obj&&!/^[A-Za-z0-9_-]{1,64}$/.test(obj.id))obj.id=uid();return obj;
    });
  }
  ['hobbies','references'].forEach(k=>out[k]=trunc(raw[k],3000));
  return out;
}
function validateLedgerBackup(raw){
  if(!raw||typeof raw!=='object'||Array.isArray(raw)||!raw.document)return null;
  ledgerVerifyBackupIntegrity(raw);
  const base=defaultState(), doc=validateLedgerDocument(raw.document);
  if(!doc)return null;
  base.document=doc;
  base.appearance=ledgerSafeAppearance(raw.appearance);
  // Preserve editable job-targeting and cover-letter prose exactly;
  // fail visibly rather than silently cutting off long imported writing.
  for(const key of ['targeting','coverLetter'])if(raw[key]!==undefined){
    if(!ledgerPlainObject(raw[key]))throw new Error('Invalid '+key+' section in backup');
    for(const k of Object.keys(base[key])){
      if(typeof base[key][k]!=='string')continue;
      const value=raw[key][k];
      if(value===null || value===undefined)continue;
      if(typeof value!=='string')throw new Error('A '+key+' field has an invalid text type; import not applied');
      if(value.length>30000)throw new Error('A '+key+' field exceeds the supported length; import not applied');
      base[key][k]=value;
    }
  }
  if(Array.isArray(raw.versions)){
    if(raw.versions.length>12)throw new Error('This backup contains more than 12 CV versions. It was not imported or truncated.');
    base.versions=raw.versions.map(v=>{
      if(!ledgerPlainObject(v)||!v.document)throw new Error('Invalid CV version in backup');
      const safe=validateLedgerBackup({document:v.document,appearance:v.appearance,targeting:v.targeting,coverLetter:v.coverLetter});
      if(!safe)throw new Error('Invalid CV version structure');
      return Object.assign({id:uid(),name:cleanVersionName(v.name),updatedAt:new Date().toISOString()},versionSnapshotFromValidated(safe));
    });
    if(base.versions.length){
      // Prefer the saved active version by position; identifiers are regenerated.
      const idx=raw.versions.findIndex(v=>v.id===raw.activeVersionId);
      base.activeVersionId=base.versions[Math.max(0,Math.min(idx,base.versions.length-1))].id;
      const active=base.versions.find(v=>v.id===base.activeVersionId);
      for(const key of ['document','appearance','targeting','coverLetter'])base[key]=JSON.parse(JSON.stringify(active[key]));
    }
  }
  base.screen='editor';base.ui.editorPanel='versions';return base;
}
// CRC32 detects accidental backup corruption; it is NOT a signature and does
// not protect against intentional modification. The format remains plain JSON.
const LEDGER_CRC32_TABLE=(()=>{
  const a=new Uint32Array(256);
  for(let n=0;n<256;n++){
    let c=n;
    for(let b=0;b<8;b++)c=(c&1)?(0xEDB88320^(c>>>1)):(c>>>1);
    a[n]=c>>>0;
  }
  return a;
})();
function ledgerBackupChecksum(project){
  const clone={...project};delete clone.integrity;
  const bytes=new TextEncoder().encode(JSON.stringify(clone));
  let crc=0xFFFFFFFF;
  for(const byte of bytes)crc=LEDGER_CRC32_TABLE[(crc^byte)&255]^(crc>>>8);
  return ((crc^0xFFFFFFFF)>>>0).toString(16).padStart(8,'0');
}
function ledgerVerifyBackupIntegrity(project){
  if(!Object.prototype.hasOwnProperty.call(project,'integrity'))return 'legacy';
  const v=project.integrity;
  if(!ledgerPlainObject(v)||v.algorithm!=='CRC32'||typeof v.value!=='string'||!/^[0-9a-f]{8}$/.test(v.value)||v.value!==ledgerBackupChecksum(project)){
    throw new Error('Backup integrity check failed — no CVs were replaced');
  }
  return 'verified';
}
function ledgerPrepareProjectBackup(){
  syncActiveVersion();
  const project={format:'ledger-project',schema:4,exportedAt:new Date().toISOString(),...state};
  project.integrity={algorithm:'CRC32',value:ledgerBackupChecksum(project)};
  return JSON.stringify(project,null,2);
}
function versionSnapshotFromValidated(s){
  return {document:s.document,appearance:s.appearance,targeting:s.targeting,coverLetter:s.coverLetter};
}

let ledgerPendingProjectRestore=null;
function ledgerStageProjectRestore(incoming){
 // Snapshot the *entire* workspace after the upload-status housekeeping save.
 // Confirmation must be invalidated if someone edits this tab or another tab
 // changes the saved version while the comparison is displayed.
 ledgerPendingProjectRestore={incoming,
   content:ledgerStoredContentSnapshot(state),savedRaw:ledgerLastSavedRaw};
}
function ledgerRestoreSummary(incoming){
  const count=x=>Array.isArray(x.versions)&&x.versions.length?x.versions.length:1;
  const activeName=x=>{
    const active=(x.versions||[]).find(v=>v.id===x.activeVersionId);
    return active?cleanVersionName(active.name):cleanVersionName(((x.document||{}).personalInfo||{}).title||'Untitled CV');
  };
  return '<div class="ledger-restore-compare" aria-label="Project restore comparison">'+
    '<p><strong>Current workspace:</strong> '+count(state)+' CV(s) · Active: '+escapeHtml(activeName(state))+'</p>'+
    '<p><strong>Incoming backup:</strong> '+count(incoming)+' CV(s) · Active: '+escapeHtml(activeName(incoming))+'</p>'+
    '<p class="field-hint">Replacing removes the current browser workspace; it does not merge CVs. Back up your current work first.</p></div>';
}
function ledgerConfirmProjectRestore(){
 const pending=ledgerPendingProjectRestore;
 if(!pending)return false;
 // Refuse changed tab contents and intervening storage updates before swapping
 // the in-memory workspace. localStorage still lacks an atomic CAS operation.
 if(ledgerStoredContentSnapshot(state)!==pending.content ||
    ledgerLastSavedRaw!==pending.savedRaw || ledgerWriteIssue){
   ledgerPendingProjectRestore=null;
   ledgerInspectionMessage('Restore review is out of date',
     'This workspace changed after the comparison, or Ledger detected a save problem. Nothing was replaced. Back up current work and inspect the backup again.');
   return false;
 }
 let latest;
 try{latest=localStorage.getItem(STORAGE_KEY);}
 catch(e){ledgerPendingProjectRestore=null;markSaveIssue('unavailable');
   ledgerInspectionMessage('Storage unavailable','The backup was not restored. Download the current workspace as JSON and resolve browser storage access.');return false;}
 if(latest!==pending.savedRaw){
   ledgerPendingProjectRestore=null;markSaveIssue('conflict');
   ledgerInspectionMessage('Saved workspace changed during review',
     'Another tab updated the browser save after this restore was prepared. Nothing was replaced. Back up this tab and resolve the conflict first.');
   return false;
 }
 const original=state;
 state=pending.incoming;ensureVersions();
 const saved=saveState();
 if(!saved){
   state=original;
   if(ledgerWriteIssue)markSaveIssue(ledgerWriteIssue);
   // Retain the reviewed import for an explicit retry after saving is fixed;
   // its original workspace fingerprint must still match at retry time.
   closeModal();
   showToast('Restore not applied. Current workspace kept — resolve storage warning and retry.');
   return false;
 }
 ledgerPendingProjectRestore=null;
 closeModal();goto('editor');
 showToast('Ledger project restored — review content');
 return true;
}
function ledgerCancelProjectRestore(){
 ledgerPendingProjectRestore=null;state.upload={status:'idle',filename:''};saveState();closeModal();render();
}
let ledgerImportGeneration=0;
function importCvFile(file){
  if(!file) return;
  const generation=++ledgerImportGeneration;
  const name=(file.name||'').toLowerCase();
  const sizeLimit=name.endsWith('.json')?36*1024*1024:8*1024*1024;
  if(file.size>sizeLimit){ showToast(name.endsWith('.json')?'JSON backup exceeds the 36 MB limit — no data changed':'File too large (8 MB limit). Use a smaller TXT, PDF or DOCX.');return; }
  if(/\.doc$/i.test(file.name)){showToast('Legacy .doc binary files are not supported. Save as DOCX or TXT first.');return;}
  state.upload={status:'analysing',filename:file.name}; saveState(); render();
  const initialContent=ledgerStoredContentSnapshot(state);
  const isCurrent=()=>generation===ledgerImportGeneration &&
    ledgerStoredContentSnapshot(state)===initialContent;
  const stale=()=>{
    if(generation!==ledgerImportGeneration)return;
    state.upload={status:'idle',filename:''};saveState();render();
    showToast('Import cancelled: this CV changed while the file was loading. Reimport if needed.');
  };
  const done=function(doc){
    if(!isCurrent()){stale();return;}
    if(!doc){ state.upload={status:'idle',filename:''}; saveState(); render(); showToast('Could not read that file.'); return; }
    // Import into a fresh version so an existing CV is never overwritten.
    if(!ledgerPrepareNewCV())return;
    const base=defaultState().document;
    state.document=Object.assign(base, doc, {
      personalInfo:Object.assign({}, base.personalInfo, doc.personalInfo||{}),
      skills:doc.skills||[], experience:doc.experience||[], education:doc.education||[]
    });
    state.upload={status:'idle',filename:''};
    state.screen='editor';
    state.ui.editorPanel='summary';
    saveState(); render();
    showToast('CV imported — review every section before downloading');
  };
  const fail=function(msg){ if(generation!==ledgerImportGeneration)return;state.upload={status:'idle',filename:''}; saveState(); render(); showToast(msg||'Import failed'); };

  if(name.endsWith('.json')){
    // Reject outsized projects before allocating/parsing huge nested JSON.
    if(file.size>36*1024*1024){fail('JSON backup exceeds the 36 MB safety limit — nothing was replaced');return;}
    const reader=new FileReader();
    reader.onload=function(){ try{
      if(!isCurrent()){stale();return;}
      const data=JSON.parse(reader.result);
      if(data.document){
        const restored=validateLedgerBackup(data);
        if(!restored) throw new Error('Invalid project structure');
        ledgerPendingProjectRestore=null;
        if(ledgerWorkspaceHasRealWork()){
          state.upload={status:'idle',filename:''};saveState();render();
          ledgerStageProjectRestore(restored);
          openModal('<div class="modal-icon" aria-hidden="true">↺</div><h2 class="modal-title">Replace your current workspace?</h2><p class="modal-sub">Restoring this project will replace the CVs currently open in Ledger. Download a backup of your present workspace first if you want to keep it.</p>'+ledgerRestoreSummary(restored)+'<div class="modal-options"><button type="button" class="btn btn-primary" data-action="export-project">Back up current workspace</button><button type="button" class="btn btn-danger" data-action="confirm-project-restore">Replace workspace with imported project</button><button type="button" class="btn btn-ghost" data-action="cancel-project-restore">Cancel import</button></div>');
        } else {ledgerStageProjectRestore(restored);ledgerConfirmProjectRestore();}
      } else {
        const safe=validateLedgerDocument(data);
        if(!safe) throw new Error('Invalid CV structure');
        done(safe);
      }
    }catch(e){ console.warn('Ledger project import rejected',e); fail(e&&e.message&&(/integrity check|more than 12 CV versions|invalid .* section|Too many or invalid|exceeds the supported|invalid text type|Invalid personal details/i).test(e.message)?e.message:'Invalid JSON backup — nothing was replaced'); } };
    reader.onerror=function(){fail('Could not read JSON backup');};
    reader.readAsText(file); return;
  }

  if(name.endsWith('.docx')){
    if(typeof JSZip==='undefined'){ fail('DOCX library not loaded — try TXT or refresh the page'); return; }
    const reader=new FileReader();
    reader.onload=function(){
      JSZip.loadAsync(reader.result).then(function(zip){
        const docFile=zip.file('word/document.xml');
        if(!docFile) throw new Error('No document.xml');
        // An 8 MB ZIP can contain hundreds of megabytes of XML. Refuse
        // unexpectedly large decompression before building the full string.
        if(Object.keys(zip.files).length>500)throw new Error('Too many DOCX parts');
        const xmlBytes=docFile._data&&docFile._data.uncompressedSize;
        if(!Number.isFinite(xmlBytes)||xmlBytes>12*1024*1024)throw new Error('DOCX document XML is too large');
        return docFile.async('string');
      }).then(function(xml){
        if(xml.length>12*1024*1024)throw new Error('DOCX document XML is too large');
        // Strip tags to text, keep paragraph breaks
        const text=xml
          .replace(/<w:tab\/>/g,'\t')
          .replace(/<w:br\/>/g,'\n')
          .replace(/<\/w:p>/g,'\n')
          .replace(/<[^>]+>/g,'')
          .replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"')
          .replace(/&#39;/g,"'");
        done(parseLedgerGeneratedDocx(xml)||parseImportedCvTextEnhanced(text));
      }).catch(function(err){ console.error(err); fail(err&&/too large|Too many DOCX/.test(err.message)?'DOCX content is too large to import safely':'Could not parse DOCX'); });
    };
    reader.onerror=function(){fail('Could not read DOCX file');};
    reader.readAsArrayBuffer(file); return;
  }

  if(name.endsWith('.pdf')){
    if(typeof pdfjsLib==='undefined'){ ensurePdfImportLibrary().then(()=>{if(isCurrent())importCvFile(file);else stale();}).catch(()=>fail('PDF import requires an internet connection. Try DOCX or TXT offline.')); return; }
    pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    const reader=new FileReader();
    reader.onload=function(){
      const typed=new Uint8Array(reader.result);
      pdfjsLib.getDocument({data:typed}).promise.then(function(pdf){
        const max=Math.min(pdf.numPages,4);
        const parts=[];
        let chain=Promise.resolve();
        for(let i=1;i<=max;i++){
          chain=chain.then(function(){
            return pdf.getPage(i).then(function(page){
              return page.getTextContent().then(function(tc){
                parts.push(tc.items.map(function(it){ return it.str; }).join(' '));
              });
            });
          });
        }
        return chain.then(function(){ done(parseImportedCvTextEnhanced(parts.join('\n'))); });
      }).catch(function(err){ console.error(err); fail('Could not read PDF text'); });
    };
    reader.onerror=function(){fail('Could not read PDF file');};
    reader.readAsArrayBuffer(file); return;
  }

  // txt / html / doc-as-text
  const reader=new FileReader();
  reader.onload=function(){ done(parseImportedCvTextEnhanced(reader.result||'')); };
  reader.onerror=function(){ fail(); };
  reader.readAsText(file);
}

// Parse documents produced by Ledger using their real OOXML section and
// bullet semantics. Generic third-party DOCX continues through the cautious
// text-only heuristic and always requires user review.
function parseLedgerGeneratedDocx(xml){
  const ns='http://schemas.openxmlformats.org/wordprocessingml/2006/main';
  const parsed=new DOMParser().parseFromString(xml,'application/xml');
  if(parsed.getElementsByTagName('parsererror').length)return null;
  const paragraphs=Array.from(parsed.getElementsByTagNameNS(ns,'p')).slice(0,2400);
  const read=p=>Array.from(p.getElementsByTagNameNS(ns,'t')).map(n=>n.textContent||'').join('').trim();
  const styled=p=>{
    const ppr=p.getElementsByTagNameNS(ns,'pPr')[0];
    const tag=ppr&&ppr.getElementsByTagNameNS(ns,'pStyle')[0];
    return tag ? tag.getAttributeNS(ns,'val')||tag.getAttribute('w:val') : '';
  };
  if(!paragraphs.some(p=>styled(p)==='LedgerHeading'))return null;
  const data=defaultState().document;
  const entries=paragraphs.map(p=>({text:read(p),style:styled(p),bullet:p.getElementsByTagNameNS(ns,'numPr').length>0})).filter(p=>p.text);
  const name=(entries[0]||{}).text||'';
  const pieces=name.split(/\s+/);data.personalInfo.firstName=pieces[0]||'';
  data.personalInfo.lastName=pieces.slice(1).join(' ');
  const headline=(entries[1]||{}).text||'';
  if(headline && !['Summary','Experience','Education','Skills'].includes(headline))data.personalInfo.title=headline;
  const contact=entries.find((p,i)=>i<4 && p.text.includes('@'));
  if(contact){
    const parts=contact.text.split(/\s*\|\s*/);
    data.personalInfo.email=(contact.text.match(/[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}/)||[''])[0];
    data.personalInfo.phone=(contact.text.match(/(?:\+?\d[\d ()-]{7,}\d)/)||[''])[0];
    const location=parts.find(x=>!x.includes('@')&&!/\d{5,}/.test(x)&&!/(linkedin|https?:)/i.test(x));
    if(location)data.personalInfo.city=location.trim();
  }
  const months={Jan:'01',Feb:'02',Mar:'03',Apr:'04',May:'05',Jun:'06',Jul:'07',Aug:'08',Sep:'09',Oct:'10',Nov:'11',Dec:'12'};
  const extractDates=line=>{
    const match=line.match(/(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+(\d{4})\s*[–—-]\s*(Present|(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+(\d{4}))$/);
    if(!match)return {text:line,start:'',end:'',current:false};
    return {text:line.slice(0,match.index).trim(),start:match[2]+'-'+months[match[1]],end:match[5]?match[5]+'-'+months[match[4]]:'',current:match[3]==='Present'};
  };
  let mode='',role=null,education=null,expectInstitution=false;
  for(const p of entries){
    if(p.style==='LedgerHeading'){
      const key=p.text.toLowerCase();
      mode={summary:'summary',experience:'experience',education:'education',skills:'skills',certifications:'certifications',languages:'languages',projects:'projects',achievements:'accomplishments',interests:'hobbies',references:'references'}[key]||'';
      role=null;education=null;expectInstitution=false;continue;
    }
    if(!mode)continue;
    if(mode==='summary'){data.summary+=(data.summary?'\n':'')+p.text;continue;}
    if(mode==='experience'){
      if(p.bullet){if(role)role.description+=(role.description?'\n':'')+p.text;}
      else if(p.text.includes(' — ')){
        const date=extractDates(p.text),bits=date.text.split(' — ');
        role={id:uid(),title:bits.shift()||'',employer:bits.join(' — '),location:'',start:date.start,end:date.end,current:date.current,description:''};
        data.experience.push(role);
      }else if(role&&!role.location)role.location=p.text;
      continue;
    }
    if(mode==='education'){
      if(!expectInstitution){
        const date=extractDates(p.text),bits=date.text.split(', ');
        education={id:uid(),qualification:bits.shift()||'',field:bits.join(', '),institution:'',location:'',start:date.start,end:date.end,current:date.current};
        data.education.push(education);expectInstitution=true;
      }else if(education){
        const bits=p.text.split(', ');education.institution=bits.shift()||'';education.location=bits.join(', ');expectInstitution=false;
      }
      continue;
    }
    if(mode==='skills'){for(const skill of p.text.split(/\s*[·•]\s*|\s*;\s*/).filter(Boolean))data.skills.push({name:skill,level:3});continue;}
    if(mode==='certifications'){data.certifications.push({id:uid(),name:p.text,issuer:'',year:''});continue;}
    if(mode==='languages'){for(const language of p.text.split(/[·•;,]/).map(s=>s.trim()).filter(Boolean))data.languages.push({id:uid(),name:language,level:''});continue;}
    if(mode==='projects'){data.projects.push({id:uid(),name:p.text,description:''});continue;}
    if(mode==='accomplishments'){data.accomplishments.push({id:uid(),text:p.text,category:'',impact:''});continue;}
    if(mode==='hobbies')data.hobbies+=(data.hobbies?'\n':'')+p.text;
    if(mode==='references')data.references+=(data.references?'\n':'')+p.text;
  }
  data.experience.forEach(r=>r.description=textToBulletsHtml(r.description));
  return data;
}
function parseImportedCvTextEnhanced(raw){
  const base=parseImportedCvText(raw);
  const text=String(raw||'').replace(/\r/g,'');
  const lines=text.split('\n').map(x=>x.trim()).filter(Boolean);
  const sumIdx=lines.findIndex(l=>/^(professional\s+)?(summary|profile|personal statement)\b/i.test(l));
  if(sumIdx>=0){
    const bits=[];
    for(let i=sumIdx+1;i<lines.length && i<sumIdx+6;i++){
      if(/^(experience|education|skills|work history|employment|qualifications)\b/i.test(lines[i])) break;
      bits.push(lines[i]);
    }
    if(bits.length) base.summary=bits.join(' ');
  }
  const expIdx=lines.findIndex(l=>/^(work\s+)?(experience|history|employment)\b/i.test(l));
  const eduIdx=lines.findIndex(l=>/^(education|qualifications)\b/i.test(l));
  const skillsIdx=lines.findIndex(l=>/^skills\b/i.test(l));
  if(expIdx>=0){
    const end=Math.min(eduIdx>expIdx?eduIdx:lines.length, skillsIdx>expIdx?skillsIdx:lines.length);
    const block=lines.slice(expIdx+1, end);
    let current=null;
    base.experience=[];
    block.forEach(function(line){
      if(/^[-•*]/.test(line) || line.charAt(0)==='\u2022'){
        if(!current) current={id:uid(),title:'Role',employer:'',location:'',start:'',end:'',current:false,description:''};
        const bullet=line.replace(/^[-•*\u2022]\s*/,'');
        current.description += (current.description?'\n':'') + bullet;
      } else if(line.length>3 && line.length<80 && !/^[a-z]/.test(line)){
        if(current && (current.description||current.employer)) base.experience.push(current);
        current={id:uid(),title:line,employer:'',location:'',start:'',end:'',current:false,description:''};
      } else if(current && !current.employer && line.length<60){
        current.employer=line;
      }
    });
    if(current) base.experience.push(current);
    base.experience.forEach(ex=>{ ex.description=textToBulletsHtml(ex.description); });
  }
  if(eduIdx>=0){
    const end=skillsIdx>eduIdx?skillsIdx:lines.length;
    const block=lines.slice(eduIdx+1, Math.min(end, eduIdx+8));
    if(block.length){
      base.education=[{id:uid(),qualification:block[0]||'',field:'',institution:block[1]||'',location:'',start:'',end:(block.find(l=>/20\d{2}/.test(l))||''),current:false}];
    }
  }
  return base;
}


function parseImportedCvText(raw){
  const input=String(raw||'');
  // HTML documents are parsed inertly; normal text is never interpreted as markup.
  const text=(/^\s*<(?:!doctype|html|head|body|div|p|span|h[1-6]|ul|li)\b/i.test(input)
    ? new DOMParser().parseFromString(input,'text/html').body.textContent
    : input).replace(/\r/g,'');
  const lines=text.split('\n').map(x=>x.trim()).filter(Boolean);
  const email=(text.match(/[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}/)||[''])[0];
  const phone=(text.match(/(?:\+?\d[\d ()-]{7,}\d)/)||[''])[0];
  const skillsLine=lines.find(x=>/^skills?\s*:/i.test(x));
  const skills=(skillsLine?skillsLine.replace(/^skills?\s*:/i,''): '').split(/[,;|]/).map(x=>x.trim()).filter(Boolean).map(name=>({name,level:3}));
  const titleLine=lines.find(x=>/manager|assistant|driver|worker|operative|engineer|teacher|nurse|developer|cleaner|guard|accountant|chef|cook/i.test(x))||'';
  const nameLine=lines.find(x=>!/@/.test(x)&&!/^(cv|resume|curriculum vitae|experience|education|skills)$/i.test(x))||'';
  return {personalInfo:{firstName:nameLine.split(/\s+/)[0]||'',lastName:nameLine.split(/\s+/).slice(1).join(' '),title:titleLine,email,phone,city:'',postcode:'',linkedin:'',website:''},summary:'',experience:[],education:[],skills,languages:[],certifications:[],projects:[],accomplishments:[],hobbies:'',references:'',customSections:[]};
}
function openDownloadModal(){
  const checks=runPreflight();
  const issues=ledgerCVReview(state.document).filter(x=>x.level==='action');
  const a=state.appearance;
  const tmplPicker=`<div class="final-tmpl-block"><div class="editor-panel-label">Template for this export</div><p class="field-hint" style="margin:4px 0 10px;">Not happy with the look? Switch template here — your content is kept.</p><div class="final-tmpl-row">${TEMPLATES.map(t=>`<button type="button" class="final-tmpl-chip ${a.template===t.id?'on':''}" data-action="pick-template-final" data-value="${t.id}">${escapeHtml(t.name)}</button>`).join('')}</div></div>`;
  openModal(`<div class="modal-icon">↓</div><h2 class="modal-title">Your CV is ready</h2><p class="modal-sub">Choose text-first PDF for applications, or an editable Word document. Your content stays in your browser.</p>${issues.length?`<div class="ledger-export-warning" role="status"><strong>${issues.length} important check${issues.length===1?'':'s'} remain.</strong> Your CV can still export. For a stronger application, <button type="button" data-action="review-from-export">review them first →</button></div>`:'<div class="ledger-export-good">✓ No important content issues detected by the local checklist.</div>'}${tmplPicker}<div class="preflight-card"><strong>Print-safe style: ${escapeHtml(printStyleDescription())}</strong><p class="field-hint">All templates export through a paginated single-column profile. The legacy image PDF was retired because long CVs could clip or rasterize.</p></div><div class="preflight-card"><strong>Preflight check</strong><ul class="preflight-list">${checks.map(c=>`<li class="${c.ok?'ok':''}">${escapeHtml(c.text)}</li>`).join('')}</ul></div><div class="modal-options" style="margin-top:16px;"><button class="modal-file-opt ledger-best-export" data-action="print-text-pdf"><span class="fx">PDF</span><span><span class="modal-file-opt-title">Application PDF · Print / Save <span class="ledger-current-tag">Recommended</span></span><br><span class="modal-file-opt-sub">Text-selectable A4 with a page-safe style profile; choose “Save as PDF” in the print dialog. Layout simplified where necessary.</span></span></button><button class="modal-file-opt" data-action="download-word"><span class="fx">DOCX</span><span><span class="modal-file-opt-title">Download Word document</span><br><span class="modal-file-opt-sub">Editable, single-column Office Open XML. Content matches Application PDF; Word may reflow lines.</span></span></button><button class="modal-file-opt" data-action="download-html"><span class="fx">HTML</span><span><span class="modal-file-opt-title">Portable HTML CV</span><br><span class="modal-file-opt-sub">Accessible, text-based standalone document</span></span></button><button class="modal-file-opt" data-action="export-project"><span class="fx">JSON</span><span><span class="modal-file-opt-title">Back up Ledger project</span><br><span class="modal-file-opt-sub">Restore your content on this device</span></span></button><button class="btn btn-ghost" data-action="modal-continue-editing">Continue Editing</button></div>`);
}
function runPreflight(){
  const d=state.document,p=d.personalInfo||{}, checks=[];
  checks.push({ok:!!(p.firstName&&p.lastName),text:p.firstName&&p.lastName?'Name is present.':'Add your first and last name.'});
  checks.push({ok:!!(String(p.email||'').trim()||String(p.phone||'').trim()),text:(p.email||p.phone)?'A contact method is present.':'Add a reachable email address or phone number.'});
  checks.push({ok:!!p.title,text:p.title?'Professional title is present.':'Add a target professional title.'});
  checks.push({ok:d.summary.length>=80,text:d.summary.length>=80?'Summary has useful detail.':'Write a summary of at least 80 characters.'});
  checks.push({ok:d.experience.some(x=>x.description),text:d.experience.some(x=>x.description)?'At least one experience entry has evidence.':'Add evidence-led bullets to your experience.'});
  checks.push({ok:d.skills.length>=4,text:d.skills.length>=4?'Skills section has enough entries.':'Add at least four relevant skills.'});
  checks.push({ok:!/(?:example\.com|lorem ipsum|your name|insert here)/i.test([p.email,p.website,p.linkedin,d.summary,...d.experience.map(x=>x.description||'')].join(' ')),text:'Review all fields for example addresses and placeholder text before applying.'});
  checks.push({ok:true,text:'Pages will be laid out by the browser when you Print / Save as PDF. Review page breaks before saving.'});
  if(state.targeting&&state.targeting.analysis) checks.push({ok:state.targeting.analysis.score>=60,text:`Job match is ${state.targeting.analysis.score}%. Review missing keywords before exporting.`});
  try{
    const ats=computeAtsScore(d, state.appearance, state.targeting&&state.targeting.analysis);
    checks.push({ok:ats.score>=60,text:`CV preparation checklist score: ${ats.score}/100. ${ats.score>=75?'Strong structure.':ats.score>=50?'Improve weak items in Job Match panel.':'Open Job Match for fix tips.'}`});
  }catch(e){}
  return checks;
}
function analyzeTargetFromUI(){
  const title=(document.getElementById('targetTitle')||{}).value||'';
  const employer=(document.getElementById('targetEmployer')||{}).value||'';
  const description=(document.getElementById('targetDescription')||{}).value||'';
  state.targeting={title,employer,description,analysis:analyzeJobTarget(title,description,state.document)};
  saveState(); render();
}
function generateCoverLetterFromUI(){
  const c=state.coverLetter||{};
  document.querySelectorAll('[data-cover-field]').forEach(input=>{ if(input.dataset.coverField!=='text') c[input.dataset.coverField]=input.value; });
  const p=state.document.personalInfo||{};
  const t=state.targeting||{};
  const role=c.role||t.title||p.title||'the advertised role';
  const employer=c.employer||t.employer||'your organisation';
  const tmpl=c.template||'classic';
  const skills=state.document.skills.slice(0,6).map(s=>s.name).filter(Boolean);
  const exp=state.document.experience[0];
  const expBits=exp? [exp.title, exp.employer, stripHtmlForEdit(exp.description||'').split('\n').filter(Boolean).slice(0,2).join('; ')].filter(Boolean).join(' — ') : '';
  const missing=((t.analysis&&t.analysis.missing)||[]).slice(0,5);
  const found=((t.analysis&&t.analysis.found)||[]).slice(0,5);
  const name=((p.firstName||'')+' '+(p.lastName||'')).trim()||'Applicant';
  const date=new Date().toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
  let intro, body, close;
  if(tmpl==='modern'){
    intro=`I am applying for the ${role} role at ${employer}${c.opening?`, ${c.opening}`:''}. I am confident my experience and approach would transfer well to your team.`;
    body=`${expBits?`Most recently I have worked as ${expBits}. `:''}${skills.length?`Core strengths include ${skills.join(', ')}. `:''}${found.length?`I already work with themes that appear in your advert, including ${found.join(', ')}. `:''}${missing.length?`I am also comfortable developing further in areas such as ${missing.join(', ')} where training or exposure is available. `:''}I work in a practical, reliable way and take ownership of the tasks I am given.`;
    close=`Thank you for considering my application. I would welcome a conversation about how I could support ${employer}.`;
  } else if(tmpl==='compact'){
    intro=`Application: ${role} — ${employer}.`;
    body=`I am a dependable candidate with relevant experience${exp?` as ${exp.title||'a team member'}${exp.employer?' at '+exp.employer:''}`:''}. ${skills.length?`Key skills: ${skills.join(', ')}. `:''}${found.length?`Aligned to your advert: ${found.join(', ')}. `:''}I follow procedures, communicate clearly, and complete work to a consistent standard.`;
    close=`I am available for interview at short notice and look forward to hearing from you.`;
  } else if(tmpl==='executive'){
    intro=`I wish to apply for the position of ${role} at ${employer}. With a track record of delivering results and leading work to a high standard, I believe I can contribute immediately.`;
    body=`${expBits?`In my current/recent role (${expBits}), I focused on outcomes, communication, and continuous improvement. `:''}${skills.length?`I bring particular strength in ${skills.slice(0,4).join(', ')}. `:''}I am motivated by clear goals, professional standards, and building trust with colleagues and stakeholders.`;
    close=`I would be pleased to discuss how my experience aligns with your priorities for this role. Thank you for your time and consideration.`;
  } else {
    // classic
    intro=c.opening&&c.opening.length>40?c.opening:`I am writing to apply for the ${role} position at ${employer}. I am interested in the opportunity to contribute through a practical, reliable approach.`;
    body=`${expBits?`My experience includes ${expBits}. `:''}${skills.length?`I can offer strengths in ${skills.join(', ')}. `:''}${found.length?`These map well to requirements in your advert such as ${found.join(', ')}. `:''}I take pride in accurate work, clear communication, and following processes through to completion.`;
    close=`I would welcome the opportunity to discuss how my experience could support ${employer}. Thank you for considering my application.`;
  }
  const closing=c.closing||'Yours sincerely,';
  c.text=[name, p.email||'', p.phone||'', p.city||'', '', date, '', `Dear Hiring Manager,`, '', intro, '', body, '', close, '', closing, name].filter((line,i,arr)=>line!==''||(i>0&&arr[i-1]!=='')).join('\n');
  state.coverLetter=c; saveState(); render(); showToast('Cover letter generated — review and edit before sending');
}

function downloadCoverLetter(){
  const c=state.coverLetter||{}; if(!c.text){ generateCoverLetterFromUI(); return; }
  const safe=((c.role||'cover-letter').replace(/[^a-z0-9]+/gi,'-').replace(/^-|-$/g,'')||'cover-letter').toLowerCase();
  downloadBlob(new Blob([c.text],{type:'text/plain;charset=utf-8'}),safe+'.txt'); showToast('Cover letter downloaded');
}
function analyzeJobTarget(title,description,doc){
  const stop=new Set('about after again against all also and are as at be been before being between but by can could did do does for from had has have having how if in into is it its more most must of on once only or other our out over required should so than that the their them then there these they this to under until use using was we were what when where which who will with would you your able across already applicant applicants application apply based both come company current currently each either end ensure etc experience experienced following full further get given good great help high highly including just keep known like make many may need needs new next offer offered opportunity other own part please possible preferred prior provide provides role roles same see several some strong such take team teams through time times upon via well within work working years year'.split(' '));
  const text=String(description||'').toLowerCase();
  const words=text.match(/[a-z][a-z0-9+#./-]{2,}/g)||[];
  const freq={};
  words.forEach(w=>{ w=w.replace(/^[./-]+|[./-]+$/g,''); if(w.length<3||stop.has(w)||/^\d+$/.test(w)) return; freq[w]=(freq[w]||0)+1; });
  // Prefer multi-word skill-like phrases from description
  const phrases=[];
  const phraseRe=/(health and safety|customer service|microsoft office|stock control|manual handling|quality control|project management|data entry|problem solving|time management|attention to detail|food hygiene|infection prevention|access control|cash handling)/gi;
  let m; while((m=phraseRe.exec(description||''))){ phrases.push(m[1].toLowerCase()); }
  const keywords=Array.from(new Set(phrases.concat(Object.keys(freq).filter(w=>freq[w]>=1).sort((a,b)=>freq[b]-freq[a]||a.localeCompare(b)).slice(0,20)))).slice(0,24);
  const corpus=[
    doc.summary||'',
    (doc.personalInfo&&doc.personalInfo.title)||'',
    ...(doc.skills||[]).map(s=>s.name||''),
    ...(doc.experience||[]).map(ex=>[ex.title,ex.employer,stripHtmlForEdit(ex.description||'')].join(' ')),
    ...(doc.education||[]).map(ed=>[ed.qualification,ed.field,ed.institution].join(' ')),
    ...(doc.certifications||[]).map(c=>c.name||''),
    title||''
  ].join(' ').toLowerCase();
  const found=keywords.filter(k=>corpus.includes(k));
  const missing=keywords.filter(k=>!corpus.includes(k));
  const score=keywords.length?Math.round((found.length/keywords.length)*100):0;
  // Tailored bullet/summary suggestions from role engine for missing themes
  const roleTitle=title||(doc.personalInfo&&doc.personalInfo.title)||'';
  const bulletIdeas=(cvEngine.getResponsibilities(roleTitle)||[]).slice(0,6);
  const skillIdeas=(cvEngine.getSuggestedSkills(roleTitle)||[]).filter(s=>missing.some(k=>s.toLowerCase().includes(k)||k.includes(s.toLowerCase().split(' ')[0]))).slice(0,8);
  const summaryIdeas=(cvEngine.getSummarySuggestions(roleTitle)||[]).slice(0,3).map(s=>s.replace(/\{title\}/g, roleTitle||'professional'));
  return {
    score, keywords, found, missing,
    guidance: cvEngine.getContentGuidance(roleTitle),
    bulletIdeas, skillIdeas, summaryIdeas,
    ats: computeAtsScore(doc, state.appearance, {found, missing, score})
  };
}
function computeAtsScore(doc, appearance, jobMatch){
  const tips=[];
  let pts=0, max=100;
  const p=doc.personalInfo||{};
  // Contact essentials
  if(p.firstName&&p.lastName){ pts+=8; tips.push({ok:true,text:'Name is present'}); } else { tips.push({ok:false,text:'Add your full name'}); }
  if(p.email&&/@/.test(p.email)){ pts+=8; tips.push({ok:true,text:'Email looks valid'}); } else { tips.push({ok:false,text:'Add a professional email address'}); }
  if(p.phone){ pts+=6; tips.push({ok:true,text:'Phone number included'}); } else { tips.push({ok:false,text:'Add a phone number'}); }
  if(p.city||p.postcode){ pts+=4; tips.push({ok:true,text:'Location included'}); } else { tips.push({ok:false,text:'Add city or postcode for local roles'}); }
  // Summary
  const sumLen=(doc.summary||'').trim().length;
  if(sumLen>=180){ pts+=12; tips.push({ok:true,text:'Professional summary has enough depth'}); }
  else if(sumLen>=80){ pts+=7; tips.push({ok:false,text:'Expand your summary to 2–4 full sentences (aim 300–600 characters)'}); }
  else { tips.push({ok:false,text:'Add a professional summary — recruiters read this first'}); }
  // Experience
  if((doc.experience||[]).length>=1){
    pts+=10;
    const withBullets=doc.experience.filter(ex=>stripHtmlForEdit(ex.description||'').length>40).length;
    if(withBullets===doc.experience.length){ pts+=10; tips.push({ok:true,text:'Experience entries include detail'}); }
    else { pts+=4; tips.push({ok:false,text:'Add bullet points under each role (duties and results)'}); }
    tips.push({ok:true,text:'Work history section present'});
  } else { tips.push({ok:false,text:'Add at least one work experience entry'}); }
  // Skills
  if((doc.skills||[]).length>=5){ pts+=10; tips.push({ok:true,text:'Skills list is solid (5+)'}); }
  else if((doc.skills||[]).length>=3){ pts+=6; tips.push({ok:false,text:'Add more skills relevant to the target role (aim for 6–12)'}); }
  else { tips.push({ok:false,text:'Add a skills section with role-specific keywords'}); }
  // Education
  if((doc.education||[]).length>=1){ pts+=8; tips.push({ok:true,text:'Education included'}); }
  else { tips.push({ok:false,text:'Add education or relevant training'}); }
  // Template ATS-friendliness
  const tmpl=(appearance&&appearance.template)||'modern';
  const atsSafe=['ats-classic','ats-compact','ats-plus','simple','minimal','minimal-ink','modern','modern-navy','modern-coral','professional','professional-slate','compact-pro','classic-serif','line-accent','fresh','bold-name'].includes(tmpl);
  if(atsSafe){ pts+=8; tips.push({ok:true,text:'Template uses clear headings and a mostly simple flow (ATS compatibility not verified)'}); }
  else { pts+=3; tips.push({ok:false,text:'Creative/sidebar templates can confuse some ATS — use ATS Classic for online applications'}); }
  // Job match bonus
  if(jobMatch){
    if(jobMatch.score>=70){ pts+=10; tips.push({ok:true,text:'Strong keyword match to the job advert ('+jobMatch.score+'%)'}); }
    else if(jobMatch.score>=40){ pts+=5; tips.push({ok:false,text:'Keyword match is moderate ('+jobMatch.score+'%) — weave missing terms into skills and bullets'}); }
    else if(jobMatch.keywords&&jobMatch.keywords.length){ tips.push({ok:false,text:'Low keyword match ('+jobMatch.score+'%) — add missing keywords where truthful'}); }
  }
  // Section headings standard
  pts+=6; tips.push({ok:true,text:'Standard section structure helps ATS parsing'});
  const score=Math.max(0, Math.min(100, Math.round(pts)));
  return {score, tips, band: score>=75?'good':score>=50?'mid':'low'};
}

function downloadProjectBackup(){
  syncActiveVersion();
  const payload=ledgerPrepareProjectBackup();
  if(downloadBlob(new Blob([payload],{type:'application/json'}),'ledger-cv-project.json')){closeModal();showToast('Ledger backup prepared — keep the downloaded file safe');}
}
function downloadBlob(blob,name){
  try{
    const url=URL.createObjectURL(blob),a=document.createElement('a');
    a.href=url;a.download=name;a.rel='noopener';a.style.display='none';
    document.body.appendChild(a);a.click();
    setTimeout(()=>{URL.revokeObjectURL(url);a.remove();},1500);
    return true;
  }catch(err){
    console.error('Ledger download error',err);
    showToast('Your browser blocked the download. Use the browser menu and choose Download/Save.');
    return false;
  }
}
function escapePdfFilename(){
  const p=state.document.personalInfo||{};
  return ([p.firstName,p.lastName].filter(Boolean).join('_')||'Ledger_CV').replace(/[^a-zA-Z0-9_-]/g,'_').slice(0,75);
}

function getTextExportSettings(a){
  a=a||state.appearance||{};
  const margin=a.margins==='narrow'?[13,14]:a.margins==='wide'?[21,22]:[17,18];
  const size=a.fontSize==='small'?10:a.fontSize==='large'?11.25:10.5;
  const gap=a.spacing==='compact'?9:a.spacing==='spacious'?16:12;
  const leading=a.spacing==='compact'?1.3:a.spacing==='spacious'?1.55:1.42;
  // Avoid remote font dependencies in hiring documents. Fonts here exist on common office systems.
  const font=a.font==='georgia'||a.font==='lora'||a.font==='garamond'?'Georgia, "Times New Roman", serif':'Arial, Helvetica, sans-serif';
  const wordFont=a.font==='georgia'||a.font==='lora'||a.font==='garamond'?'Georgia':'Arial';
  return {margin,size,gap,leading,font,wordFont};
}
function buildTextCvHtml(){
  const d=state.document,p=d.personalInfo||{},a=state.appearance,settings=getTextExportSettings(a);
  const name=[p.firstName,p.lastName].filter(Boolean).join(' ')||'Your Name';
  const contact=[p.city,p.postcode,p.phone,p.email,p.linkedin,p.website].filter(Boolean).map(escapeHtml).join(' &nbsp; | &nbsp; ');
  const section=(heading,contents)=>contents?`<section><h2>${escapeHtml(heading)}</h2>${contents}</section>`:'';
  const bulletList=items=>items.length?`<ul>${items.map(x=>`<li>${escapeHtml(x)}</li>`).join('')}</ul>`:'';
  const dates=e=>e.current?`${fmtMonth(e.start)} – Present`:[fmtMonth(e.start),fmtMonth(e.end)].filter(Boolean).join(' – ');
  const parts={
    summary:()=>section('Professional Summary',d.summary?`<p>${escapeHtml(d.summary)}</p>`:''),
    experience:()=>section('Professional Experience',(d.experience||[]).map(x=>`<div class="entry"><h3>${escapeHtml(x.title||'Role')}${x.employer?' · '+escapeHtml(x.employer):''}</h3><p class="meta">${escapeHtml([x.location,dates(x)].filter(Boolean).join('  |  '))}</p>${bulletList(stripHtmlForDocx(x.description||''))}</div>`).join('')),
    education:()=>section('Education',(d.education||[]).map(x=>`<div class="entry"><h3>${escapeHtml([x.qualification,x.field].filter(Boolean).join(', '))}</h3><p class="meta">${escapeHtml([x.institution,x.location,dates(x)].filter(Boolean).join(' | '))}</p></div>`).join('')),
    skills:()=>section('Skills',(d.skills||[]).length?`<p>${d.skills.map(x=>escapeHtml(x.name)).join(' · ')}</p>`:''),
    certifications:()=>section('Certifications',(d.certifications||[]).map(x=>`<div class="entry"><h3>${escapeHtml(x.name)}</h3><p class="meta">${escapeHtml([x.issuer,x.year].filter(Boolean).join(' | '))}</p></div>`).join('')),
    languages:()=>section('Languages',(d.languages||[]).length?`<p>${d.languages.map(x=>escapeHtml(x.name)+(x.level?' ('+escapeHtml(x.level)+')':'')).join(' · ')}</p>`:''),
    projects:()=>section('Projects',(d.projects||[]).map(x=>`<div class="entry"><h3>${escapeHtml(x.name)}</h3><p>${escapeHtml(x.description||'')}</p></div>`).join('')),
    accomplishments:()=>section('Achievements',bulletList((d.accomplishments||[]).map(x=>[x.category,x.text,x.impact].filter(Boolean).join(' · ')))),
    hobbies:()=>section('Interests',d.hobbies?`<p>${escapeHtml(d.hobbies)}</p>`:''),
    references:()=>section('References',d.references?`<p>${escapeHtml(d.references)}</p>`:'')
  };
  const order=(a.sectionOrder||[]).filter(id=>parts[id]&&(SECTION_META[id].core||a.enabledSections[id]));
  let blocks=order.map(id=>parts[id]()).join('');
  blocks+=(d.customSections||[]).map(x=>section(x.title,`<p>${escapeHtml(x.content||'')}</p>`)).join('');
  const printProfile=getSafePrintStyle(a.template);
  const accent=safePrintAccent(a.color);
  const themeCss={
    modern:`header{text-align:left!important;border-bottom:2pt solid ${accent}!important}h1{font-size:24pt!important;letter-spacing:0!important}header .title{color:${accent}!important}h2{color:${accent}!important;border-bottom:1pt solid ${accent}!important}`,
    executive:`header{text-align:center!important;border-bottom:2pt double #293344!important}h1{font-family:Georgia,serif!important;font-size:22pt!important;letter-spacing:.045em!important;text-transform:uppercase}h2{text-align:center!important;color:#25334b!important;letter-spacing:.12em!important}`,
    trade:`header{text-align:left!important;border-bottom:3pt solid ${accent}!important}h1{font-family:Arial,Helvetica,sans-serif!important;font-weight:800!important;letter-spacing:0!important}header .title{color:${accent}!important;font-weight:700!important}h2{border-bottom:2pt solid ${accent}!important;color:#25334b!important;letter-spacing:.08em!important}`,
    classic:`header{text-align:center!important;border-bottom:1pt solid #2a2a2a!important}h1{font-size:20pt!important;letter-spacing:0!important}header .title{color:#232b34!important}h2{color:#20242a!important;border-bottom:.65pt solid #7c8490!important;letter-spacing:.04em!important}`
  };
  const css=`
    @page{size:A4;margin:${settings.margin[0]}mm ${settings.margin[1]}mm}
    *{box-sizing:border-box} html{background:#fff}body{font-family:${settings.font};font-size:${settings.size}pt;line-height:${settings.leading};color:#1b2430;margin:0;overflow:visible}
    header{text-align:center;padding-bottom:11pt;border-bottom:1.1pt solid #182333;margin-bottom:15pt}
    h1{font-size:21pt;line-height:1.12;letter-spacing:.018em;margin:0 0 4pt;font-weight:750}
    header .title{font-size:10.5pt;font-weight:600;margin:0 0 5pt;color:#2B5555}
    header .contact{font-size:8.8pt;color:#333;line-height:1.55;overflow-wrap:anywhere}
    section{margin:0 0 ${settings.gap}pt}h2{font-size:10.5pt;line-height:1.35;text-transform:uppercase;letter-spacing:.065em;border-bottom:.65pt solid #9aa2a8;margin:0 0 7pt;padding:0 0 3pt;break-after:avoid;page-break-after:avoid}
    h3{font-size:10.2pt;margin:0;font-weight:bold;break-after:avoid;page-break-after:avoid}
    .meta{font-size:9.2pt;color:#515962;margin:2pt 0 4pt}
    .entry{margin-bottom:9pt;break-inside:auto;page-break-inside:auto}
    .entry h3,.entry .meta{break-after:avoid;page-break-after:avoid}
    p{margin:3pt 0 6pt;white-space:pre-wrap;overflow-wrap:anywhere;orphans:2;widows:2}
    ul{margin:3pt 0 6pt;padding-left:17pt}li{margin:0 0 3pt;break-inside:auto;page-break-inside:auto;overflow-wrap:anywhere;orphans:2;widows:2}
    header{break-inside:avoid;page-break-inside:avoid}section>h2{break-after:avoid-page;page-break-after:avoid}
    ${themeCss[printProfile.id]}
    @media screen{html{background:#fff}body{width:210mm;min-height:297mm;max-width:none;margin:0;padding:${settings.margin[0]}mm ${settings.margin[1]}mm;background:#fff;box-shadow:none}}
  `;
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><title>${escapeHtml(name)} — CV</title><meta name="viewport" content="width=device-width, initial-scale=1"><style>${css}</style></head><body><header><h1>${escapeHtml(name)}</h1>${p.title?`<p class="title">${escapeHtml(p.title)}</p>`:''}<div class="contact">${contact}</div></header><main>${blocks}</main><style>
.ledger-s6-launcher{position:fixed;right:18px;bottom:65px;z-index:1090;box-shadow:0 3px 12px #0003}.ledger-s6-overlay{position:fixed;inset:0;background:#000a;display:flex;align-items:center;justify-content:center;z-index:16000;padding:12px}.ledger-s6-dialog{width:min(950px,100%);max-height:95vh;overflow:auto;background:var(--surface,#fff);color:var(--ink,#222);border-radius:12px;padding:20px;line-height:1.5}.ledger-s6-dialog>header{display:flex;justify-content:space-between;align-items:center;gap:16px}.ledger-s6-dialog h2{margin:0}.ledger-s6-tabs{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0}.ledger-s6-tabs button{padding:8px 12px;border:1px solid #888;border-radius:8px;background:transparent;color:inherit;cursor:pointer}.ledger-s6-tabs button[aria-pressed=true]{outline:2px solid #1673d1}.ledger-s6-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.ledger-s6-dialog label{display:block;margin:9px 0}.ledger-s6-dialog input,.ledger-s6-dialog select,.ledger-s6-dialog textarea{display:block;width:100%;box-sizing:border-box;font:inherit;padding:8px;border:1px solid #888;border-radius:6px;background:var(--surface,#fff);color:inherit}.ledger-s6-dialog button:focus-visible,.ledger-s6-dialog input:focus-visible,.ledger-s6-dialog textarea:focus-visible,.ledger-s6-dialog select:focus-visible{outline:3px solid #1574f0;outline-offset:2px}.ledger-s6-records article{padding:10px 0;border-bottom:1px solid #bbb}.ledger-s6-records p{margin:4px 0}.ledger-s6-dialog #ledgerS6Message:not(:empty){padding:8px 0;font-weight:600}@media(max-width:600px){.ledger-s6-grid{grid-template-columns:1fr}.ledger-s6-dialog{padding:12px}.ledger-s6-launcher{right:8px;bottom:58px}}@media print{.ledger-s6-overlay,.ledger-s6-launcher{display:none!important}}
</style>
</body></html>`;
}
function printTextPdf(){
  closeModal();
  // The browser's native PDF backend keeps text selectable and performs actual
  // A4 pagination, unlike rasterized canvas-based libraries.
  const frame=document.createElement('iframe');
  frame.title='Ledger selectable-text CV print';
  frame.style.cssText='position:fixed;left:0;bottom:0;width:1px;height:1px;opacity:0;border:0;pointer-events:none';
  frame.srcdoc=buildTextCvHtml();document.body.appendChild(frame);
  let triggered=false;
  const print=()=>{
    if(triggered)return;triggered=true;
    try{
      frame.contentWindow.addEventListener('afterprint',()=>setTimeout(()=>frame.remove(),1000),{once:true});
      frame.contentWindow.focus();frame.contentWindow.print();
      showToast('Choose Save as PDF in the print dialog');
    }catch(err){console.error(err);showToast('Print blocked. Download the portable HTML CV and print it.');}
    // Browsers differ on afterprint; the fallback never interrupts an immediate print dialog.
    setTimeout(()=>frame.remove(),90000);
  };
  frame.addEventListener('load',()=>setTimeout(print,180),{once:true});
  setTimeout(print,900);
}
function downloadHtmlCv(){
  const html=buildTextCvHtml();
  const ok=downloadBlob(new Blob([html],{type:'text/html;charset=utf-8'}),escapePdfFilename()+'_CV.html');
  closeModal();if(ok)showToast('Accessible HTML CV downloaded');
}

function crc32(bytes){let table=crc32.table;if(!table){table=crc32.table=[];for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=(c&1)?(0xEDB88320^(c>>>1)):(c>>>1);table[n]=c>>>0;}}let c=0xFFFFFFFF;for(const b of bytes)c=table[(c^b)&255]^(c>>>8);return (c^0xFFFFFFFF)>>>0;}
function u16(n){return new Uint8Array([n&255,(n>>>8)&255]);} function u32(n){return new Uint8Array([n&255,(n>>>8)&255,(n>>>16)&255,(n>>>24)&255]);}
function concatBytes(parts){const len=parts.reduce((n,p)=>n+p.length,0),out=new Uint8Array(len);let o=0;parts.forEach(p=>{out.set(p,o);o+=p.length;});return out;}
function makeZip(files){
  const enc = new TextEncoder();
  const local = [];
  const central = [];
  let offset = 0;
  files.forEach(function(pair){
    const name = pair[0];
    const content = pair[1];
    const nb = enc.encode(name);
    // Ensure content is UTF-8 bytes
    const data = typeof content === 'string' ? enc.encode(content) : content;
    const crc = crc32(data);
    // Local file header (store / no compression)
    const head = concatBytes([
      u32(0x04034b50), // signature
      u16(20),         // version needed
      u16(0),          // flags
      u16(0),          // compression = store
      u16(0), u16(0),  // time, date
      u32(crc),
      u32(data.length),
      u32(data.length),
      u16(nb.length),
      u16(0),          // extra len
      nb,
      data
    ]);
    local.push(head);
    // Central directory header
    const ch = concatBytes([
      u32(0x02014b50),
      u16(20), u16(20),
      u16(0), u16(0),
      u16(0), u16(0),
      u32(crc),
      u32(data.length),
      u32(data.length),
      u16(nb.length),
      u16(0), u16(0), // extra, comment
      u16(0), u16(0), // disk, attrs
      u32(0),         // external attrs
      u32(offset),
      nb
    ]);
    central.push(ch);
    offset += head.length;
  });
  const cd = concatBytes(central);
  const body = concatBytes(local);
  const end = concatBytes([
    u32(0x06054b50),
    u16(0), u16(0),
    u16(files.length), u16(files.length),
    u32(cd.length),
    u32(body.length),
    u16(0)
  ]);
  return concatBytes([body, cd, end]);
}
function xmlEscape(str){
  return String(str==null?'':str)
    .replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g, '')
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;');
}
function docxHeading(text){ return `<w:p><w:pPr><w:pStyle w:val="LedgerHeading"/><w:keepNext/><w:keepLines/><w:spacing w:before="200" w:after="90"/><w:pBdr><w:bottom w:val="single" w:sz="4" w:space="2" w:color="AAB0B8"/></w:pBdr></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="21"/><w:caps/></w:rPr><w:t>${xmlEscape(text)}</w:t></w:r></w:p>`; }
function docxEntryHead(left,right){ return `<w:p><w:pPr><w:keepNext/><w:keepLines/><w:tabs><w:tab w:val="right" w:pos="9350"/></w:tabs><w:spacing w:before="110" w:after="30"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">${xmlEscape(left||'')}</w:t></w:r>${right?`<w:r><w:tab/><w:t>${xmlEscape(right)}</w:t></w:r>`:''}</w:p>`; }
function docxSub(text){ return text? `<w:p><w:pPr><w:keepNext/><w:spacing w:after="45"/></w:pPr><w:r><w:rPr><w:i/><w:color w:val="555555"/></w:rPr><w:t xml:space="preserve">${xmlEscape(text)}</w:t></w:r></w:p>` : ''; }
function docxBullet(text){ return text? `<w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="55"/></w:pPr><w:r><w:t xml:space="preserve">${xmlEscape(text)}</w:t></w:r></w:p>` : ''; }
function docxPara(text){ return text? `<w:p><w:pPr><w:spacing w:after="140"/></w:pPr><w:r><w:t xml:space="preserve">${xmlEscape(text)}</w:t></w:r></w:p>` : ''; }
function docxEntryDates(item){ return item.current ? (fmtMonth(item.start)+' – Present') : [fmtMonth(item.start),fmtMonth(item.end)].filter(Boolean).join(' – '); }
function renderDocxSection(id, doc){
  switch(id){
    case 'summary':
      if(!doc.summary) return '';
      return docxHeading('Summary') + docxPara(doc.summary);
    case 'experience':
      if(!doc.experience.length) return '';
      return docxHeading('Experience') + doc.experience.map(ex=>
        docxEntryHead((ex.title||'Role')+(ex.employer?' — '+ex.employer:''), docxEntryDates(ex)) +
        docxSub(ex.location||'') +
        stripHtmlForDocx(ex.description).map(docxBullet).join('')
      ).join('');
    case 'education':
      if(!doc.education.length) return '';
      return docxHeading('Education') + doc.education.map(ed=>
        docxEntryHead((ed.qualification||'')+(ed.field?', '+ed.field:''), docxEntryDates(ed)) +
        docxSub((ed.institution||'')+(ed.location?', '+ed.location:''))
      ).join('');
    case 'skills':
      if(!doc.skills.length) return '';
      return docxHeading('Skills') + docxPara(doc.skills.map(s=>s.name).join(' · '));
    case 'languages':
      if(!doc.languages.length) return '';
      return docxHeading('Languages') + docxPara(doc.languages.map(l=>l.name+' ('+l.level+')').join(' · '));
    case 'certifications':
      if(!doc.certifications.length) return '';
      return docxHeading('Certifications') + doc.certifications.map(c=>docxEntryHead(c.name, c.year||'') + docxSub(c.issuer||'')).join('');
    case 'projects':
      if(!doc.projects.length) return '';
      return docxHeading('Projects') + doc.projects.map(pr=>docxEntryHead(pr.name,'') + docxPara(pr.description||'')).join('');
    case 'accomplishments':
      if(!doc.accomplishments.length) return '';
      return docxHeading('Achievements') + doc.accomplishments.map(ac=>docxBullet((ac.category?ac.category+': ':'')+ac.text+(ac.impact?' ('+ac.impact+')':''))).join('');
    case 'hobbies':
      if(!doc.hobbies) return '';
      return docxHeading('Hobbies & Interests') + docxPara(doc.hobbies);
    case 'references':
      if(!doc.references) return '';
      return docxHeading('References') + docxPara(doc.references);
    default: return '';
  }
}
function downloadDocx(){
  try{
    const name=((state.document.personalInfo.firstName||'')+'_'+(state.document.personalInfo.lastName||'')).trim().replace(/[^\w\-]+/g,'_').replace(/^_|_$/g,'')||'ledger-cv';
    const d=state.document, p=d.personalInfo||{}, a=state.appearance, cfg=getTextExportSettings(a);
    const twips=mm=>Math.round(mm*1440/25.4);
    const paras=[];

    // Name
    const fullName = ((p.firstName||'')+' '+(p.lastName||'')).trim() || 'CV';
    paras.push('<w:p><w:pPr><w:jc w:val="center"/><w:spacing w:after="40"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr><w:t>'+xmlEscape(fullName)+'</w:t></w:r></w:p>');
    if(p.title){
      paras.push('<w:p><w:pPr><w:jc w:val="center"/><w:spacing w:after="60"/></w:pPr><w:r><w:rPr><w:sz w:val="22"/></w:rPr><w:t>'+xmlEscape(p.title)+'</w:t></w:r></w:p>');
    }
    const contactLine=[[p.city,p.postcode].filter(Boolean).join(' '),p.phone,p.email,p.linkedin,p.website].filter(Boolean).join('  |  ');
    if(contactLine){
      paras.push('<w:p><w:pPr><w:jc w:val="center"/><w:spacing w:after="200"/><w:pBdr><w:bottom w:val="single" w:sz="6" w:space="4" w:color="666666"/></w:pBdr></w:pPr><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>'+xmlEscape(contactLine)+'</w:t></w:r></w:p>');
    }

    const order = (a.sectionOrder||[]).filter(function(id){ return SECTION_META[id] && (SECTION_META[id].core || a.enabledSections[id]); });
    order.forEach(function(id){
      const block = renderDocxSection(id, d);
      if(block) paras.push(block);
    });
    (d.customSections||[]).forEach(function(cs){
      if(cs && cs.title) paras.push(docxHeading(cs.title) + docxPara(cs.content||''));
    });

    const bodyXml = paras.join('');
    const docXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'+
      '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'+
      '<w:body>'+bodyXml+
      '<w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="'+twips(cfg.margin[0])+'" w:right="'+twips(cfg.margin[1])+'" w:bottom="'+twips(cfg.margin[0])+'" w:left="'+twips(cfg.margin[1])+'"/></w:sectPr>'+
      '</w:body></w:document>';

    const stylesXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'+
      '<w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">'+
      '<w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/>'+
      '<w:qFormat/><w:pPr><w:widowControl/><w:spacing w:line="'+Math.round(cfg.leading*240)+'" w:lineRule="auto"/></w:pPr><w:rPr><w:rFonts w:ascii="'+cfg.wordFont+'" w:hAnsi="'+cfg.wordFont+'"/><w:sz w:val="'+Math.round(cfg.size*2)+'"/><w:szCs w:val="'+Math.round(cfg.size*2)+'"/></w:rPr></w:style>'+
      '<w:style w:type="paragraph" w:styleId="LedgerHeading"><w:name w:val="Ledger Section Heading"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:outlineLvl w:val="1"/></w:pPr></w:style>'+
      '</w:styles>';

    const types = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'+
      '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'+
      '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'+
      '<Default Extension="xml" ContentType="application/xml"/>'+
      '<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>'+
      '<Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/>'+ 
      '<Override PartName="/word/numbering.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.numbering+xml"/>'+
      '</Types>';

    const rels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'+
      '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'+
      '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>'+
      '</Relationships>';

    const wordRels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'+
      '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'+
      '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>'+ 
      '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/numbering" Target="numbering.xml"/>'+
      '</Relationships>';

    const numberingXml='<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'+
      '<w:numbering xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">'+
      '<w:abstractNum w:abstractNumId="0"><w:multiLevelType w:val="singleLevel"/>'+ 
      '<w:lvl w:ilvl="0"><w:start w:val="1"/><w:numFmt w:val="bullet"/><w:lvlText w:val="•"/>'+ 
      '<w:lvlJc w:val="left"/><w:pPr><w:tabs><w:tab w:val="num" w:pos="360"/></w:tabs><w:ind w:left="360" w:hanging="180"/></w:pPr>'+ 
      '<w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial"/></w:rPr></w:lvl></w:abstractNum>'+ 
      '<w:num w:numId="1"><w:abstractNumId w:val="0"/></w:num></w:numbering>';

    const zipBytes = makeZip([
      ['[Content_Types].xml', types],
      ['_rels/.rels', rels],
      ['word/document.xml', docXml],
      ['word/styles.xml', stylesXml],
      ['word/numbering.xml', numberingXml],
      ['word/_rels/document.xml.rels', wordRels]
    ]);

    const blob = new Blob([zipBytes], {type:'application/vnd.openxmlformats-officedocument.wordprocessingml.document'});
    const ok = downloadBlob(blob, name+'.docx');
    closeModal();
    if(ok) showToast('Word document downloaded — '+name+'.docx');
    else showToast('DOCX ready, but the browser blocked the download.');
  }catch(err){
    console.error('Ledger DOCX error', err);
    showToast('Could not create Word file. Try PDF instead.');
  }
}
function stripHtmlForDocx(html){return descriptionLines(html);}


/* ---------- text-binding inputs (avoid full re-render on keystroke) ---------- */
function bindTextInputs(root){
  root.querySelectorAll('[data-bind]').forEach(input=>{
    input.addEventListener('input', ()=>{
      const path = input.dataset.bind.split('.');
      let obj = state.document;
      for(let i=0;i<path.length-1;i++) obj = obj[path[i]];
      obj[path[path.length-1]] = input.value;
      input.closest('.field').classList.remove('error');
      saveState();
      const miniPreview = document.getElementById('miniPreviewMount');
    });
  });
}

/* ==========================================================================
   PER-SCREEN POST-RENDER WIRING
   ========================================================================== */
const SCREEN_AFTER_RENDER = {
  'home': ()=>{ wireHomeMotion(); },
  'upload': ()=>{
    const input=document.getElementById('importFile');
    if(input) input.addEventListener('change', ()=>{ if(input.files[0]) importCvFile(input.files[0]); });
  },
  'experience-level': ()=>{},
  'template-select': ()=>{},
  'personal-info': ()=>{
    bindTextInputs(document);
    wirePhotoUpload();
    document.querySelectorAll('[data-bind]').forEach(inp=>{
      inp.addEventListener('input', ()=>{
        const mount = document.querySelector('.wizard-body > div:last-child');
      });
    });
  },
  'work-experience': ()=>{wireEntryDraftAutosave();wireExperienceAutocomplete();},
  'education': ()=>{wireEntryDraftAutosave();},
  'skills': ()=>{
    const inp = document.getElementById('skillInput');
    if(inp){
      inp.addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); addSkillFromInput(); } });
    }
    wireSkillDrag();
  },
  'summary': ()=>{
    const ta = document.getElementById('summaryText');
    if(ta){
      ta.addEventListener('input', ()=>{
        state.document.summary = ta.value;
        document.getElementById('summaryCharCount').textContent = ta.value.length+' characters';
        saveState();
      });
    }
  },
  'additional-sections': ()=>{
    document.querySelectorAll('[data-action="rename-custom-section"]').forEach(inp=>{
      inp.addEventListener('input', ()=>{
        const cs = state.document.customSections.find(c=>c.id===inp.dataset.id);
        if(cs){ cs.title = inp.value; saveState(); }
      });
    });
    document.querySelectorAll('[data-action="edit-custom-section"]').forEach(ta=>{
      ta.addEventListener('input', ()=>{
        const cs = state.document.customSections.find(c=>c.id===ta.dataset.id);
        if(cs){ cs.content = ta.value; saveState(); }
      });
    });
  },
  'editor': ()=>{
    wireEditorInputs();
    wireEntryDraftAutosave();
    wireSkillDrag();
    wireSectionOrderDrag();
    wirePhotoUpload();
    wireLedgerReadyPreview();
  }
};

function wireEntryDraftAutosave(){
  // Persist in-progress entry edits on EVERY change, not only on Done.
  // The original is preserved as a saved cancel snapshot.
  for(const [selector,list,fieldAttr] of [['[data-exp-edit]','experience','expEdit'],['[data-edu-edit]','education','eduEdit']]){
    document.querySelectorAll(selector).forEach(card=>{
      const id=card.dataset[fieldAttr];const prefix=list==='experience'?'ex':'edu';
      const commit=()=>{
        const item=state.document[list].find(x=>x.id===id);if(!item)return;
        card.querySelectorAll('[data-'+prefix+'f]').forEach(input=>{
          const key=input.dataset[prefix+'f'];
          if(key==='description'){
            state.ui.activeDraftDescription=input.value;
            item.description=textToBulletsHtml(input.value);
          } else if(key==='current'){item.current=input.checked;}
          else item[key]=input.value;
        });
        if(item.current)item.end='';
        const end=card.querySelector('[data-'+prefix+'f="end"]');if(end)end.disabled=!!item.current;
        saveState();if(state.screen==='editor')refreshEditorPreviewOnly();
      };
      card.querySelectorAll('[data-'+prefix+'f]').forEach(input=>{
        input.addEventListener('input',commit);
        if(input.type==='checkbox'||input.type==='month')input.addEventListener('change',commit);
      });
    });
  }
}
function wireEditorInputs(){
  document.querySelectorAll('[data-ledger-personal]').forEach(input=>{
    input.addEventListener('input',()=>{
      const key=input.dataset.ledgerPersonal;
      if(!Object.prototype.hasOwnProperty.call(state.document.personalInfo,key))return;
      state.document.personalInfo[key]=input.value;
      input.setAttribute('aria-invalid',key==='email' && input.value.length>0 && !ledgerEmailValid(input.value)?'true':'false');
      saveState();refreshEditorPreviewOnly();
      const chip=document.querySelector('.ledger-review-count');
      if(chip)chip.textContent=ledgerCVReview(state.document).filter(x=>x.level==='action').length;
    });
  });
  const edSummary = document.getElementById('edSummary');
  if(edSummary) edSummary.addEventListener('input', ()=>{
    state.document.summary = edSummary.value; saveState();
    refreshEditorPreviewOnly();
  });
  const skillInput = document.getElementById('skillInput');
  if(skillInput) skillInput.addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); addSkillFromInput(); } });

  document.querySelectorAll('[data-simple-field]').forEach(ta=>{
    ta.addEventListener('input', ()=>{ state.document[ta.dataset.simpleField]=ta.value; saveState(); refreshEditorPreviewOnly(); });
  });
  document.querySelectorAll('[data-listf]').forEach(inp=>{
    inp.addEventListener('input', ()=>{
      const list = state.document[inp.dataset.listf];
      const item = list.find(x=>x.id===inp.dataset.id);
      if(item){ item[inp.dataset.sub]=inp.value; saveState(); refreshEditorPreviewOnly(); }
    });
  });

  const designTemplate = document.getElementById('designTemplate');
  if(designTemplate) designTemplate.addEventListener('change', ()=>{ state.appearance.template=designTemplate.value; saveState(); render();showToast('Design changed — all your content was preserved'); });
  const designFont = document.getElementById('designFont');
  if(designFont) designFont.addEventListener('change', ()=>{ state.appearance.font=designFont.value; saveState(); render(); });
  document.querySelectorAll('[data-cover-field]').forEach(input=>{
    input.addEventListener('input', ()=>{ state.coverLetter[input.dataset.coverField]=input.value; saveState(); });
  });
}

function refreshEditorPreviewOnly(){
  const wrap = document.getElementById('editorPreviewWrap');
  if(wrap){ wrap.innerHTML = renderFullPreview(); wireLedgerReadyPreview(); }
}

/* job-title autocomplete on the work-experience edit card */
function wireExperienceAutocomplete(){
  document.querySelectorAll('[data-exp-edit]').forEach(card=>{
    const expId = card.dataset.expEdit;
    const input = card.querySelector('[data-exf="title"]');
    const menu = card.querySelector('.autocomplete-menu');
    if(!input || !menu) return;
    let matches = [];
    let activeIndex = -1;

    function closeMenu(){ menu.hidden = true; menu.innerHTML=''; matches=[]; activeIndex=-1; }
    function paintActive(){
      menu.querySelectorAll('.autocomplete-item').forEach((it,i)=>it.classList.toggle('active', i===activeIndex));
    }
    function openMenu(list){
      matches = list; activeIndex = -1;
      if(list.length===0){
        menu.innerHTML = `<div class="autocomplete-empty">No matches — keep typing, your own title is fine too</div>`;
      } else {
        menu.innerHTML = list.map((m,i)=>`<button type="button" class="autocomplete-item" data-idx="${i}">${escapeHtml(m)}</button>`).join('');
      }
      menu.hidden = false;
    }
    function selectTitle(title){
      input.value = title;
      closeMenu();
      const item=state.document.experience.find(x=>x.id===expId);if(item){item.title=title;saveState();refreshEditorPreviewOnly();}
      const box = card.querySelector('.suggest-box');
      if(box) box.innerHTML = renderSuggestBoxHtml(title, expId);
      input.focus();
    }

    input.addEventListener('input', ()=>{
      const q = input.value;
      if(q.trim().length===0){ closeMenu(); return; }
      openMenu(cvEngine.searchJobTitles(q));
    });
    input.addEventListener('keydown', e=>{
      if(menu.hidden) return;
      if(e.key==='ArrowDown'){ e.preventDefault(); activeIndex = Math.min(activeIndex+1, matches.length-1); paintActive(); }
      else if(e.key==='ArrowUp'){ e.preventDefault(); activeIndex = Math.max(activeIndex-1, 0); paintActive(); }
      else if(e.key==='Enter'){ if(activeIndex>=0 && matches[activeIndex]){ e.preventDefault(); selectTitle(matches[activeIndex]); } }
      else if(e.key==='Escape'){ closeMenu(); }
    });
    // mousedown (not click) so the option registers before the input's blur fires
    menu.addEventListener('mousedown', e=>{
      const btn = e.target.closest('.autocomplete-item');
      if(!btn) return;
      e.preventDefault();
      selectTitle(matches[parseInt(btn.dataset.idx,10)]);
    });
    input.addEventListener('blur', ()=>{ setTimeout(closeMenu, 120); });
  });
}

/* drag-to-reorder: skills */
function wireSkillDrag(){
  const container = document.querySelector('.skill-chips');
  if(!container) return;
  let dragIdx=null;
  container.querySelectorAll('.skill-chip').forEach(chip=>{
    chip.addEventListener('dragstart', ()=>{ dragIdx = parseInt(chip.dataset.skillIndex,10); chip.classList.add('dragging'); });
    chip.addEventListener('dragend', ()=>{ chip.classList.remove('dragging'); });
    chip.addEventListener('dragover', e=>e.preventDefault());
    chip.addEventListener('drop', ()=>{
      const dropIdx = parseInt(chip.dataset.skillIndex,10);
      if(dragIdx===null || dragIdx===dropIdx) return;
      const arr = state.document.skills;
      const [moved] = arr.splice(dragIdx,1);
      arr.splice(dropIdx,0,moved);
      saveState(); render();
    });
  });
}

/* drag-to-reorder: section order list in editor design panel */
function wireSectionOrderDrag(){
  const list = document.getElementById('sectionOrderList');
  if(!list) return;
  let dragId=null;
  list.querySelectorAll('.section-order-item').forEach(item=>{
    item.addEventListener('dragstart', ()=>{ dragId=item.dataset.orderId; item.classList.add('dragging'); });
    item.addEventListener('dragend', ()=>{ item.classList.remove('dragging'); });
    item.addEventListener('dragover', e=>e.preventDefault());
    item.addEventListener('drop', ()=>{
      const dropId = item.dataset.orderId;
      if(!dragId || dragId===dropId) return;
      const order = state.appearance.sectionOrder;
      const from = order.indexOf(dragId), to = order.indexOf(dropId);
      order.splice(from,1); order.splice(to,0,dragId);
      saveState(); render();
    });
  });
}

/* ==========================================================================
   INIT
   ========================================================================== */

function wireHomeMotion(){
  const nav = document.getElementById('topnav');
  if(nav && nav.classList.contains('topnav-home')){
    const onScroll = ()=>{ nav.classList.toggle('is-scrolled', window.scrollY > 10); };
    onScroll();
    window.addEventListener('scroll', onScroll, {passive:true});
  }
  const tilt = document.getElementById('homeTilt');
  if(!tilt) return;
  let frame = 0;
  const apply = (x,y)=>{ tilt.style.transform = 'rotateX('+y+'deg) rotateY('+x+'deg)'; };
  tilt.addEventListener('pointermove', (e)=>{
    const r = tilt.getBoundingClientRect();
    const px = (e.clientX - r.left) / r.width - 0.5;
    const py = (e.clientY - r.top) / r.height - 0.5;
    if(frame) cancelAnimationFrame(frame);
    frame = requestAnimationFrame(()=> apply(px*9, py*-7));
  });
  tilt.addEventListener('pointerleave', ()=> apply(0,0));
}

attachDelegatedClicks();
// Quick navigation is delegated so it survives editor re-rendering.
document.addEventListener('change',event=>{
  if(!event.target || event.target.id!=='ledgerEditorQuickNav')return;
  const requested=event.target.value;
  if(state.screen!=='editor'||!EDITOR_PANELS.some(p=>p.id===requested))return;
  state.ui.editorPanel=requested;
  state.ui.editorView='edit';
  saveState();render();
  const panel=document.querySelector('.editor-panel');
  if(panel){panel.scrollIntoView({block:'nearest',behavior:'auto'});}
  const nav=document.getElementById('ledgerEditorQuickNav');if(nav)nav.focus();
});
// Shortcuts do not intercept text entry or native editor undo/redo.
document.addEventListener('keydown',event=>{
  if(state.screen!=='editor'||document.getElementById('modalOverlay')?.classList.contains('active'))return;
  const target=event.target;
  if(target && (target.closest('input,textarea,select,[contenteditable="true"]')))return;
  if((event.ctrlKey||event.metaKey) && !event.altKey && event.key.toLowerCase()==='z'){
    event.preventDefault();ledgerTravelHistory(event.shiftKey?'redo':'undo');return;
  }
  if((event.ctrlKey||event.metaKey) && !event.altKey && event.key.toLowerCase()==='y'){
    event.preventDefault();ledgerTravelHistory('redo');return;
  }
  if(event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && /^[1-6]$/.test(event.key)){
    const targetPanel=['personal','summary','experience','education','skills','review'][Number(event.key)-1];
    state.ui.editorPanel=targetPanel;state.ui.editorView='edit';
    saveState();render();
    document.querySelector('.editor-nav-item[aria-current="page"]')?.focus();
    event.preventDefault();
  }
});

/* STAGE 3 — offline documents and ATS workbench. Deliberately no networking, artificial
   experience, guessed ATS vendor compatibility, persistence of job advertisements, or APIs. */
let ledgerStage3Target={role:'',employer:'',description:''};
function ledgerStage3SafeText(value){return String(value==null?'':value).replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim();}
function ledgerStage3Text(doc){
  const d=doc||{},p=d.personalInfo||{},rows=[];
  const add=(x)=>{const v=ledgerStage3SafeText(x);if(v)rows.push(v);};
  add([p.firstName,p.lastName].filter(Boolean).join(' '));add(p.title);
  add([p.city,p.postcode,p.phone,p.email,p.linkedin,p.website].filter(Boolean).join(' | '));
  if(d.summary){rows.push('PROFESSIONAL SUMMARY');add(d.summary);}
  if(d.experience?.length){rows.push('EXPERIENCE');d.experience.forEach(x=>{add([x.title,x.employer,x.location].filter(Boolean).join(' | '));add([x.start,x.end|| (x.current?'Present':'')].filter(Boolean).join(' - ')); (descriptionLines(x.description||'')||[]).forEach(add);});}
  if(d.education?.length){rows.push('EDUCATION');d.education.forEach(x=>add([x.qualification,x.field,x.institution,x.location,x.start,x.end].filter(Boolean).join(' | ')));}
  if(d.skills?.length){rows.push('SKILLS');d.skills.forEach(x=>add(x.name));}
  if(d.certifications?.length){rows.push('CERTIFICATIONS');d.certifications.forEach(x=>add([x.name,x.issuer,x.year].filter(Boolean).join(' | ')));}
  if(d.projects?.length){rows.push('PROJECTS');d.projects.forEach(x=>add([x.name,x.description].filter(Boolean).join(' | ')));}
  if(d.languages?.length){rows.push('LANGUAGES');d.languages.forEach(x=>add([x.name,x.level].filter(Boolean).join(' | ')));}
  if(d.customSections?.length){d.customSections.forEach(x=>{add(x.title);add(x.content);});}
  return rows.join('\n')+'\n';
}
function ledgerStage3Terms(s){
  const stop=new Set('about above across after again also among and are based been before being below between both can company candidate candidates come current demonstrated description duties each excellent expected experience experienced field following for from have having include includes including into job jobs knowledge least looking more must need needs other our over person position preferred preferably prior professional provide proven required requirements responsibility responsibilities role roles should skills strong successful team than that the their them there these this through using very where which will with work working would years your able ability'.split(' '));
  const tokens=(String(s||'').toLowerCase().match(/[a-z][a-z0-9+#.-]{2,}/g)||[]).map(x=>x.replace(/[.\-]+$/,'')).filter(x=>x.length>2&&!stop.has(x));
  const freq=new Map();tokens.forEach(w=>freq.set(w,(freq.get(w)||0)+1));
  return Array.from(freq.entries()).sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0])).slice(0,30).map(x=>x[0]);
}
function ledgerStage3Assessment(){
  const description=ledgerStage3Target.description.trim(),plain=ledgerStage3Text(state.document);
  const tokens=ledgerStage3Terms(description);
  // Explicit boundaries eliminate substring matches (e.g. SQL vs NoSQL).
  const normalized=(' '+plain.toLowerCase().replace(/[^a-z0-9+#.]+/g,' ')+' ');
  const found=tokens.filter(t=>new RegExp('(^|[^a-z0-9+#])'+t.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'(?=$|[^a-z0-9+#])','i').test(normalized));
  const missing=tokens.filter(t=>!found.includes(t));
  const d=state.document,p=d.personalInfo||{};
  const checks=[
    ['Name supplied',!!([p.firstName,p.lastName].filter(Boolean).join(' ').trim())],
    ['Email supplied',!!String(p.email||'').trim()],
    ['Professional summary supplied',!!String(d.summary||'').trim()],
    ['Experience or substantive project evidence',!!((d.experience||[]).length||(d.projects||[]).length)],
    ['Skills populated',!!(d.skills||[]).length],
    ['Education populated',!!(d.education||[]).length],
    ['Plain-text export available',true],
  ];
  return {plain,tokens,found,missing,checks,coverage:tokens.length?Math.round(100*found.length/tokens.length):null};
}
function ledgerStage3Open(){
  if(state.screen!=='editor'){showToast('Open a CV in the editor first');return;}
  document.getElementById('ledgerStage3Dialog')?.remove();
  const root=document.createElement('div');root.id='ledgerStage3Dialog';root.className='ledger-stage3-backdrop';root.setAttribute('role','presentation');
  root.innerHTML=`<section class="ledger-stage3-dialog" role="dialog" aria-modal="true" aria-label="Documents and ATS workbench"><header class="ledger-stage3-header"><div><h2>Documents & ATS workbench</h2><p>Local analysis only · Evidence-based suggestions · No guaranteed ATS score</p></div><button type="button" id="ledgerStage3Close" class="btn btn-secondary">Close</button></header>
    <div class="ledger-stage3-body"><section><h3>Job description comparison</h3><label for="ledgerStage3Role">Target role</label><input id="ledgerStage3Role" maxlength="120" autocomplete="off" value="${escapeAttr(ledgerStage3Target.role)}"><label for="ledgerStage3Employer">Employer (optional)</label><input id="ledgerStage3Employer" maxlength="120" autocomplete="off" value="${escapeAttr(ledgerStage3Target.employer)}"><label for="ledgerStage3JD">Job description (paste from a job listing)</label><textarea id="ledgerStage3JD" rows="8" maxlength="30000" placeholder="Paste a real job description. Nothing is sent online.">${escapeHtml(ledgerStage3Target.description)}</textarea><div class="ledger-stage3-actions"><button class="btn btn-primary" id="ledgerStage3Analyze">Compare with my CV</button><button class="btn btn-secondary" id="ledgerStage3Clear">Clear job text</button></div></section>
    <section><h3>Document preparation</h3><p>This view checks whether information is present; it does not certify an external applicant-tracking system.</p><div id="ledgerStage3Results" aria-live="polite"></div><div class="ledger-stage3-actions"><button class="btn btn-secondary" id="ledgerStage3Txt">Download plain-text CV (.txt)</button><button class="btn btn-secondary" id="ledgerStage3Report">Download job-fit evidence report (.txt)</button><button class="btn btn-secondary" id="ledgerStage3HTML">Download readable HTML CV</button></div><p class="ledger-stage3-warning">Only include qualifications, experience and keywords you can substantiate. PDF export uses your browser’s native print-to-PDF dialog; DOCX uses the existing offline exporter.</p></section></div></section>`;
  document.body.appendChild(root);
  const $=id=>root.querySelector('#'+id);
  const update=()=>{ledgerStage3Target={role:$('ledgerStage3Role').value,employer:$('ledgerStage3Employer').value,description:$('ledgerStage3JD').value};ledgerStage3ShowAssessment();};
  root.addEventListener('click',event=>{if(event.target===root)root.remove();});
  $('ledgerStage3Close').onclick=()=>root.remove();
  $('ledgerStage3Analyze').onclick=update;
  $('ledgerStage3Clear').onclick=()=>{$('ledgerStage3Role').value='';$('ledgerStage3Employer').value='';$('ledgerStage3JD').value='';update();};
  $('ledgerStage3Txt').onclick=()=>ledgerStage3SaveText('CV.txt',ledgerStage3Text(state.document));
  $('ledgerStage3Report').onclick=()=>{update();ledgerStage3SaveText('Job_Fit_Evidence.txt',ledgerStage3Report());};
  $('ledgerStage3HTML').onclick=()=>downloadHtmlCv();
  root.onkeydown=event=>{if(event.key==='Escape'){event.stopPropagation();root.remove();document.getElementById('ledgerStage3Open')?.focus();}};
  ledgerStage3ShowAssessment();$('ledgerStage3Role').focus();
}
function ledgerStage3ShowAssessment(){
  const host=document.getElementById('ledgerStage3Results');if(!host)return;
  const a=ledgerStage3Assessment();
  const list=x=>x.length?x.map(t=>`<span class="ledger-stage3-chip">${escapeHtml(t)}</span>`).join(''):'<em>None</em>';
  host.innerHTML=`<h4>Readiness checklist</h4><ul>${a.checks.map(([name,ok])=>`<li>${ok?'✓':'○'} ${escapeHtml(name)}</li>`).join('')}</ul>`+
    (a.tokens.length?`<p><strong>Descriptive keyword overlap: ${a.coverage}%</strong> (${a.found.length}/${a.tokens.length} sampled terms). This is not an ATS score, a hiring prediction or proof of job suitability.</p><h4>Terms present in CV</h4><div>${list(a.found)}</div><h4>Terms to verify against your actual background</h4><div>${list(a.missing)}</div>`:'<p>Paste a job description and select Compare to examine exact-word overlap. No job terms have been inferred.</p>');
}
function ledgerStage3Report(){
  const a=ledgerStage3Assessment();return ['LEDGER CV STUDIO — LOCAL JOB-FIT EVIDENCE','Date: '+new Date().toISOString(),
   'Target role: '+ledgerStage3Target.role,'Employer: '+ledgerStage3Target.employer,
   'Description length: '+ledgerStage3Target.description.length+' characters',
   'Disclaimer: This report is heuristic word overlap, not an ATS grade, hiring forecast or verification of qualifications.',
   'Keyword overlap: '+(a.coverage===null?'Not measured':a.coverage+'% ('+a.found.length+'/'+a.tokens.length+')'),
   'Terms present: '+(a.found.join(', ')||'None'),'Terms not present: '+(a.missing.join(', ')||'None'),
   'Readiness: ',...a.checks.map(x=>(x[1]?'[x] ':'[ ] ')+x[0]),
   'Only add claims supported by your own real experience.','\nJOB DESCRIPTION (source material supplied by user):',ledgerStage3Target.description].join('\n')+'\n';
}
function ledgerStage3SaveText(filename,text){
  const ok=downloadBlob(new Blob([text],{type:'text/plain;charset=utf-8'}),filename);
  if(ok)showToast('Document exported locally');
}

window.addEventListener('beforeunload',event=>{
  if(ledgerWriteIssue && ledgerWriteIssue!=='corrupt'){event.preventDefault();event.returnValue='';}
});
window.addEventListener('storage',event=>{
  if(event.key!==STORAGE_KEY && event.key!==null)return;
  if(event.newValue!==ledgerLastSavedRaw){markSaveIssue('conflict');}
});
render();

// Stage 4: beta/release-preparation aids. Never interpret a user checkbox as a verified test.
const ledgerS4AcceptanceItems=[
  ['chrome','Chrome desktop: save, restart and restore'],
  ['edge','Edge desktop: save, restart and restore'],
  ['firefox','Firefox desktop: editing, downloads and restore'],
  ['safari','Safari desktop: editing, downloads and restore'],
  ['android','Android: mobile layout, editing and download'],
  ['ios','iOS: mobile layout, editing and download'],
  ['two-tabs','Two-tab conflict detection and safe recovery'],
  ['quota','Storage denial, quota-full and damaged-primary recovery'],
  ['backup','Backup export and restore round-trip'],
  ['docx','DOCX file opened and inspected in compatible viewer'],
  ['pdf','Print-to-PDF inspected for page breaks and text'],
  ['a11y','Keyboard and assistive-technology navigation'],
  ['offline','App re-opened offline from local HTML file'],
  ['privacy','Privacy and exported file contents inspected'],
  ['performance','Low-resource device performance and large CVs']
];
function ledgerS4Environment(){
  const data={
    timestamp:new Date().toISOString(),
    app:'Ledger CV Studio',stage:'Stage 4 development — not accepted',
    protocol:location.protocol,
    onlineFlag:navigator.onLine===true?'online flag':navigator.onLine===false?'offline flag':'unknown',
    storage:'not checked',sessionStorage:'not checked',
    saveIssue:ledgerWriteIssue||'none reported',
    versions:Array.isArray(state.versions)?state.versions.length:0,
    activeCV:!!state.document,
    supportedExports:['TXT','HTML','DOCX','print-to-PDF','project JSON backup'],
    fullBrowserAcceptance:'DEFERRED',
    platform:'not collected (privacy by design)'
  };
  // Probe only a separate ephemeral key. Never alter the CV's primary storage.
  try{const key='ledger_s4_probe_'+Math.random().toString(36).slice(2);localStorage.setItem(key,'ok');data.storage=localStorage.getItem(key)==='ok'?'write/read verified now':'readback failed';localStorage.removeItem(key);}
  catch(e){data.storage='unavailable: '+(e&&e.name||'error');}
  try{const key='ledger_s4_session_probe';sessionStorage.setItem(key,'ok');data.sessionStorage=sessionStorage.getItem(key)==='ok'?'write/read verified now':'readback failed';sessionStorage.removeItem(key);}
  catch(e){data.sessionStorage='unavailable: '+(e&&e.name||'error');}
  return data;
}
function ledgerS4Report(){
  const report=ledgerS4Environment();
  return ['LEDGER CV STUDIO — LOCAL RELEASE-PREPARATION DIAGNOSTICS',
    'This is a development diagnostic, NOT evidence of release acceptance.',
    'No CV content, name, email, job description, or user-agent string is included.',
    ...Object.entries(report).map(([k,v])=>k+': '+(Array.isArray(v)?v.join(', '):v)),
    'Deferred real-device checks:',...ledgerS4AcceptanceItems.map(([id,label])=>'[NOT VERIFIED] '+label),
    'Release decision: NO-GO until independent acceptance and owner authorization.'].join('\n')+'\n';
}
function ledgerS4Open(){
  document.getElementById('ledgerS4Dialog')?.remove();
  const prior=document.activeElement;
  const root=document.createElement('div');root.className='ledger-s4-backdrop';root.id='ledgerS4Dialog';
  root.innerHTML=`<section class="ledger-s4-panel" role="dialog" aria-modal="true" aria-labelledby="ledgerS4Title">
   <header class="ledger-s4-head"><div><h2 id="ledgerS4Title">Beta & release preparation</h2><p>Private, offline readiness tools · No publication or deployment</p></div><button class="btn btn-secondary" id="ledgerS4Close" type="button">Close</button></header>
   <p class="ledger-s4-status" role="status">Development preview — NOT tested, accepted, or approved for production use.</p>
   <div class="ledger-s4-grid"><section><h3>Local diagnostics</h3><p>These checks are informational and do not test browser restart, export correctness, or recovery.</p>
    <table><tbody id="ledgerS4Diagnostics"></tbody></table><div class="ledger-s4-actions"><button class="btn btn-secondary" id="ledgerS4Refresh" type="button">Refresh diagnostics</button><button class="btn btn-secondary" id="ledgerS4Report" type="button">Download privacy-safe report</button></div>
    <h3>Protect your work</h3><p>Download a project backup before testing unfamiliar builds or clearing browser data. Treat the JSON as sensitive personal data.</p><div class="ledger-s4-actions"><button class="btn btn-primary" id="ledgerS4Backup" type="button">Download full project backup</button></div>
    <small>Local browser storage is device/browser-specific and can be deleted by privacy settings. The standalone HTML is not itself a backup of your CVs.</small></section>
    <section><h3>Deferred acceptance checklist</h3><p>Checklist below is a planning reference only. Ticking boxes does not establish test evidence or release approval.</p>
    <div id="ledgerS4Checklist"></div><p id="ledgerS4Count" aria-live="polite"></p><div class="ledger-s4-actions"><button class="btn btn-secondary" id="ledgerS4Reset" type="button">Clear local checklist</button></div>
    <small>Formal sign-off requires reproducible test results and external evidence. This checklist is intentionally ephemeral and resets on reload.</small></section></div>
   <p><strong>Release rule:</strong> Keep Stage 4 in development-only status until cross-browser, real-device, data-recovery, document-output and accessibility checks are signed off. No cloud, analytics, remote services, or payments are introduced.</p></section>`;
  document.body.appendChild(root);
  const refresh=()=>{const d=ledgerS4Environment();const fields=[['Document mode',d.protocol],['Browser connectivity flag',d.onlineFlag],['CV local storage probe',d.storage],['Session storage probe',d.sessionStorage],['CV write warning',d.saveIssue],['CV versions',d.versions],['Acceptance',d.fullBrowserAcceptance]];
    document.getElementById('ledgerS4Diagnostics').innerHTML=fields.map(([k,v])=>`<tr><th scope="row">${escapeHtml(String(k))}</th><td>${escapeHtml(String(v))}</td></tr>`).join('');};
  const checklist=document.getElementById('ledgerS4Checklist');
  ledgerS4AcceptanceItems.forEach(([id,label])=>{const row=document.createElement('label');const input=document.createElement('input');input.type='checkbox';input.dataset.check=id;row.append(input,document.createTextNode(label));checklist.appendChild(row);});
  const count=()=>{document.getElementById('ledgerS4Count').textContent=checklist.querySelectorAll('input:checked').length+'/'+ledgerS4AcceptanceItems.length+' marked for planning (0 formally verified here)';};
  checklist.addEventListener('change',count);
  document.getElementById('ledgerS4Reset').onclick=()=>{checklist.querySelectorAll('input').forEach(x=>x.checked=false);count();};
  document.getElementById('ledgerS4Refresh').onclick=refresh;
  document.getElementById('ledgerS4Report').onclick=()=>{if(downloadBlob(new Blob([ledgerS4Report()],{type:'text/plain;charset=utf-8'}),'ledger-stage4-local-diagnostics.txt'))showToast('Local diagnostics prepared');};
  document.getElementById('ledgerS4Backup').onclick=()=>{try{downloadProjectBackup();}catch(e){showToast('Backup unavailable — do not clear browser data');}};
  const close=()=>{root.remove();if(prior?.isConnected)prior.focus();};
  document.getElementById('ledgerS4Close').onclick=close;
  root.addEventListener('keydown',e=>{if(e.key==='Escape'){e.preventDefault();close();}if(e.key==='Tab'){
    const focusable=[...root.querySelectorAll('button,input')].filter(el=>!el.disabled);
    if(!focusable.length)return;const first=focusable[0],last=focusable[focusable.length-1];
    if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}
    else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}
  }});
  refresh();count();document.getElementById('ledgerS4Close').focus();
}

/* ===== Stage 5: offline evidence-grounded career intelligence =====
   This is a transparent rule-based assistant, not a downloaded or remote language model.
   No profile content is sent to any network service. User review is mandatory.
*/
const ledgerS5StopWords = new Set('the and for with from that this your will have are you our but not can into has all more their must should work working experience skills knowledge ability role position company team preferred required candidate responsibilities qualifications duties including using through years year good strong excellent ability able about some such these within professional'.split(' '));
function ledgerS5Terms(raw,limit=18){
  const text=String(raw||'').toLowerCase().slice(0,18000);
  const counts=new Map();
  for(const token of (text.match(/[a-z][a-z0-9+#.-]{2,}/g)||[])){
    if(ledgerS5StopWords.has(token)||/^\d/.test(token))continue;
    counts.set(token,(counts.get(token)||0)+1);
  }
  return [...counts].sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0])).slice(0,limit).map(([term,count])=>({term,count}));
}
function ledgerS5Evidence(doc){
  const out=[];
  const put=(section,label,value)=>{const text=String(value||'').replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim();if(text)out.push({section,label,text:text.slice(0,1000)});};
  put('Profile','Professional title',doc.personalInfo?.title);
  put('Profile','Summary',doc.summary);
  (doc.skills||[]).forEach((x,i)=>put('Skills','Skill '+(i+1),typeof x==='string'?x:x.name));
  (doc.experience||[]).forEach((x,i)=>{put('Experience','Role '+(i+1),[x.title,x.employer].filter(Boolean).join(' — '));put('Experience','Role '+(i+1)+' details',typeof stripHtmlForEdit==='function'?stripHtmlForEdit(x.description||''):x.description);});
  (doc.education||[]).forEach((x,i)=>put('Education','Qualification '+(i+1),[x.qualification,x.field,x.institution].filter(Boolean).join(' — ')));
  (doc.certifications||[]).forEach((x,i)=>put('Certifications','Certification '+(i+1),x.name));
  return out;
}
function ledgerS5Analyze(description,doc){
  const terms=ledgerS5Terms(description);
  const evidence=ledgerS5Evidence(doc);
  const matches=terms.map(({term,count})=>{
    const citations=evidence.filter(e=>new RegExp('(^|[^a-z0-9])'+term.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'([^a-z0-9]|$)','i').test(e.text));
    return {term,count,evidence:citations.slice(0,4)};
  });
  return {matches,evidenceCount:evidence.length,covered:matches.filter(x=>x.evidence.length).length};
}
function ledgerS5Open(){
  document.getElementById('ledgerS5Dialog')?.remove();
  const prior=document.activeElement;
  const root=document.createElement('div');root.className='ledger-s5-backdrop';root.id='ledgerS5Dialog';
  root.innerHTML=`<section class="ledger-s5-panel" role="dialog" aria-modal="true" aria-labelledby="ledgerS5Title">
    <header class="ledger-s5-header"><div><h2 id="ledgerS5Title">Career intelligence · offline</h2><p>Evidence-linked role analysis and writing guidance</p></div><button class="btn btn-secondary" id="ledgerS5Close" type="button">Close</button></header>
    <p class="ledger-s5-notice">Development preview — heuristic analysis, not a generative AI model, ATS certification, or hiring prediction. Never add a claim without verifying it.</p>
    <label for="ledgerS5Job">Paste a target job description (processed in memory only)</label>
    <textarea id="ledgerS5Job" rows="6" maxlength="18000" placeholder="Paste the duties and requirements for a job you're considering"></textarea>
    <div class="ledger-s5-actions"><button type="button" class="btn btn-primary" id="ledgerS5Run">Analyze supporting evidence</button><button type="button" class="btn btn-secondary" id="ledgerS5Export" disabled>Export analysis (.txt)</button></div>
    <div id="ledgerS5Results" aria-live="polite"><p>No job description analyzed. Your existing CV is never rewritten automatically.</p></div>
    <p class="ledger-s5-foot">Privacy: Nothing is uploaded; job text is not saved in CV storage. Closing this panel clears the pasted description. Inspect recommendations before editing your CV.</p>
  </section>`;
  document.body.appendChild(root);
  let exportText='';
  const close=()=>{root.remove();exportText='';if(prior?.isConnected)prior.focus();};
  root.querySelector('#ledgerS5Close').onclick=close;
  root.addEventListener('keydown',e=>{if(e.key==='Escape'){e.preventDefault();close();}if(e.key==='Tab'){
    const items=[...root.querySelectorAll('button:not([disabled]),textarea')];
    if(e.shiftKey&&document.activeElement===items[0]){e.preventDefault();items[items.length-1].focus();}
    else if(!e.shiftKey&&document.activeElement===items[items.length-1]){e.preventDefault();items[0].focus();}
  }});
  root.querySelector('#ledgerS5Run').onclick=()=>{
    const job=root.querySelector('#ledgerS5Job').value.trim();
    const area=root.querySelector('#ledgerS5Results'),exp=root.querySelector('#ledgerS5Export');
    exp.disabled=true;exportText='';
    if(job.length<80){area.textContent='Please provide at least 80 characters of real job requirements for a meaningful comparison.';return;}
    const analysis=ledgerS5Analyze(job,state.document||{});
    const rows=analysis.matches;
    if(!rows.length){area.textContent='No meaningful terms could be extracted. Try a longer description with specific duties and skills.';return;}
    const matched=rows.filter(x=>x.evidence.length),missing=rows.filter(x=>!x.evidence.length);
    const guidance=[
      'For each matching requirement, check the cited CV evidence and strengthen wording only when accurate.',
      'For each uncovered term, first decide whether you genuinely have that skill or experience; never fabricate it.',
      'Add measurable outcomes only if you can substantiate the numbers.',
      'Tailor your summary to the actual target role without changing dates, employers, qualifications, or achievements.'
    ];
    const renderGroup=(items)=>items.length?`<ul>${items.map(x=>`<li><strong>${escapeHtml(x.term)}</strong> · ${x.count} mention(s) in job${x.evidence.length?`<ul>${x.evidence.map(ev=>`<li><small>${escapeHtml(ev.section)} — ${escapeHtml(ev.label)}:</small> ${escapeHtml(ev.text.slice(0,180))}</li>`).join('')}</ul>`:' · no direct CV evidence located'}</li>`).join('')}</ul>`:'<p>None in the selected high-frequency terms.</p>';
    area.innerHTML=`<h3>Evidence map</h3><p>${matched.length} of ${rows.length} prominent terms have literal support in your current CV; this is not a job-fit score. ${analysis.evidenceCount} CV evidence entries inspected.</p><div class="ledger-s5-columns"><section><h4>Supported terms</h4>${renderGroup(matched)}</section><section><h4>Review gaps</h4>${renderGroup(missing)}</section></div><h3>Grounded writing guidance</h3><ol>${guidance.map(g=>`<li>${escapeHtml(g)}</li>`).join('')}</ol>`;
    exportText=['Ledger CV Studio — Stage 5 offline evidence review','Not an ATS score or hiring prediction. Verify every statement.','',`Supported prominent terms: ${matched.length}/${rows.length}`,...rows.flatMap(x=>[`${x.evidence.length?'SUPPORTED':'UNCONFIRMED'}: ${x.term} (job mentions ${x.count})`,...x.evidence.map(e=>`  Source: ${e.section} / ${e.label}: ${e.text.slice(0,180)}`)]),'','Guidance:',...guidance.map((g,i)=>`${i+1}. ${g}`)].join('\n');
    exp.disabled=false;
  };
  root.querySelector('#ledgerS5Export').onclick=()=>{if(exportText)downloadBlob(new Blob([exportText],{type:'text/plain;charset=utf-8'}),'ledger-stage5-evidence-review.txt');};
  root.querySelector('#ledgerS5Job').focus();
}
function ledgerS5Mount(){
 if(document.getElementById('ledgerS5Launcher'))return;
 const launcher=document.createElement('button');launcher.id='ledgerS5Launcher';launcher.type='button';launcher.className='btn btn-primary ledger-s5-launcher';launcher.textContent='Career intelligence';launcher.setAttribute('aria-label','Open offline career intelligence');launcher.onclick=ledgerS5Open;document.body.appendChild(launcher);
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ledgerS5Mount,{once:true});else ledgerS5Mount();


/* Stage 6: offline career toolkit. Application records are independent of CV autosave. */
const ledgerS6Key='ledger_cv_stage6_applications_v1';
const ledgerS6Statuses=['Saved','Applied','Interview','Offer','Rejected','Withdrawn'];
function ledgerS6Validate(raw){
 if(!Array.isArray(raw)||raw.length>300)throw Error('Invalid application count');
 const ids=new Set();return raw.map(x=>{
  if(!x||typeof x!=='object'||typeof x.id!=='string'||!/^[a-zA-Z0-9_-]{8,80}$/.test(x.id)||ids.has(x.id))throw Error('Invalid application identifier');ids.add(x.id);
  const obj={id:x.id};for(const k of ['company','role','location','url','notes','date','status']){
   if(typeof x[k]!=='string'||x[k].length>(k==='notes'?3000:k==='url'?1000:200))throw Error('Invalid '+k);obj[k]=x[k];
  }
  if(!ledgerS6Statuses.includes(obj.status))throw Error('Invalid status');
  if(obj.date&&!/^\d{4}-\d{2}-\d{2}$/.test(obj.date))throw Error('Invalid date');
  if(obj.url&&!/^https?:\/\//i.test(obj.url))throw Error('Invalid link');
  return obj;
 });
}
function ledgerS6Read(){
 try{const v=localStorage.getItem(ledgerS6Key);return v===null?[]:ledgerS6Validate(JSON.parse(v));}
 catch(e){throw Error('Application tracker data cannot be read safely. Nothing was overwritten. '+e.message);}
}
function ledgerS6Write(next,expected){
 const current=localStorage.getItem(ledgerS6Key);
 if(current!==expected)throw Error('Application data changed in another tab. Reopen the toolkit before saving.');
 const clean=ledgerS6Validate(next);
 localStorage.setItem(ledgerS6Key,JSON.stringify(clean));
 if(localStorage.getItem(ledgerS6Key)!==JSON.stringify(clean))throw Error('Storage did not retain the new records.');
 return clean;
}
function ledgerS6Safe(v){return escapeHtml(String(v??''));}
function ledgerS6Download(name,content,type='text/plain;charset=utf-8'){
 downloadBlob(new Blob([content],{type}),name);
}
function ledgerS6Csv(rows){
 const cols=['company','role','location','status','date','url','notes'];
 const q=v=>'"'+String(v??'').replace(/^[=+@\-\t\r]/,v=>'\''+v).replace(/"/g,'""')+'"';
 return '\uFEFF'+[cols.join(','),...rows.map(x=>cols.map(c=>q(x[c])).join(','))].join('\r\n');
}
function ledgerS6Cover(doc,company,role){
 const p=doc?.personalInfo||{};
 const name=[p.fullName,p.name].find(x=>typeof x==='string'&&x.trim())||'[Your name]';
 const summary=String(doc?.summary||'').replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim();
 const skills=(doc?.skills||[]).slice(0,8).map(x=>typeof x==='string'?x:x?.name).filter(Boolean);
 return `${name}\n\nDear Hiring Team,\n\nI am writing to express my interest in the ${role||'[position]'} role at ${company||'[company]'}.\n\n${summary?`My professional background includes: ${summary.slice(0,420)}\n\n`:'[Add a short, verified description of your relevant experience.]\n\n'}${skills.length?`My CV lists experience or skills in ${skills.join(', ')}. I would welcome the opportunity to explain how these relate to your team’s needs.\n\n`:''}I would appreciate the opportunity to discuss the position. Thank you for considering my application.\n\nSincerely,\n${name}\n\nREVIEW BEFORE SENDING: Verify every claim, tailor to the job, and remove placeholders.`;
}
function ledgerS6Interview(doc,role){
 const exp=(doc?.experience||[]).slice(0,3);
 const questions=[`Why are you interested in ${role||'this role'}?`,'Tell me about yourself and your most relevant experience.','Describe a challenge you faced, what you did, and the measurable result.','Which requirements can you demonstrate with real examples?','What skills do you still need to develop?','What questions would you like to ask the interviewer?'];
 return ['Interview preparation worksheet (offline)','Use only truthful examples. Draft and rehearse your own answers.','',...questions.flatMap((q,i)=>[`${i+1}. ${q}`,'Evidence / answer: ________________________','']),`CV experience entries available for examples: ${exp.length}`,...exp.map((x,i)=>`${i+1}. ${[x.title,x.employer].filter(Boolean).join(' — ')}`)].join('\n');
}
function ledgerS6Open(){
 document.getElementById('ledgerS6Overlay')?.remove();const previous=document.activeElement;
 const overlay=document.createElement('div');overlay.id='ledgerS6Overlay';overlay.className='ledger-s6-overlay';
 overlay.innerHTML=`<section class="ledger-s6-dialog" role="dialog" aria-modal="true" aria-labelledby="ledgerS6Title"><header><h2 id="ledgerS6Title">Career toolkit · offline</h2><button type="button" class="btn btn-secondary" id="ledgerS6Close">Close</button></header><p>Track applications locally, prepare a reviewable cover-letter draft, and create an interview worksheet. No online account or AI service.</p>
 <div class="ledger-s6-tabs" role="group" aria-label="Toolkit sections"><button type="button" data-tab="track">Applications</button><button type="button" data-tab="cover">Cover letter</button><button type="button" data-tab="interview">Interview prep</button></div>
 <div id="ledgerS6Message" role="status" aria-live="polite"></div><div id="ledgerS6Body"></div></section>`;
 document.body.appendChild(overlay);
 const body=overlay.querySelector('#ledgerS6Body'),msg=overlay.querySelector('#ledgerS6Message');let rows=[],raw=null;
 const say=(x)=>{msg.textContent=x};
 const load=()=>{raw=localStorage.getItem(ledgerS6Key);rows=ledgerS6Read()};
 const close=()=>{overlay.remove();if(previous?.isConnected)previous.focus()};
 overlay.querySelector('#ledgerS6Close').onclick=close;
 overlay.addEventListener('keydown',e=>{if(e.key==='Escape'){e.preventDefault();close()}if(e.key==='Tab'){const items=[...overlay.querySelectorAll('button:not(:disabled),input:not(:disabled),textarea:not(:disabled),select:not(:disabled)')].filter(el=>el.offsetParent!==null);if(!items.length)return;if(e.shiftKey&&document.activeElement===items[0]){e.preventDefault();items.at(-1).focus()}else if(!e.shiftKey&&document.activeElement===items.at(-1)){e.preventDefault();items[0].focus()}}});
 function track(){say('');try{load()}catch(err){body.innerHTML='<p role="alert">'+ledgerS6Safe(err.message)+'</p>';return}
  body.innerHTML=`<h3>Applications (${rows.length}/300)</h3><form id="ledgerS6Form"><div class="ledger-s6-grid"><label>Company <input name="company" maxlength="200" required></label><label>Role <input name="role" maxlength="200" required></label><label>Location <input name="location" maxlength="200" placeholder="City, country or remote"></label><label>Date <input name="date" type="date"></label><label>Status <select name="status">${ledgerS6Statuses.map(v=>`<option>${v}</option>`).join('')}</select></label><label>Job URL <input name="url" type="url" maxlength="1000" placeholder="https://..."></label></div><label>Notes <textarea name="notes" rows="2" maxlength="3000"></textarea></label><button type="submit" class="btn btn-primary">Save application</button> <button id="ledgerS6Csv" type="button" class="btn btn-secondary">Export applications CSV</button> <button id="ledgerS6Json" type="button" class="btn btn-secondary">Backup tracker JSON</button></form><div class="ledger-s6-records">${rows.map(x=>`<article><strong>${ledgerS6Safe(x.company)}</strong> · ${ledgerS6Safe(x.role)} <span>${ledgerS6Safe(x.status)}</span><p>${ledgerS6Safe(x.location)} ${ledgerS6Safe(x.date)}</p><button type="button" data-id="${x.id}" data-action="advance" class="btn btn-secondary">Update status</button> <button type="button" data-id="${x.id}" data-action="delete" class="btn btn-secondary">Delete</button></article>`).join('')||'<p>No applications recorded.</p>'}</div><p>Applications are stored separately from the CV project backup. Export the tracker JSON before clearing browser data.</p>`;
  body.querySelector('#ledgerS6Form').onsubmit=e=>{e.preventDefault();const d=new FormData(e.target);try{const id='app_'+(crypto.randomUUID?crypto.randomUUID():Date.now()+'_'+Math.random().toString(36).slice(2)).replace(/[^a-zA-Z0-9_-]/g,'');const entry={id,...Object.fromEntries(['company','role','location','date','status','url','notes'].map(k=>[k,String(d.get(k)||'').trim()]))};if(!entry.company||!entry.role)throw Error('Company and role are required');ledgerS6Write([...rows,entry],raw);track();say('Application saved locally.')}catch(err){say('Not saved: '+err.message)}};
  body.querySelector('#ledgerS6Csv').onclick=()=>ledgerS6Download('ledger-applications.csv',ledgerS6Csv(rows),'text/csv;charset=utf-8');
  body.querySelector('#ledgerS6Json').onclick=()=>ledgerS6Download('ledger-applications-backup.json',JSON.stringify({format:'ledger-stage6-applications',version:1,records:rows},null,2),'application/json;charset=utf-8');
  body.querySelectorAll('button[data-id]').forEach(b=>b.onclick=()=>{const index=rows.findIndex(x=>x.id===b.dataset.id);if(index<0)return;const entry=rows[index];try{let updated;if(b.dataset.action==='delete'){if(!confirm('Delete this application record?'))return;updated=rows.filter(x=>x.id!==entry.id)}else{const select=prompt('New status: '+ledgerS6Statuses.join(', '),entry.status);if(select===null)return;if(!ledgerS6Statuses.includes(select))throw Error('Select a listed status');updated=rows.map(x=>x.id===entry.id?{...x,status:select}:x)}ledgerS6Write(updated,raw);track();say('Tracker updated.')}catch(err){say('Not saved: '+err.message)}});
 }
 function writing(kind){say('');const isCover=kind==='cover';body.innerHTML=`<h3>${isCover?'Reviewable cover-letter draft':'Interview preparation worksheet'}</h3><p>These materials only reference your current CV. Confirm accuracy and customize before use.</p>${isCover?'<label>Employer <input id="ledgerS6Company" maxlength="200"></label>':''}<label>Target role <input id="ledgerS6Role" maxlength="200"></label><button type="button" class="btn btn-primary" id="ledgerS6Generate">Create draft</button><label for="ledgerS6Draft">Editable output</label><textarea id="ledgerS6Draft" rows="13" maxlength="15000" placeholder="Generate a draft first"></textarea><button type="button" class="btn btn-secondary" id="ledgerS6Download">Export reviewed text</button>`;
  body.querySelector('#ledgerS6Generate').onclick=()=>{const role=body.querySelector('#ledgerS6Role').value.trim();body.querySelector('#ledgerS6Draft').value=isCover?ledgerS6Cover(state.document||{},body.querySelector('#ledgerS6Company').value.trim(),role):ledgerS6Interview(state.document||{},role)};
  body.querySelector('#ledgerS6Download').onclick=()=>{const output=body.querySelector('#ledgerS6Draft').value.trim();if(!output){say('Create or enter text before export.');return}ledgerS6Download(isCover?'ledger-cover-letter-draft.txt':'ledger-interview-preparation.txt',output)};
 }
 overlay.querySelectorAll('[data-tab]').forEach(btn=>btn.onclick=()=>{overlay.querySelectorAll('[data-tab]').forEach(b=>b.setAttribute('aria-pressed',String(b===btn)));if(btn.dataset.tab==='track')track();else writing(btn.dataset.tab)});
 overlay.querySelector('[data-tab="track"]').click();overlay.querySelector('#ledgerS6Close').focus();
}
function ledgerS6Mount(){if(document.getElementById('ledgerS6Launcher'))return;const b=document.createElement('button');b.id='ledgerS6Launcher';b.type='button';b.className='btn btn-secondary ledger-s6-launcher';b.textContent='Career toolkit';b.onclick=ledgerS6Open;document.body.appendChild(b)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ledgerS6Mount,{once:true});else ledgerS6Mount();


/* Stage 7: opt-in encrypted portability foundation, no network capability. */
const ledgerS7Keys=['ledger_cv_state_v2','ledger_cv_recovery_v24','ledger_cv_stage6_applications_v1'];
const ledgerS7Format='ledger-stage7-encrypted-transfer';
const ledgerS7Limits={entry:4*1024*1024,total:8*1024*1024,file:12*1024*1024};
function ledgerS7Encode(bytes){let r='';for(let i=0;i<bytes.length;i+=0x8000)r+=String.fromCharCode(...bytes.subarray(i,i+0x8000));return btoa(r)}
function ledgerS7Decode(value){if(typeof value!=='string'||!/^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value))throw Error('Invalid encoded transfer data');const bin=atob(value);return Uint8Array.from(bin,c=>c.charCodeAt(0))}
function ledgerS7Crypto(){if(!globalThis.crypto?.subtle||!crypto.getRandomValues)throw Error('Browser encryption is unavailable in this context. Use a browser with Web Crypto support. No unencrypted transfer was created.');return crypto.subtle}
async function ledgerS7Key(pass,salt){if(typeof pass!=='string'||pass.length<12||pass.length>256)throw Error('Passphrase must be 12–256 characters');const subtle=ledgerS7Crypto();const source=await subtle.importKey('raw',new TextEncoder().encode(pass),'PBKDF2',false,['deriveKey']);return subtle.deriveKey({name:'PBKDF2',hash:'SHA-256',salt,iterations:210000},source,{name:'AES-GCM',length:256},false,['encrypt','decrypt'])}
function ledgerS7Collect(){const entries={};let size=0;for(const k of ledgerS7Keys){const v=localStorage.getItem(k);if(v===null)continue;const n=new TextEncoder().encode(v).length;if(n>ledgerS7Limits.entry)throw Error('One data entry is too large to transfer');size+=n;if(size>ledgerS7Limits.total)throw Error('Transfer data is too large');entries[k]=v}if(!Object.keys(entries).length)throw Error('No CV or career data found in this browser');return entries}
async function ledgerS7Export(pass){const entries=ledgerS7Collect(),subtle=ledgerS7Crypto(),salt=crypto.getRandomValues(new Uint8Array(16)),iv=crypto.getRandomValues(new Uint8Array(12));const key=await ledgerS7Key(pass,salt);const payload=JSON.stringify({format:'ledger-stage7-data',version:1,createdAt:new Date().toISOString(),entries});const encoded=new TextEncoder().encode(payload);const encrypted=await subtle.encrypt({name:'AES-GCM',iv},key,encoded);return JSON.stringify({format:ledgerS7Format,version:1,kdf:'PBKDF2-SHA256',iterations:210000,cipher:'AES-256-GCM',salt:ledgerS7Encode(salt),iv:ledgerS7Encode(iv),ciphertext:ledgerS7Encode(new Uint8Array(encrypted))},null,2)}
async function ledgerS7Decrypt(raw,pass){if(typeof raw!=='string'||raw.length>ledgerS7Limits.file)throw Error('Invalid transfer file size');let pack;try{pack=JSON.parse(raw)}catch{throw Error('Not a valid JSON transfer file')}if(!pack||pack.format!==ledgerS7Format||pack.version!==1||pack.kdf!=='PBKDF2-SHA256'||pack.iterations!==210000||pack.cipher!=='AES-256-GCM')throw Error('Unsupported transfer format');const salt=ledgerS7Decode(pack.salt),iv=ledgerS7Decode(pack.iv),ciphertext=ledgerS7Decode(pack.ciphertext);if(salt.length!==16||iv.length!==12||ciphertext.length<16||ciphertext.length>ledgerS7Limits.total+1024*1024)throw Error('Invalid transfer envelope');const key=await ledgerS7Key(pass,salt);let plaintext;try{plaintext=await ledgerS7Crypto().decrypt({name:'AES-GCM',iv},key,ciphertext)}catch{throw Error('Incorrect passphrase or damaged encrypted file')}let data;try{data=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(plaintext))}catch{throw Error('Damaged transfer contents')}if(!data||data.format!=='ledger-stage7-data'||data.version!==1||!data.entries||typeof data.entries!=='object'||Array.isArray(data.entries))throw Error('Unsupported transfer contents');let total=0;const names=Object.keys(data.entries);if(!names.length||names.some(k=>!ledgerS7Keys.includes(k)))throw Error('Transfer contains unknown keys');for(const k of names){const v=data.entries[k];if(typeof v!=='string')throw Error('Invalid transfer entry');const n=new TextEncoder().encode(v).length;if(n>ledgerS7Limits.entry)throw Error('Transfer entry too large');total+=n;if(total>ledgerS7Limits.total)throw Error('Transfer exceeds size limit');try{JSON.parse(v)}catch{throw Error('Transfer entry is not valid JSON')}}return data.entries}
function ledgerS7Download(filename,contents){const blob=new Blob([contents],{type:'application/json;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),30000)}
function ledgerS7Open(){if(document.getElementById('ledgerS7Dialog'))return;const previous=document.activeElement;const overlay=document.createElement('div');overlay.id='ledgerS7Dialog';overlay.className='ledger-s7-overlay';overlay.innerHTML=`<section class="ledger-s7-panel" role="dialog" aria-modal="true" aria-labelledby="ledgerS7Title"><button id="ledgerS7Close" type="button" class="btn btn-secondary">Close</button><h2 id="ledgerS7Title">Encrypted data transfer</h2><p>Stage 7 optional portability foundation. There is no cloud account, automatic sync or network upload. You manually move an encrypted file between devices. Keep your passphrase somewhere safe; it cannot be recovered.</p><label>Transfer passphrase (12+ characters)<input id="ledgerS7Pass" type="password" minlength="12" maxlength="256" autocomplete="new-password" /></label><div class="ledger-s7-actions"><button id="ledgerS7Export" class="btn btn-primary" type="button">Export encrypted file</button></div><hr><label>Choose encrypted transfer file<input id="ledgerS7File" type="file" accept=".json,application/json" /></label><button id="ledgerS7Inspect" type="button" class="btn btn-secondary">Inspect encrypted file</button><div id="ledgerS7Preview"></div><p id="ledgerS7Status" role="status" aria-live="polite"></p></section>`;document.body.appendChild(overlay);const q=id=>overlay.querySelector('#'+id),say=t=>q('ledgerS7Status').textContent=t;let staged=null,stagedRaw=null;const clear=()=>{staged=null;stagedRaw=null;q('ledgerS7Preview').replaceChildren()};const close=()=>{clear();overlay.remove();if(previous?.isConnected)previous.focus()};q('ledgerS7Close').onclick=close;overlay.addEventListener('keydown',e=>{if(e.key==='Escape'){close();return}if(e.key==='Tab'){const els=[...overlay.querySelectorAll('button:not(:disabled),input:not(:disabled)')].filter(x=>x.offsetParent!==null);if(e.shiftKey&&document.activeElement===els[0]){e.preventDefault();els.at(-1).focus()}else if(!e.shiftKey&&document.activeElement===els.at(-1)){e.preventDefault();els[0].focus()}}});q('ledgerS7File').onchange=clear;q('ledgerS7Pass').oninput=clear;
q('ledgerS7Export').onclick=async()=>{say('');try{q('ledgerS7Export').disabled=true;const contents=await ledgerS7Export(q('ledgerS7Pass').value);ledgerS7Download('ledger-encrypted-transfer.json',contents);say('Encrypted file prepared. Keep both the file and passphrase secure.')}catch(e){say('Export failed: '+e.message)}finally{q('ledgerS7Export').disabled=false}};
q('ledgerS7Inspect').onclick=async()=>{clear();say('');try{const file=q('ledgerS7File').files?.[0];if(!file)throw Error('Choose a file');if(file.size>ledgerS7Limits.file)throw Error('File too large');const contents=await file.text();const entries=await ledgerS7Decrypt(contents,q('ledgerS7Pass').value);staged=entries;stagedRaw=contents;const current=Object.fromEntries(Object.keys(entries).map(k=>[k,localStorage.getItem(k)]));const names=Object.keys(entries);const summary=document.createElement('p');summary.textContent='Validated entries: '+names.map(k=>k.replace('ledger_cv_','')).join(', ')+'. Import will replace the listed local entries. It does not merge records.';q('ledgerS7Preview').appendChild(summary);const consent=document.createElement('label');const cb=document.createElement('input');cb.type='checkbox';consent.append(cb,document.createTextNode(' I understand this overwrites matching local data and have saved an independent backup.'));q('ledgerS7Preview').appendChild(consent);const btn=document.createElement('button');btn.className='btn btn-primary';btn.type='button';btn.textContent='Replace selected local data';btn.disabled=true;cb.onchange=()=>btn.disabled=!cb.checked;q('ledgerS7Preview').appendChild(btn);btn.onclick=()=>{try{if(staged!==entries||stagedRaw!==contents)throw Error('Preview changed; inspect again');for(const k of names){if(localStorage.getItem(k)!==current[k])throw Error('Local data changed since preview; reopen the import')}const old=Object.fromEntries(names.map(k=>[k,localStorage.getItem(k)]));const written=[];try{for(const k of names){localStorage.setItem(k,entries[k]);if(localStorage.getItem(k)!==entries[k])throw Error('Storage verification failed');written.push(k)}}catch(err){for(const k of written.reverse()){try{if(old[k]===null)localStorage.removeItem(k);else localStorage.setItem(k,old[k])}catch{}}throw Error('Import failed; attempted to restore previous data. Verify and restore your independent backup: '+err.message)}say('Imported locally. Reload the application to load the transferred CV state.');clear()}catch(e){say('Import not completed: '+e.message)}};say('Encrypted file validated. Review before replacing local data.')}catch(e){say('Inspection failed: '+e.message)}};q('ledgerS7Close').focus()}
function ledgerS7Mount(){if(document.getElementById('ledgerS7Launcher'))return;const button=document.createElement('button');button.id='ledgerS7Launcher';button.className='btn btn-secondary ledger-s7-launcher';button.type='button';button.textContent='Encrypted transfer';button.onclick=ledgerS7Open;document.body.appendChild(button)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ledgerS7Mount,{once:true});else ledgerS7Mount();


/* Stage 8: free-product finishing workspace. No payments, services, or outbound requests. */
const ledgerS8Checklist=[
 ['create','Create a CV and complete contact details'],
 ['experience','Review employment dates and evidence'],
 ['education','Review education and qualifications'],
 ['tailor','Tailor a CV copy to a specific job'],
 ['proofread','Proofread all exported document content'],
 ['backup','Save a CV project backup and a tracker backup if used'],
 ['restore','Practice restoring backups on a test browser/profile'],
 ['exports','Inspect DOCX, HTML, TXT and printed PDF outputs'],
 ['browser','Verify saving and reopening in your browser'],
 ['mobile','Verify editor and export controls on your phone']
];
function ledgerS8StorageFacts(){
 const facts={available:false,cv:false,recovery:false,applications:false,approxBytes:0};
 try{facts.available=!!localStorage;for(const [label,key] of [['cv','ledger_cv_state_v2'],['recovery','ledger_cv_recovery_v24'],['applications','ledger_cv_stage6_applications_v1']]){const v=localStorage.getItem(key);facts[label]=v!==null;if(v!==null)facts.approxBytes+=new TextEncoder().encode(v).length}return facts}catch{return facts}
}
function ledgerS8Readiness(facts){const checks=[
 {ok:facts.available,text:'Browser storage is accessible in this session'},
 {ok:facts.cv,text:'Saved CV data detected in the current browser profile'},
 {ok:facts.recovery,text:'Recovery snapshot detected (not proof of recoverability)'},
 {ok:true,text:'Free product: no subscriptions, checkout or payment activation'},
 {ok:true,text:'Cloud transfer remains manual and opt-in; no background sync'}
];return checks}
function ledgerS8TextReport(){const f=ledgerS8StorageFacts();return [
 'LEDGER CV STUDIO — FREE PRODUCT READINESS GUIDE',
 'Generated: '+new Date().toISOString(),
 'This is an advisory local report, NOT an acceptance certificate.',
 ...ledgerS8Readiness(f).map(x=>(x.ok?'[observed/configured] ':'[attention] ')+x.text),
 'Stored CV bytes (approximate; does not include every browser key): '+f.approxBytes,
 'Career tracker data present: '+(f.applications?'yes':'no'),
 '', 'Manual checks to complete before public release:',
 ...ledgerS8Checklist.map(x=>'[ ] '+x[1]),
 '', 'Release status: NO-GO pending independent real-browser, document-output, recovery, accessibility, privacy, mobile and owner acceptance.',
 'No personal CV text or employment information is included in this report.'
 ].join('\n')+'\n'}
function ledgerS8Guide(){
 if(document.getElementById('ledgerS8Dialog'))return;
 const previous=document.activeElement;
 const overlay=document.createElement('div');overlay.id='ledgerS8Dialog';overlay.className='ledger-s8-overlay';
 overlay.innerHTML=`<section class="ledger-s8-panel" role="dialog" aria-modal="true" aria-labelledby="ledgerS8Title">
 <header class="ledger-s8-header"><div><p class="ledger-s8-eyebrow">LEDGER CV STUDIO · FREE EDITION</p><h2 id="ledgerS8Title">Finish your CV with confidence</h2><p>Offline-first, private career tools. No account, checkout, or subscription.</p></div><button type="button" id="ledgerS8Close" class="btn btn-secondary" aria-label="Close finish guide">Close</button></header>
 <div class="ledger-s8-grid"><section><h3>1. Create and review</h3><p>Complete your CV sections, make a copy for each job and check every claim against your own experience.</p><h3>2. Export and inspect</h3><p>Use the existing document and ATS tools. Inspect the output before sharing; keyword matching is not an ATS certification.</p><h3>3. Protect your work</h3><p>Browser storage can be cleared by your device or browser. Keep an independent CV project backup. The career tracker has its <strong>own</strong> JSON backup. For eligible browsers, encrypted transfer can include the supported CV and tracker storage keys.</p><p>Encrypted transfer is manual, does not merge records and may not be available when Web Crypto is blocked in a local-file context.</p></section>
 <section><h3>Local readiness snapshot</h3><ul id="ledgerS8Facts"></ul><p class="ledger-s8-note">A detected key is not proof its contents can be restored. This panel does not validate the release.</p><h3>Before sharing a CV</h3><div id="ledgerS8Checklist"></div></section></div>
 <footer class="ledger-s8-footer"><button type="button" id="ledgerS8Refresh" class="btn btn-secondary">Refresh local snapshot</button><button type="button" id="ledgerS8Download" class="btn btn-primary">Download readiness guide</button><p id="ledgerS8Status" role="status" aria-live="polite"></p><p>Development build · Free now · Public release requires acceptance testing.</p></footer></section>`;
 document.body.appendChild(overlay);
 const q=id=>overlay.querySelector('#'+id), say=t=>q('ledgerS8Status').textContent=t;
 const refresh=()=>{const facts=ledgerS8StorageFacts();q('ledgerS8Facts').replaceChildren();for(const item of ledgerS8Readiness(facts)){const li=document.createElement('li');li.textContent=(item.ok?'✓ ':'• ')+item.text;q('ledgerS8Facts').append(li)}};
 for(const [id,label] of ledgerS8Checklist){const l=document.createElement('label');l.className='ledger-s8-check';const input=document.createElement('input');input.type='checkbox';input.setAttribute('aria-label',label);l.append(input,document.createTextNode(' '+label));q('ledgerS8Checklist').append(l)}
 q('ledgerS8Refresh').onclick=()=>{refresh();say('Snapshot refreshed. Checkboxes are personal reminders, not verification evidence.')};
 q('ledgerS8Download').onclick=()=>{try{const contents=ledgerS8TextReport();const blob=new Blob([contents],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='ledger-free-readiness-guide.txt';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),30000);say('Readiness guide prepared; no CV content was included.')}catch(e){say('Report unavailable: '+e.message)}};
 const close=()=>{overlay.remove();if(previous?.isConnected)previous.focus()};q('ledgerS8Close').onclick=close;
 overlay.addEventListener('keydown',e=>{if(e.key==='Escape'){e.preventDefault();close()}else if(e.key==='Tab'){const els=[...overlay.querySelectorAll('button:not(:disabled),input:not(:disabled)')].filter(x=>x.getClientRects().length);if(!els.length)return;const first=els[0],last=els.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}});
 refresh();q('ledgerS8Close').focus();
}
function ledgerS8Mount(){if(document.getElementById('ledgerS8Launcher'))return;const b=document.createElement('button');b.id='ledgerS8Launcher';b.className='btn btn-primary ledger-s8-launcher';b.type='button';b.textContent='Finish guide · Free';b.setAttribute('aria-label','Open the free CV finishing guide');b.onclick=ledgerS8Guide;document.body.appendChild(b)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ledgerS8Mount,{once:true});else ledgerS8Mount();

</script>
</body>
</html>