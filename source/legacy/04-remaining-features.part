const UNIVERSAL_RESPONSIBILITY_EXTRAS = [
  'Maintained accurate records and communicated important updates clearly to colleagues, supervisors, or customers.',
  'Prioritised competing tasks effectively while meeting agreed deadlines and maintaining consistent quality standards.',
  'Worked cooperatively with others, contributing to a respectful, dependable, and productive team environment.',
  'Followed workplace policies, safety requirements, and quality procedures while identifying opportunities to improve daily work.'
];
const SUGGESTED_BULLETS = Object.fromEntries(JOB_TITLES.map(title => { const group=Object.keys(JOB_TITLE_GROUPS).find(group => JOB_TITLE_GROUPS[group].includes(title)); return [normaliseJobTitle(title), ROLE_PROFILES[group].bullets.concat(ROLE_SUGGESTION_EXTRAS[group].bullets, UNIVERSAL_RESPONSIBILITY_EXTRAS)]; }));
const SUGGESTED_SKILLS = Object.fromEntries(JOB_TITLES.map(title => { const group=Object.keys(JOB_TITLE_GROUPS).find(group => JOB_TITLE_GROUPS[group].includes(title)); return [normaliseJobTitle(title), ROLE_PROFILES[group].skills.concat(ROLE_SUGGESTION_EXTRAS[group].skills)]; }));
const SUMMARY_SUGGESTIONS = Object.fromEntries(JOB_TITLES.map(title => [normaliseJobTitle(title), ROLE_PROFILES[Object.keys(JOB_TITLE_GROUPS).find(group => JOB_TITLE_GROUPS[group].includes(title))].summaries]));
const SUMMARY_SNIPPETS = ROLE_PROFILES.office.summaries;

const JOB_TITLE_ALIASES = {
  admin:'administrative assistant', administrator:'office administrator', receptionist:'receptionist',
  cleaner:'cleaner', clean:'cleaner', cleaning:'cleaner', security:'security guard', guard:'security guard',
  cashier:'cashier', till:'cashier', sales:'sales assistant', retail:'retail supervisor', shop:'shop assistant',
  waiter:'waiter / waitress', waitress:'waiter / waitress', server:'waiter / waitress', chef:'chef', cook:'cook', kitchen:'kitchen assistant',
  warehouse:'warehouse worker', warehousing:'warehouse worker', picker:'picker packer', packer:'picker packer', forklift:'forklift operator',
  factory:'factory worker', manufacturing:'production operative', production:'production operative', assembly:'assembly operative', operator:'machine operator',
  labourer:'general labourer', laborer:'general labourer', construction:'construction worker', builder:'construction worker', electrician:'electrician', plumber:'plumber', mechanic:'mechanic', driver:'delivery driver', delivery:'delivery driver', courier:'courier',
  nurse:'registered nurse', nursing:'nursing assistant', care:'caregiver', carer:'caregiver', healthcare:'healthcare assistant', teacher:'teacher', teaching:'teaching assistant', tutor:'tutor',
  accountant:'accountant', acct:'accountant', accounts:'accounts assistant', finance:'finance assistant', payroll:'payroll administrator',
  developer:'software developer', programmer:'software developer', software:'software developer', coding:'software developer', web:'web developer', it:'it support technician', tech:'it support technician', data:'data analyst', analyst:'business analyst', designer:'graphic designer', design:'graphic designer', marketing:'marketing assistant',
  supervisor:'retail supervisor', manager:'store manager', assistant:'administrative assistant', customer:'customer service representative', service:'customer service representative'
};

function normaliseJobTitle(value){
  return String(value||'').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/&/g,' and ').replace(/[’']/g,'').replace(/[^a-z0-9]+/g,' ').trim();
}
function titleTokens(value){ return normaliseJobTitle(value).split(/\s+/).filter(Boolean); }

const cvEngine = {
  searchJobTitles(query){
    const raw = normaliseJobTitle(query);
    if(!raw) return [];
    const corrected = raw.split(' ').map(word => JOB_TITLE_ALIASES[word] ? normaliseJobTitle(JOB_TITLE_ALIASES[word]) : word).join(' ');
    const qTokens = titleTokens(corrected);
    const scored = JOB_TITLES.map((title,index)=>{
      const titleNorm = normaliseJobTitle(title), tokens = titleTokens(title);
      let score = 0;
      if(titleNorm===corrected) score += 1000;
      if(titleNorm.startsWith(corrected)) score += 500;
      if(tokens.some(token=>token.startsWith(qTokens[0]))) score += 180;
      if(qTokens.every(q=>tokens.some(token=>token.startsWith(q)))) score += 140;
      if(qTokens.every(q=>titleNorm.includes(q))) score += 90;
      if(titleNorm.includes(corrected)) score += 60;
      if(raw!==corrected && titleNorm.includes(raw)) score += 220;
      return {title,score,index};
    }).filter(item=>item.score>0).sort((a,b)=>b.score-a.score || a.index-b.index);
    return scored.slice(0,6).map(item=>item.title);
  },
  getResponsibilities(title){
    const key = normaliseJobTitle(title);
    return SUGGESTED_BULLETS[key] || ROLE_PROFILES.office.bullets;
  },
  getSuggestedSkills(title){
    const key = normaliseJobTitle(title);
    return SUGGESTED_SKILLS[key] || ROLE_PROFILES.office.skills;
  },
  getSummarySuggestions(title){
    const key = normaliseJobTitle(title);
    return SUMMARY_SUGGESTIONS[key] || ROLE_PROFILES.office.summaries;
  },
  getAchievementPrompts(title){
    const text = normaliseJobTitle(title)+' '+(JOB_TITLE_ALIASES[normaliseJobTitle(title)]||'');
    if(/warehouse|picker|forklift|loader|sorter|stock|logistics|dispatch/.test(text)) return ['Improved order-picking accuracy by {number}% by using a clearer location or scanning routine.','Processed {number}+ orders per shift while maintaining {result}% accuracy.','Reduced loading, put-away, or dispatch delays by {number}% through better staging and handovers.','Completed {number} consecutive shifts with no avoidable stock, safety, or picking errors.'];
    if(/factory|production|assembly|machine|operator|packer|manufacturing|quality/.test(text)) return ['Exceeded the production target by {number}% while maintaining agreed quality standards.','Reduced waste, rework, or stoppages by {number}% by improving a daily process.','Completed {number} production runs, changeovers, or quality checks with accurate records.','Helped the team improve first-time quality from {number}% to {result}%.'];
    if(/clean|housekeep|janitor|laundry/.test(text)) return ['Maintained {number}+ rooms, areas, or sites to inspection standard each shift.','Improved inspection or customer scores from {number}% to {result}% through consistent checks.','Completed scheduled cleaning {number}% faster while maintaining hygiene and safety standards.','Reduced product waste or replenishment issues by {number}% through better stock control.'];
    if(/security|guard|cctv|patrol/.test(text)) return ['Completed {number}+ patrols or access checks per shift with accurate logs and handovers.','Reduced repeat incidents by {number}% through consistent reporting and escalation.','Responded to {number}+ incidents, alarms, or challenging situations calmly and according to procedure.','Maintained {number} consecutive shifts with complete, accurate security records.'];
    if(/construction|labour|brick|carpenter|roofer|plaster|groundworker|site|scaffold|tiler/.test(text)) return ['Completed {number}+ site tasks or work packages safely and to programme.','Reduced material waste or avoidable rework by {number}% through careful preparation and checks.','Maintained a strong safety record across {number} months or projects with no reportable incidents.','Supported delivery of {number} units, rooms, properties, or work areas to the required quality standard.'];
    if(/driver|courier|delivery|hgv|bus|taxi|van/.test(text)) return ['Completed {number}+ deliveries or stops per route while maintaining {result}% on-time performance.','Reduced failed deliveries, complaints, or route delays by {number}% through better planning.','Maintained a clean safety record across {number} miles or months of professional driving.','Handled {number}+ customer deliveries per week with accurate proof-of-delivery records.'];
    if(/retail|cashier|sales|shop|store|merchand/.test(text)) return ['Improved sales, average basket value, or service results by {number}% through focused customer support.','Served {number}+ customers per shift while maintaining accurate till and cash-handling standards.','Reduced stock loss, discrepancies, or out-of-stocks by {number}% through regular checks.','Achieved a customer, mystery-shopper, or service score of {number}% or above.'];
    if(/care|nurse|support|health/.test(text)) return ['Supported {number}+ people each week while maintaining respectful, person-centred care.','Improved record, handover, or appointment accuracy to {number}% through a consistent routine.','Completed {number} months of reliable attendance while following safeguarding and care procedures.','Received positive feedback from {number}+ people, families, colleagues, or supervisors.'];
    return ['Improved a routine, process, or service result by {number}% through a practical change.','Handled {number}+ tasks, customers, records, or requests per shift while maintaining accuracy.','Completed {number} months or projects to the required quality, safety, and deadline standards.','Received positive feedback, recognition, or repeat work from {number}+ customers, colleagues, or supervisors.'];
  },
  getMetricPrompts(title){
    const text = normaliseJobTitle(title)+' '+(JOB_TITLE_ALIASES[normaliseJobTitle(title)]||'');
    if(/warehouse|factory|production|construction|clean|security|driver|retail|cashier|shop|store|labour|operative/.test(text)) return ['People or customers supported per shift/week: ___','Typical volume completed per shift/week: ___','Accuracy, quality, on-time, or inspection score: ___%','Time, cost, waste, complaints, or incidents reduced: ___%'];
    if(/office|admin|finance|account|reception/.test(text)) return ['Records, invoices, calls, or requests processed per week: ___','Accuracy, completion, or response-time result: ___%','Hours, errors, overdue items, or costs reduced: ___','Teams, managers, or customers supported: ___'];
    if(/care|nurse|teacher|education|support/.test(text)) return ['People, learners, or cases supported: ___','Attendance, progress, compliance, or satisfaction result: ___%','Care plans, lessons, assessments, or records completed: ___','Positive feedback, outcomes, or recognition received: ___'];
    return ['Projects, tasks, or customers handled: ___','Quality, delivery, satisfaction, or completion result: ___%','Time, cost, errors, or rework reduced: ___%','Team size, sites, shifts, or stakeholders supported: ___'];
  },
  getContentGuidance(title){
    const key = normaliseJobTitle(title);
    const text = key+' '+(JOB_TITLE_ALIASES[key]||'');
    if(/clean|housekeep|janitor/.test(text)) return 'Mention areas covered, cleaning standards, products or COSHH, safety checks, and reliability.';
    if(/security|guard|cctv/.test(text)) return 'Mention site type, patrols or monitoring, incident handling, access control, and licences or first aid.';
    if(/warehouse|picker|forklift|loader|sorter|stock/.test(text)) return 'Mention systems or equipment used, order accuracy, throughput, stock control, and safe manual handling.';
    if(/factory|production|machine|assembly|operator|packer/.test(text)) return 'Mention equipment, output, quality checks, standard procedures, safety, and downtime or waste improvements.';
    if(/labour|construction|brick|carpenter|roofer|plaster|groundworker|site/.test(text)) return 'Mention materials, tools, site safety, drawings or instructions, quality, and work completed to programme.';
    if(/driver|courier|delivery|hgv|bus|taxi/.test(text)) return 'Mention vehicle class, route volume, safety checks, delivery accuracy, customer contact, and time-critical performance.';
    if(/care|nurse|support|health/.test(text)) return 'Mention the people supported, safeguarding, records, care procedures, teamwork, and changes you handled responsibly.';
    if(/cashier|retail|sales|shop|store/.test(text)) return 'Mention customer volume, till or stock systems, sales or service results, accuracy, and team contribution.';
    return 'Turn duties into evidence by naming the task, the standard or tool used, and the result you achieved.';
  }
};

